+    vec2 f = fract(p);
+    vec2 u = f * f * (3.0 - 2.0 * f);
+    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
+}
+
+float caustics(vec2 p, float t) {
+    float c = 0.0;
+    c += abs(sin(p.x * 7.0 + sin(p.y * 5.0 + t * 1.3) * 1.5 + t));
+    c += abs(sin(p.y * 6.0 + sin(p.x * 4.0 - t * 1.1) * 1.5 - t * 0.8));
+    return pow(1.0 - clamp(c * 0.5, 0.0, 1.0), 6.0);
+}
