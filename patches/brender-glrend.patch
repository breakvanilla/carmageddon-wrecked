+/*
+ * Wrecked Carmageddon: smoothing and crease data for curved surfaces. Vertex copies at the same position are clustered
+ * by normal (within about 50 degrees): one cluster is smooth, two a crease, three or more a corner.
+ */
+typedef struct crease_key {
+    br_vector3_f p;
+    br_uint_32 index;
+} crease_key;
+
+static int compare_crease_keys(const void* pA, const void* pB) {
+    const crease_key* a = pA;
+    const crease_key* b = pB;
+    int i;
+
+    for (i = 0; i < 3; i++) {
+        if (a->p.v[i] != b->p.v[i]) {
+            return a->p.v[i] < b->p.v[i] ? -1 : 1;
+        }
+    }
+    return 0;
+}
+
+// Ties keep the original order, so the clustering is deterministic
+static int compare_crease_keys_stable(const void* pA, const void* pB) {
+    int c = compare_crease_keys(pA, pB);
+
+    if (c != 0) {
+        return c;
+    }
+    return ((const crease_key*)pA)->index < ((const crease_key*)pB)->index ? -1 : 1;
+}
+
+static void build_crease_data(const struct v11model* model, gl_vertex_f* vtx, size_t total_vertices) {
