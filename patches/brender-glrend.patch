diff --git a/drivers/glrend/water.c b/drivers/glrend/water.c
new file mode 100644
index 0000000..c030e7f
--- /dev/null
+++ b/drivers/glrend/water.c
@@ -0,0 +1,383 @@
+/*
+ * Water. Draws of water materials are put aside and drawn last, with the finished scene copied into textures so the
+ * water can show it through and reflect it. The underwater view works the same way.
+ */
+#include "drv.h"
+#include "brassert.h"
+#include "underwater.frag.glsl.h"
+#include "water.frag.glsl.h"
+#include "water.vert.glsl.h"
+#include <math.h>
+#include <string.h>
+
+#define MAX_WATER_MATERIALS 32
+#define MAX_WATER_DRAWS 512
+#define MAX_RIPPLES 32
+
+extern GLint gGLREND_scene_viewport[4];
+
+typedef struct tWater_draw {
+    GLuint vao;
+    GLsizei count;
+    const void* offset;
+    GLuint texture;
+    br_matrix4 model_view;
+    br_matrix4 projection;
+    br_matrix4 map_transform;
+    int fog_enabled;
+    br_vector3 fog_colour;
+    float fog_max;
+} tWater_draw;
+
+static struct {
+    void* materials[MAX_WATER_MATERIALS]; /* stored states, as the draws see them */
+    int material_count;
+    tWater_draw draws[MAX_WATER_DRAWS];
+    int draw_count;
+    int failed;
+    GLuint program;
+    GLuint under_program;
+    GLuint empty_vao;
+    GLuint fbo;
+    GLuint colour_tex;
+    GLuint depth_tex;
+    int width;
+    int height;
+    int have_scene;
+    float time;
+    br_vector3 sun;          /* towards the sun, world */
+    float ripples[MAX_RIPPLES][4];
+    int ripple_count;
+    int camera_under;
+    float surface;
+    br_vector3 tint;
+    br_matrix34 camera_to_world;
+    br_device_pixelmap* screen;
+    GLuint sky_tex;
+    float sky_width, sky_height, sky_underground;
+    float hither, yon;
+    br_matrix4 projection; /* of the last draw */
+    int enabled;           /* between GLREND_SetWaterScene() and GLREND_DrawWater() */
+} gWater;
+
+void BR_PUBLIC_ENTRY GLREND_SetWaterMaterial(struct br_material* pMaterial) {
+    int i;
+
+    if (pMaterial == NULL || pMaterial->stored == NULL) {
+        return;
+    }
+    for (i = 0; i < gWater.material_count; i++) {
+        if (gWater.materials[i] == pMaterial->stored) {
+            return;
+        }
+    }
+    if (gWater.material_count < MAX_WATER_MATERIALS) {
+        gWater.materials[gWater.material_count++] = pMaterial->stored;
+    }
+}
+
+void BR_PUBLIC_ENTRY GLREND_ClearWaterMaterials(void) {
+    gWater.material_count = 0;
+    gWater.draw_count = 0;
+}
+
+void BR_PUBLIC_ENTRY GLREND_SetWaterScene(float pTime, const br_vector3* pTo_sun, const float* pRipples, int pRipple_count, int pCamera_under, float pSurface, const br_vector3* pTint) {
+    gWater.time = pTime;
+    gWater.sun = *pTo_sun;
+    pRipple_count = pRipple_count > MAX_RIPPLES ? MAX_RIPPLES : pRipple_count;
+    memcpy(gWater.ripples, pRipples, sizeof(float) * 4 * pRipple_count);
+    gWater.ripple_count = pRipple_count;
+    gWater.camera_under = pCamera_under;
+    gWater.surface = pSurface;
+    gWater.tint = *pTint;
+    gWater.enabled = 1;
+}
+
+/* Called for every draw; returns 1 if it put the draw aside as water */
+int GLRENDI_WaterIntercept(br_geometry_stored* self, br_renderer* renderer, const gl_groupinfo* groupinfo, const shader_data_model* model, GLuint texture,
+    const br_matrix34* camera_to_world, GLuint sky_tex, const state_stack* state) {
+    tWater_draw* d;
+    int i;
+
+    gWater.screen = renderer->pixelmap->screen;
+    gWater.camera_to_world = *camera_to_world;
+    gWater.projection = model->projection;
+    gWater.hither = state->matrix.hither_z;
+    gWater.yon = state->matrix.yon_z;
+    if (!gWater.enabled || gWater.material_count == 0 || groupinfo->stored == NULL || gWater.failed) {
+        return 0;
+    }
+    for (i = 0; i < gWater.material_count; i++) {
+        if (gWater.materials[i] == groupinfo->stored) {
+            break;
+        }
+    }
+    if (i == gWater.material_count || gWater.draw_count >= MAX_WATER_DRAWS) {
+        return 0;
+    }
+    d = &gWater.draws[gWater.draw_count++];
+    d->vao = self->gl_vao;
+    d->count = groupinfo->count;
+    d->offset = groupinfo->offset;
+    d->texture = texture;
+    d->model_view = model->model_view;
+    d->projection = model->projection;
+    d->map_transform = model->map_transform;
+    d->fog_enabled = model->fog_enabled;
+    d->fog_colour = model->fog_colour;
+    d->fog_max = model->fog_max;
+    gWater.sky_tex = sky_tex;
+    gWater.sky_width = model->sky_width;
+    gWater.sky_height = model->sky_height;
+    gWater.sky_underground = model->sky_underground;
+    return 1;
+}
+
+static GLuint Compile(GLenum type, const char* name, const char* src, GLint length) {
+    GLuint shader;
+    GLint status;
+    char log[1024];
+
+    shader = glCreateShader(type);
+    glShaderSource(shader, 1, &src, &length);
+    glCompileShader(shader);
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &status);
+    if (status != GL_TRUE) {
+        glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+        BrLogPrintf("GLREND: no water effects, %s failed to compile:\n%s\n", name, log);
+        glDeleteShader(shader);
+        return 0;
+    }
+    return shader;
+}
+
+static GLuint Link(GLuint vs, GLuint fs, HVIDEO hVideo) {
+    GLuint program;
+    GLint status;
+    char log[1024];
+
+    program = glCreateProgram();
+    glAttachShader(program, vs);
+    glAttachShader(program, fs);
+    if (hVideo != NULL) {
+        /* Same attribute slots as brenderProgram: same vertex arrays */
+        glBindAttribLocation(program, hVideo->brenderProgram.attributes.aPosition, "aPosition");
+        if (hVideo->brenderProgram.attributes.aUV >= 0) {
+            glBindAttribLocation(program, hVideo->brenderProgram.attributes.aUV, "aUV");
+        }
+    }
+    glLinkProgram(program);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    glGetProgramiv(program, GL_LINK_STATUS, &status);
+    if (status != GL_TRUE) {
+        glGetProgramInfoLog(program, sizeof(log), NULL, log);
+        BrLogPrintf("GLREND: no water effects, link failed:\n%s\n", log);
+        glDeleteProgram(program);
+        return 0;
+    }
+    return program;
+}
+
+static const char gFullscreen_vertex[] = "#version 410 core\n"
+                                         "void main() {\n"
+                                         "    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);\n"
+                                         "    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+                                         "}\n";
+
+static int Init(HVIDEO hVideo) {
+    GLuint vs, fs;
+
+    if (gWater.program != 0) {
+        return 1;
+    }
+    if (gWater.failed || GLVersion.major < 4) {
+        gWater.failed = 1;
+        return 0;
+    }
+    vs = Compile(GL_VERTEX_SHADER, "water.vert", WATER_VERT_GLSL, sizeof(WATER_VERT_GLSL) - 1);
+    fs = Compile(GL_FRAGMENT_SHADER, "water.frag", WATER_FRAG_GLSL, sizeof(WATER_FRAG_GLSL) - 1);
+    gWater.program = vs && fs ? Link(vs, fs, hVideo) : 0;
+    vs = Compile(GL_VERTEX_SHADER, "fullscreen.vert", gFullscreen_vertex, sizeof(gFullscreen_vertex) - 1);
+    fs = Compile(GL_FRAGMENT_SHADER, "underwater.frag", UNDERWATER_FRAG_GLSL, sizeof(UNDERWATER_FRAG_GLSL) - 1);
+    gWater.under_program = vs && fs ? Link(vs, fs, NULL) : 0;
+    if (gWater.program == 0 || gWater.under_program == 0) {
+        gWater.failed = 1;
+        return 0;
+    }
+    glGenVertexArrays(1, &gWater.empty_vao);
+    glGenFramebuffers(1, &gWater.fbo);
+    glGenTextures(1, &gWater.colour_tex);
+    glGenTextures(1, &gWater.depth_tex);
+    BrLogPrintf("GLREND: water effects on\n");
+    return 1;
+}
+
+/* Colour and depth drawn so far, into textures */
+static void CopyScene(void) {
+    int x, y, w, h;
+    float rx, ry;
+    GLenum status;
+
+    gWater.have_scene = 0;
+    if (gWater.screen == NULL) {
+        return;
+    }
+    DevicePixelmapGLGetViewport(gWater.screen, &x, &y, &rx, &ry);
+    w = (int)(2 * x + gWater.screen->pm_width * rx + 0.5f);
+    h = (int)(2 * y + gWater.screen->pm_height * ry + 0.5f);
+    if (w != gWater.width || h != gWater.height) {
+        gWater.width = w;
+        gWater.height = h;
+        glBindTexture(GL_TEXTURE_2D, gWater.colour_tex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindTexture(GL_TEXTURE_2D, gWater.depth_tex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT24, w, h, 0, GL_DEPTH_COMPONENT, GL_FLOAT, NULL);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindFramebuffer(GL_FRAMEBUFFER, gWater.fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, gWater.colour_tex, 0);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, gWater.depth_tex, 0);
+        status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        glBindTexture(GL_TEXTURE_2D, 0);
+        if (status != GL_FRAMEBUFFER_COMPLETE) {
+            BrLogPrintf("GLREND: water can't see the scene (framebuffer 0x%x)\n", status);
+            gWater.width = gWater.height = 0;
+            return;
+        }
+    }
+    /* Also resolves the multisampling */
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, gWater.fbo);
+    glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    gWater.have_scene = glGetError() == GL_NO_ERROR;
+}
+
+static void SetCommonUniforms(GLuint program, const br_matrix4* projection) {
+    br_matrix4 inverse, view_to_world;
+
+    BrMatrix4Inverse(&inverse, (br_matrix4*)projection);
+    BrMatrix4Copy34(&view_to_world, &gWater.camera_to_world);
+    glUniformMatrix4fv(glGetUniformLocation(program, "u_inv_projection"), 1, GL_FALSE, &inverse.m[0][0]);
+    glUniformMatrix4fv(glGetUniformLocation(program, "u_view_to_world"), 1, GL_FALSE, &view_to_world.m[0][0]);
+    glUniform4f(glGetUniformLocation(program, "u_viewport"), (float)gGLREND_scene_viewport[0], (float)gGLREND_scene_viewport[1],
+        (float)gGLREND_scene_viewport[2], (float)gGLREND_scene_viewport[3]);
+    glUniform2f(glGetUniformLocation(program, "u_drawable"), (float)(gWater.width > 0 ? gWater.width : 1), (float)(gWater.height > 0 ? gWater.height : 1));
+    glUniform1f(glGetUniformLocation(program, "u_time"), gWater.time);
+    glUniform1i(glGetUniformLocation(program, "scene_colour"), 3);
+    glUniform1i(glGetUniformLocation(program, "scene_depth"), 4);
+    glActiveTexture(GL_TEXTURE3);
+    glBindTexture(GL_TEXTURE_2D, gWater.colour_tex);
+    glActiveTexture(GL_TEXTURE4);
+    glBindTexture(GL_TEXTURE_2D, gWater.depth_tex);
+    glActiveTexture(GL_TEXTURE0);
+}
+
+void BR_PUBLIC_ENTRY GLREND_DrawWater(void) {
+    br_matrix34 world_to_view;
+    br_vector3 sun;
+    GLuint program;
+    tWater_draw* d;
+    HVIDEO hVideo;
+    int i;
+
+    gWater.enabled = 0;
+    if (gWater.draw_count == 0 || gWater.screen == NULL) {
+        gWater.draw_count = 0;
+        return;
+    }
+    hVideo = &gWater.screen->asFront.video;
+    if (!Init(hVideo)) {
+        gWater.draw_count = 0;
+        return;
+    }
+    CopyScene();
+    program = gWater.program;
+    glUseProgram(program);
+    glViewport(gGLREND_scene_viewport[0], gGLREND_scene_viewport[1], gGLREND_scene_viewport[2], gGLREND_scene_viewport[3]);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LEQUAL);
+    glDepthMask(GL_TRUE);
+    glDisable(GL_BLEND);
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_SAMPLE_ALPHA_TO_COVERAGE);
+    SetCommonUniforms(program, &gWater.draws[0].projection);
+    glUniform1i(glGetUniformLocation(program, "u_have_scene"), gWater.have_scene);
+    BrMatrix34Inverse(&world_to_view, &gWater.camera_to_world);
+    BrMatrix34ApplyV(&sun, &gWater.sun, &world_to_view);
+    BrVector3Normalise(&sun, &sun);
+    glUniform3f(glGetUniformLocation(program, "u_sun"), sun.v[0], sun.v[1], sun.v[2]);
+    glUniform4fv(glGetUniformLocation(program, "u_ripples"), gWater.ripple_count, &gWater.ripples[0][0]);
+    glUniform1i(glGetUniformLocation(program, "u_ripple_count"), gWater.ripple_count);
+    glUniform1i(glGetUniformLocation(program, "u_camera_under"), gWater.camera_under);
+    glUniform1i(glGetUniformLocation(program, "u_has_sky"), gWater.sky_tex != 0);
+    glUniform1f(glGetUniformLocation(program, "u_sky_width"), gWater.sky_width);
+    glUniform1f(glGetUniformLocation(program, "u_sky_height"), gWater.sky_height);
+    glUniform1f(glGetUniformLocation(program, "u_sky_underground"), gWater.sky_underground);
+    glUniform1f(glGetUniformLocation(program, "u_hither"), gWater.hither);
+    glUniform1f(glGetUniformLocation(program, "u_yon"), gWater.yon);
+    glUniform1i(glGetUniformLocation(program, "main_texture"), 0);
+    glUniform1i(glGetUniformLocation(program, "env_texture"), 1);
+    if (gWater.sky_tex != 0) {
+        glActiveTexture(GL_TEXTURE1);
+        glBindTexture(GL_TEXTURE_2D, gWater.sky_tex);
+        glActiveTexture(GL_TEXTURE0);
+    }
+    for (i = 0; i < gWater.draw_count; i++) {
+        d = &gWater.draws[i];
+        glUniformMatrix4fv(glGetUniformLocation(program, "u_model_view"), 1, GL_FALSE, &d->model_view.m[0][0]);
+        glUniformMatrix4fv(glGetUniformLocation(program, "u_projection"), 1, GL_FALSE, &d->projection.m[0][0]);
+        glUniformMatrix4fv(glGetUniformLocation(program, "u_map_transform"), 1, GL_FALSE, &d->map_transform.m[0][0]);
+        glUniform1i(glGetUniformLocation(program, "u_fog_enabled"), d->fog_enabled);
+        glUniform3f(glGetUniformLocation(program, "u_fog_colour"), d->fog_colour.v[0], d->fog_colour.v[1], d->fog_colour.v[2]);
+        glUniform1f(glGetUniformLocation(program, "u_fog_max"), d->fog_max);
+        glBindTexture(GL_TEXTURE_2D, d->texture);
+        glBindVertexArray(d->vao);
+        glDrawElements(GL_TRIANGLES, d->count, GL_UNSIGNED_SHORT, d->offset);
+    }
+    gWater.draw_count = 0;
+    glBindVertexArray(0);
+    glUseProgram(hVideo->brenderProgram.program);
+    GL_CHECK_ERROR();
+}
+
+void BR_PUBLIC_ENTRY GLREND_DrawUnderwater(void) {
+    HVIDEO hVideo;
+
+    if (!gWater.camera_under || gWater.screen == NULL) {
+        return;
+    }
+    hVideo = &gWater.screen->asFront.video;
+    if (!Init(hVideo)) {
+        return;
+    }
+    CopyScene();
+    if (!gWater.have_scene) {
+        return;
+    }
+    glUseProgram(gWater.under_program);
+    glViewport(gGLREND_scene_viewport[0], gGLREND_scene_viewport[1], gGLREND_scene_viewport[2], gGLREND_scene_viewport[3]);
+    glDisable(GL_DEPTH_TEST);
+    glDepthMask(GL_FALSE);
+    glDisable(GL_BLEND);
+    glDisable(GL_CULL_FACE);
+    SetCommonUniforms(gWater.under_program, &gWater.projection);
+    glUniform3f(glGetUniformLocation(gWater.under_program, "u_tint"), gWater.tint.v[0], gWater.tint.v[1], gWater.tint.v[2]);
+    glUniform1f(glGetUniformLocation(gWater.under_program, "u_surface"), gWater.surface);
+    glBindVertexArray(gWater.empty_vao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindVertexArray(0);
+    glDepthMask(GL_TRUE);
+    glEnable(GL_DEPTH_TEST);
+    glUseProgram(0);
+    GL_CHECK_ERROR();
+}
diff --git a/drivers/glrend/water.frag.glsl b/drivers/glrend/water.frag.glsl
new file mode 100644
index 0000000..6ae9727
--- /dev/null
+++ b/drivers/glrend/water.frag.glsl
@@ -0,0 +1,236 @@
+#version 410 core
+
+/*
+ * Water surfaces (water.c). Drawn after the rest of the scene, so the colour and depth behind the water are known.
+ */
+
+uniform sampler2D main_texture;
+uniform sampler2D env_texture;   /* the track's sky */
+uniform sampler2D scene_colour;
+uniform sampler2D scene_depth;
+
+uniform mat4 u_projection;
+uniform mat4 u_inv_projection;
+uniform mat4 u_view_to_world;
+uniform vec4 u_viewport;         /* scene viewport, pixels */
+uniform vec2 u_drawable;         /* window, pixels */
+uniform int u_have_scene;        /* scene_colour and scene_depth are valid */
+uniform float u_time;            /* seconds */
+uniform vec3 u_sun;              /* towards the sun, view space */
+uniform vec4 u_ripples[32];      /* world x, z, start time, strength */
+uniform int u_ripple_count;
+uniform int u_has_sky;
+uniform float u_sky_width;
+uniform float u_sky_height;
+uniform float u_sky_underground;
+uniform int u_fog_enabled;
+uniform vec3 u_fog_colour;
+uniform float u_fog_max;
+uniform float u_hither;
+uniform float u_yon;
+uniform int u_camera_under;
+
+in vec3 v_view;
+in vec3 v_world;
+in vec2 v_uv;
+
+out vec4 fragColour;
+
+#define FOGGING_EMULATE_3DFX_DENSITY_MULTIPLIER 80
+
+vec3 environmentColour(vec3 r) {
+    vec3 sky;
+    float elevation = asin(clamp(r.y, -1.0, 1.0));
+
+    if (u_has_sky != 0) {
+        float height = float(textureSize(env_texture, 0).y);
+        float u = atan(r.x, -r.z) / u_sky_width;
+        float v = 1.0 - (elevation + u_sky_underground) / u_sky_height;
+        sky = textureLod(env_texture, vec2(u, clamp(v, 0.5 / height, 1.0 - 0.5 / height)), 0.0).rgb;
+    } else {
+        sky = mix(vec3(0.55, 0.6, 0.65), vec3(0.3, 0.45, 0.7), clamp(r.y, 0.0, 1.0));
+    }
+    return sky;
+}
+
+float hash(vec2 p) {
+    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
+}
+
+float noise(vec2 p) {
+    vec2 i = floor(p);
+    vec2 f = fract(p);
+    vec2 u = f * f * (3.0 - 2.0 * f);
+    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
+}
+
+/* (d height / dx, d height / dz), world units */
+vec2 waveSlope(vec2 p, float t, out float crest) {
+    /* direction, wavelength (world units, 1 = 6.9 m), height, speed */
+    const vec4 waves[6] = vec4[6](
+        vec4(0.80, 0.60, 1.90, 0.010),
+        vec4(-0.45, 0.89, 1.10, 0.007),
+        vec4(0.95, -0.30, 0.62, 0.004),
+        vec4(-0.70, -0.71, 0.37, 0.0025),
+        vec4(0.20, 0.98, 0.21, 0.0015),
+        vec4(-0.98, 0.18, 0.13, 0.0009));
+    vec2 slope = vec2(0.0);
+    crest = 0.0;
+    for (int i = 0; i < 6; i++) {
+        vec2 d = normalize(waves[i].xy);
+        float k = 6.2831853 / waves[i].z;
+        float w = sqrt(9.8 / 6.9 * k); /* deep water: speed follows wavelength */
+        float phase = dot(d, p) * k - w * t;
+        slope += d * waves[i].w * k * cos(phase);
+        crest += waves[i].w * sin(phase);
+    }
+    /* Ripples from splashes and wakes */
+    for (int i = 0; i < u_ripple_count; i++) {
+        vec4 r = u_ripples[i];
+        float age = t - r.z;
+        if (age < 0.0 || age > 4.0) {
+            continue;
+        }
+        vec2 to = p - r.xy;
+        float dist = length(to);
+        float x = dist - age * 0.45;
+        float packet = exp(-x * x / 0.006);
+        float amplitude = r.w * 0.012 * exp(-age * 0.9) / (1.0 + dist * 6.0);
+        float k = 40.0;
+        float ring = amplitude * k * cos(x * k) * packet;
+        if (dist > 1e-4) {
+            slope += to / dist * ring;
+        }
+        crest += amplitude * sin(x * k) * packet * 4.0 + r.w * exp(-age * 2.5) * exp(-dist * dist / 0.004);
+    }
+    /* Fine chop */
+    vec2 q = p * 9.0 + vec2(t * 0.3, t * 0.2);
+    float n0 = noise(q);
+    slope += vec2(noise(q + vec2(0.05, 0.0)) - n0, noise(q + vec2(0.0, 0.05)) - n0) * 0.8;
+    return slope;
+}
+
+vec3 viewAt(vec2 frag, float depth) {
+    vec2 ndc = (frag - u_viewport.xy) / u_viewport.zw * 2.0 - 1.0;
+    vec4 v = u_inv_projection * vec4(ndc, depth * 2.0 - 1.0, 1.0);
+    return v.xyz / v.w;
+}
+
+/* View space to screen pixels; false if off the scene */
+bool toScreen(vec3 p, out vec2 frag) {
+    vec4 clip = u_projection * vec4(p, 1.0);
+    if (clip.w <= 0.0) {
+        return false;
+    }
+    vec2 ndc = clip.xy / clip.w;
+    frag = u_viewport.xy + (ndc * 0.5 + 0.5) * u_viewport.zw;
+    return all(greaterThan(ndc, vec2(-1.0))) && all(lessThan(ndc, vec2(1.0)));
+}
+
+void main()
+{
+    vec3 base = texture(main_texture, v_uv).rgb;
+    vec3 face = normalize(cross(dFdx(v_world), dFdy(v_world)));
+    vec3 colour;
+
+    if (abs(face.y) < 0.7) {
+        /* A wall or rock with the water material */
+        colour = base;
+    } else {
+        float crest;
+        mat3 to_view = transpose(mat3(u_view_to_world));
+        vec2 slope = waveSlope(v_world.xz, u_time, crest);
+        vec3 n_world = normalize(vec3(-slope.x, 1.0, -slope.y));
+        vec3 n = normalize(to_view * n_world);
+        vec3 eye = normalize(v_view);
+        if (u_camera_under != 0) {
+            n = -n;
+        }
+        float facing = clamp(dot(-eye, n), 0.0, 1.0);
+        vec2 uv_here = gl_FragCoord.xy / u_drawable;
+
+        float thickness = 0.4;
+        vec3 behind = base * 0.3;
+        if (u_have_scene != 0) {
+            float d = texture(scene_depth, uv_here).r;
+            thickness = d >= 1.0 ? 2.0 : max(0.0, length(viewAt(gl_FragCoord.xy, d) - v_view));
+            /* Refraction, unless it would pick up something in front of the water */
+            vec2 bend = n.xz * 30.0 * clamp(thickness * 4.0, 0.0, 1.0) * u_drawable.y / 900.0;
+            vec2 frag2 = gl_FragCoord.xy + vec2(bend.x, -bend.y);
+            float d2 = texture(scene_depth, frag2 / u_drawable).r;
+            if (viewAt(frag2, d2).z > v_view.z - 0.002) {
+                frag2 = gl_FragCoord.xy;
+            }
+            behind = texture(scene_colour, frag2 / u_drawable).rgb;
+        }
+        /* Deep colour from the texture's average (many water textures are a caustics pattern) */
+        vec3 average = vec3(0.0);
+        for (int y = 0; y < 4; y++) {
+            for (int x = 0; x < 4; x++) {
+                average += textureLod(main_texture, vec2(x, y) * 0.25 + 0.125, 0.0).rgb;
+            }
+        }
+        vec3 deep = average / 16.0 * vec3(0.5, 0.72, 0.78) + vec3(0.0, 0.02, 0.04);
+        /* Caustics on the bottom: two drifting layers of the same texture */
+        vec2 floor_uv = v_world.xz * 3.0;
+        float light = texture(main_texture, floor_uv + vec2(u_time * 0.03, u_time * 0.02)).g
+            * texture(main_texture, floor_uv * 0.8 - vec2(u_time * 0.025, -u_time * 0.015)).g;
+        behind *= (0.75 + 0.9 * light) * vec3(0.7, 0.88, 0.92);
+        float murk = 1.0 - exp(-thickness * 16.0);
+        vec3 through = mix(behind, deep, murk);
+
+        /* Screen-space reflection, else the sky */
+        vec3 r = reflect(eye, n);
+        vec3 r_world = mat3(u_view_to_world) * r;
+        vec3 reflected = environmentColour(normalize(vec3(r_world.x, abs(r_world.y), r_world.z)));
+        if (u_have_scene != 0 && u_camera_under == 0) {
+            vec3 p = v_view;
+            float step_len = 0.04;
+            for (int i = 0; i < 28; i++) {
+                p += r * step_len;
+                step_len *= 1.22;
+                vec2 frag;
+                if (!toScreen(p, frag)) {
+                    break;
+                }
+                float d = texture(scene_depth, frag / u_drawable).r;
+                if (d >= 1.0) {
+                    continue;
+                }
+                vec3 s = viewAt(frag, d);
+                if (p.z < s.z && s.z - p.z < step_len * 2.5) {
+                    vec2 edge = abs((frag - u_viewport.xy) / u_viewport.zw * 2.0 - 1.0);
+                    float fade = (1.0 - smoothstep(0.75, 1.0, max(edge.x, edge.y))) * (1.0 - float(i) / 28.0);
+                    reflected = mix(reflected, texture(scene_colour, frag / u_drawable).rgb, fade);
+                    break;
+                }
+            }
+        }
+
+        float fresnel = 0.02 + 0.98 * pow(1.0 - facing, 5.0);
+        colour = mix(through, reflected, clamp(fresnel * 0.92 + 0.06, 0.0, 1.0));
+
+        float glint = max(dot(r, u_sun), 0.0);
+        colour += vec3(1.0, 0.95, 0.85) * (pow(glint, 1500.0) * 1.6 + pow(glint, 120.0) * 0.06) * float(u_camera_under == 0);
+
+        /* Foam at shores, walls and splash crests */
+        float foam_noise = noise(v_world.xz * 26.0 + vec2(u_time * 0.4, -u_time * 0.3)) * noise(v_world.xz * 11.0 - u_time * 0.2);
+        float shore = 1.0 - smoothstep(0.0, 0.05, thickness);
+        float foam = clamp(shore * (0.4 + 1.2 * foam_noise) + smoothstep(0.018, 0.03, crest) * foam_noise * 2.0, 0.0, 1.0);
+        colour = mix(colour, vec3(0.92, 0.95, 0.95), foam * 0.85);
+
+        if (u_camera_under != 0) {
+            /* Underside of the surface */
+            colour = mix(through, vec3(0.45, 0.7, 0.72), 0.5 + 0.3 * noise(v_world.xz * 6.0 + u_time));
+        }
+    }
+
+    if (u_fog_enabled != 0) {
+        float linear_depth = (u_hither * u_yon / (u_yon - gl_FragCoord.z * (u_yon - u_hither)));
+        float linear_depth_normalized = linear_depth / u_yon;
+        float density = 1.0 / u_fog_max * FOGGING_EMULATE_3DFX_DENSITY_MULTIPLIER;
+        float fogging_factor = 1.0 - exp(-density * linear_depth_normalized * linear_depth_normalized);
+        colour = mix(colour, u_fog_colour, clamp(fogging_factor, 0.0, 1.0));
+    }
+    fragColour = vec4(colour, 1.0);
+}
diff --git a/drivers/glrend/water.vert.glsl b/drivers/glrend/water.vert.glsl
new file mode 100644
index 0000000..c4e6d3c
--- /dev/null
+++ b/drivers/glrend/water.vert.glsl
@@ -0,0 +1,26 @@
+#version 410 core
+
+/* Water surfaces, drawn after the rest of the scene (water.c) */
+
+uniform mat4 u_model_view;
+uniform mat4 u_projection;
+uniform mat4 u_view_to_world;
+uniform mat4 u_map_transform;
+
+in vec3 aPosition;
+in vec2 aUV;
+in vec3 aNormal;
+in vec4 aColour;
+
+out vec3 v_view;
+out vec3 v_world;
+out vec2 v_uv;
+
+void main()
+{
+    vec4 p = u_model_view * vec4(aPosition, 1.0);
+    v_view = p.xyz;
+    v_world = (u_view_to_world * p).xyz;
+    v_uv = (u_map_transform * vec4(aUV, 1.0, 0.0)).xy;
+    gl_Position = u_projection * p;
+}
