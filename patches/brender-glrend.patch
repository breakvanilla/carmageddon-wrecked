diff --git a/drivers/glrend/brender_tess.tesc.glsl b/drivers/glrend/brender_tess.tesc.glsl
new file mode 100644
index 0000000..286d14e
--- /dev/null
+++ b/drivers/glrend/brender_tess.tesc.glsl
@@ -0,0 +1,36 @@
+#version 410 core
+
+/* Curved-surface program: passes the triangle through and sets its subdivision */
+layout(vertices = 3) out;
+
+in vec3 vPos[];
+in vec3 vNormal[];
+in vec2 vUV[];
+in vec4 vColour[];
+in vec4 vSmooth[];
+in vec4 vCrease[];
+
+out vec3 tPos[];
+out vec3 tNormal[];
+out vec2 tUV[];
+out vec4 tColour[];
+out vec4 tSmooth[];
+out vec4 tCrease[];
+
+uniform float tess_level;
+
+void main()
+{
+    tPos[gl_InvocationID] = vPos[gl_InvocationID];
+    tNormal[gl_InvocationID] = vNormal[gl_InvocationID];
+    tUV[gl_InvocationID] = vUV[gl_InvocationID];
+    tColour[gl_InvocationID] = vColour[gl_InvocationID];
+    tSmooth[gl_InvocationID] = vSmooth[gl_InvocationID];
+    tCrease[gl_InvocationID] = vCrease[gl_InvocationID];
+    if (gl_InvocationID == 0) {
+        gl_TessLevelOuter[0] = tess_level;
+        gl_TessLevelOuter[1] = tess_level;
+        gl_TessLevelOuter[2] = tess_level;
+        gl_TessLevelInner[0] = tess_level;
+    }
+}
diff --git a/drivers/glrend/brender_tess.tese.glsl b/drivers/glrend/brender_tess.tese.glsl
new file mode 100644
index 0000000..cefe986
--- /dev/null
+++ b/drivers/glrend/brender_tess.tese.glsl
@@ -0,0 +1,139 @@
+#version 410 core
+
+#define MAX_LIGHTS                      48 /* Must match up with BRender */
+#define MAX_CLIP_PLANES                 6
+
+struct br_light
+{
+    vec4 position;    /* (X, Y, Z, 1) */
+    vec4 direction;   /* (X, Y, Z, 0), normalised */
+    vec4 half_;       /* (X, Y, Z, 0), normalised */
+    vec4 colour;      /* (R, G, B, 0), normalised */
+    vec4 iclq;        /* (intensity, constant, linear, attenutation) */
+    vec2 spot_angles; /* (inner, outer), if (0.0, 0.0), then this is a point light. */
+};
+
+layout(std140) uniform br_scene_state
+{
+    vec4 eye_view; /* Eye position in view-space */
+    br_light lights[MAX_LIGHTS];
+    uint num_lights;
+
+    vec4 clip_planes[MAX_CLIP_PLANES];
+    uint num_clip_planes;
+
+    float hither_z;
+    float yon_z;
+};
+
+layout(std140) uniform br_model_state
+{
+    mat4 model_view;
+    mat4 projection;
+    mat4 projection_brender;
+    mat4 mvp;
+    mat4 normal_matrix;
+    mat4 environment;
+    mat4 map_transform;
+    vec4 surface_colour;
+    vec4 clear_colour;
+    vec4 eye_m; /* Eye position in model-space */
+
+    float ka; /* Ambient mod */
+    float ks; /* Specular mod (unused) */
+    float kd; /* Diffuse mod */
+    float power;
+    uint lighting; /* Is this surface lit? */
+    int uv_source;
+    bool disable_colour_key;
+    bool disable_texture;
+    bool fog_enabled;
+    vec3 fog_colour;
+    float fog_min;
+    float fog_max;
+    float alpha;
+    uint prelit;
+    mat4 view_to_world;
+    float reflectivity;
+    float sky_width;
+    float sky_height;
+    float sky_underground;
+    uint has_sky;
+    uint texture_alpha; /* soft alpha edges */
+    uint shadow_receive;
+};
+
+/*
+ * Curved PN triangles (Vlachos et al., 2001). To stay crack-free at hard edges, an edge's control points depend only
+ * on its two vertices: smooth bends to the averaged normal's tangent plane; crease follows the crease line along it,
+ * else its face cluster's tangent plane; corner stays straight. Outputs match brender.frag.glsl.
+ */
+layout(triangles, equal_spacing, ccw) in;
+
+in vec3 tPos[];
+in vec3 tNormal[];
+in vec2 tUV[];
+in vec4 tColour[];
+in vec4 tSmooth[];
+in vec4 tCrease[];
+
+out vec4 position;
+out vec4 normal;
+out vec2 uv;
+out vec4 colour;
+out vec3 rawPosition;
+out vec3 rawNormal;
+out vec3 v_frag_pos;
+
+vec3 edgeControl(vec3 a, vec3 b, vec4 smoothA, vec4 creaseA)
+{
+    vec3 d = b - a;
+    if (smoothA.w > 1.5) {
+        return a + d / 3.0;
+    }
+    if (smoothA.w > 0.5 && abs(dot(normalize(d), creaseA.xyz)) > 0.8) {
+        return a + creaseA.xyz * (dot(d, creaseA.xyz) / 3.0);
+    }
+    vec3 n = smoothA.xyz;
+    return (2.0 * a + b - dot(d, n) * n) / 3.0;
+}
+
+void main()
+{
+    float u = gl_TessCoord.x;
+    float v = gl_TessCoord.y;
+    float w = gl_TessCoord.z;
+    vec3 p0 = tPos[0];
+    vec3 p1 = tPos[1];
+    vec3 p2 = tPos[2];
+
+    vec3 b210 = edgeControl(p0, p1, tSmooth[0], tCrease[0]);
+    vec3 b120 = edgeControl(p1, p0, tSmooth[1], tCrease[1]);
+    vec3 b021 = edgeControl(p1, p2, tSmooth[1], tCrease[1]);
+    vec3 b012 = edgeControl(p2, p1, tSmooth[2], tCrease[2]);
+    vec3 b102 = edgeControl(p2, p0, tSmooth[2], tCrease[2]);
+    vec3 b201 = edgeControl(p0, p2, tSmooth[0], tCrease[0]);
+    vec3 e = (b210 + b120 + b021 + b012 + b102 + b201) / 6.0;
+    vec3 b111 = e + (e - (p0 + p1 + p2) / 3.0) / 2.0;
+
+    vec3 p = p0 * u * u * u + p1 * v * v * v + p2 * w * w * w
+        + b210 * 3.0 * u * u * v + b120 * 3.0 * u * v * v
+        + b201 * 3.0 * u * u * w + b021 * 3.0 * v * v * w
+        + b102 * 3.0 * u * w * w + b012 * 3.0 * v * w * w
+        + b111 * 6.0 * u * v * w;
+
+    /* Smoothed normals, so curved panels also shade smoothly */
+    vec3 n = normalize(u * tSmooth[0].xyz + v * tSmooth[1].xyz + w * tSmooth[2].xyz);
+    if (any(isnan(n))) {
+        n = normalize(u * tNormal[0] + v * tNormal[1] + w * tNormal[2]);
+    }
+
+    uv = u * tUV[0] + v * tUV[1] + w * tUV[2];
+    colour = u * tColour[0] + v * tColour[1] + w * tColour[2];
+    rawPosition = p;
+    rawNormal = n;
+    position = model_view * vec4(p, 1.0);
+    normal = vec4(normalize(mat3(normal_matrix) * n), 0.0);
+    v_frag_pos = vec3((projection_brender * model_view) * vec4(p, 1.0));
+    gl_Position = projection * position;
+}
