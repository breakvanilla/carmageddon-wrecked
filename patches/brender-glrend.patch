+    // build_vbo() holds the scratch buffer, so use the heap here
+    keys = malloc(total_vertices * (sizeof(crease_key) + 1));
+    if (keys == NULL) {
+        return;
+    }
+    cluster_of = (br_uint_8*)(keys + total_vertices);
+    next = 0;
+    for (br_uint_16 g = 0; g < model->ngroups; ++g) {
+        const struct v11group* gp = model->groups + g;
+        for (br_uint_16 v = 0; v < gp->nvertices; ++v, ++next) {
+            keys[next].p = *(br_vector3_f*)(gp->position + v);
+            keys[next].index = (br_uint_32)next;
+        }
+    }
+    qsort(keys, total_vertices, sizeof(crease_key), compare_crease_keys_stable);
+
+    for (start = 0; start < total_vertices; start = end) {
+        for (end = start + 1; end < total_vertices && compare_crease_keys(&keys[start], &keys[end]) == 0; end++) {
+        }
+        nclusters = 0;
+        for (i = start; i < end; i++) {
+            const br_vector3_f* n = &vtx[keys[i].index].n;
+            best = -1;
+            best_dot = 0.64f;
