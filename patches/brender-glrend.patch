+    {
+        const state_stack* drawn = stored ? &stored->state : renderer->state.current;
+        GLuint texture = drawn->prim.colour_map != NULL ? BufferStoredGLGetTexture(drawn->prim.colour_map) : screen->asFront.tex_white;
+        if (GLRENDI_WaterIntercept(self, renderer, groupinfo, &model, texture, &gReflection.camera_to_world, gReflection.sky_tex,
+                renderer->state.current)) {
+            return;
+        }
+    }
+
+    /* Wrecked Carmageddon: sun shadows */
+    if (gShadow.dirty) {
+        UploadShadow(hVideo);
+        gShadow.dirty = 0;
+    }
+    model.shadow_receive = gShadow.active && gShadow.receiving && gShadow.program != 0;
+    if (model.shadow_receive) {
+        glActiveTexture(GL_TEXTURE2);
+        glBindTexture(GL_TEXTURE_2D, gShadow.depth_tex);
+        glActiveTexture(GL_TEXTURE0);
+    }
+
     glBufferData(GL_UNIFORM_BUFFER, sizeof(model), &model, GL_STATIC_DRAW);
-    glDrawElements(GL_TRIANGLES, groupinfo->count, GL_UNSIGNED_SHORT, groupinfo->offset);
+    if (gTess_level > 0 && hVideo->tessProgram.program != 0) {
+        DrawTessellated(hVideo, screen, groupinfo);
+    } else {
+        glDrawElements(GL_TRIANGLES, groupinfo->count, GL_UNSIGNED_SHORT, groupinfo->offset);
+    }
+    if (gShadow.active && gShadow.casting) {
+        const state_stack* drawn = stored ? &stored->state : renderer->state.current;
+        DrawShadowCaster(hVideo, groupinfo, &model,
+            (drawn->prim.flags & PRIMF_BLEND) || (drawn->prim.colour_map != NULL && drawn->prim.colour_map->blended),
+            (drawn->prim.flags & PRIMF_DEPTH_WRITE) != 0);
+        if (gShadow.dirty) {
+            UploadShadow(hVideo); /* the first caster created the map's program */
+            gShadow.dirty = 0;
+        }
+    }
 
     renderer->scene_stats.face_group_count++;
     renderer->scene_stats.triangles_rendered_count += groupinfo->group->nfaces;
