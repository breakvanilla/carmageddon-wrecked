+    float ka; /* Ambient mod */
+    float ks; /* Specular mod (unused) */
+    float kd; /* Diffuse mod */
+    float power;
+    uint lighting; /* Is this surface lit? */
+    int uv_source;
+    bool disable_colour_key;
+    bool disable_texture;
+    bool fog_enabled;
+    vec3 fog_colour;
+    float fog_min;
+    float fog_max;
+    float alpha;
+    uint prelit;
+    mat4 view_to_world;
+    float reflectivity;
+    float sky_width;
+    float sky_height;
+    float sky_underground;
+    uint has_sky;
+    uint texture_alpha; /* soft alpha edges */
+    uint shadow_receive;
+};
+
+/* Curved-surface program (brender_tess.tese.glsl): passes the model-space vertex through */
+in vec3 aPosition;
+in vec2 aUV;
+in vec3 aNormal;
+in vec4 aColour;
+in vec4 aSmooth; /* xyz: cluster-averaged normal, w: 0 smooth, 1 crease, 2 corner */
+in vec4 aCrease; /* xyz: crease line direction */
+
+out vec3 vPos;
+out vec3 vNormal;
+out vec2 vUV;
+out vec4 vColour;
+out vec4 vSmooth;
+out vec4 vCrease;
+
+void main()
+{
+    vPos = aPosition;
+    vNormal = aNormal;
+    vUV = aUV;
+    vSmooth = aSmooth;
+    vCrease = aCrease;
+
+    /* Same colour as brender.vert, where scene lights are switched off */
+    vColour = surface_colour;
+    if (lighting == 1u) {
+        vColour = prelit == 1u ? vec4(aColour.rgb, 1.0) : surface_colour;
+        if (num_lights > 0u) {
+            vColour += vec4(clear_colour.rgb, 0.0);
+        }
+    }
+}
diff --git a/drivers/glrend/default.frag.glsl b/drivers/glrend/default.frag.glsl
index b4d9700..fc6b90b 100644
--- a/drivers/glrend/default.frag.glsl
+++ b/drivers/glrend/default.frag.glsl
@@ -15,12 +15,216 @@ in vec2 uv;
 uniform sampler2D uSampler;
 uniform float uFlipVertically;
 uniform int uDiscardPurplePixels;
+uniform int uUpscale;
 
 layout (location = 0) out vec4 mainColour;
 
+/*
+ * Wrecked Carmageddon: upscaling of the 640x480 2D layer. uUpscale: 1 sharp(), 2 xbr().
+ *
+ * xbr() is xBR level 2 by Hyllian (MIT licence). Purple is the colour key for the 3D scene, so near a key pixel the
+ * hard-edged variant is used and the key still matches exactly. Low-contrast areas (dithered shading) are blended
+ * smoothly instead, as xBR turns dithering into squiggles.
+ */
+
+const vec3 KEY = vec3(1.0, 0.0, 1.0);
+const vec3 Y_WEIGHT = 48.0 * vec3(0.299, 0.587, 0.114);
+const float EQ_THRESHOLD = 15.0;
+const float LV2_COEFFICIENT = 2.0;
+const float EDGE_THRESHOLD = 6.0;   // smaller luma steps than this (out of 48) are shading, not edges
+const float SMOOTH_THRESHOLD = 9.0; // blend smoothly where a 2x2 block varies less than this
+
+ivec2 texSize;
+ivec2 base;
+vec2 srcStep; // source pixels per output pixel
+
+vec3 fetch(int dx, int dy) {
+    return texelFetch(uSampler, clamp(base + ivec2(dx, dy), ivec2(0), texSize - 1), 0).rgb;
+}
+
+vec4 luma4(vec3 a, vec3 b, vec3 c, vec3 d) {
+    return vec4(dot(a, Y_WEIGHT), dot(b, Y_WEIGHT), dot(c, Y_WEIGHT), dot(d, Y_WEIGHT));
+}
+
+vec4 df(vec4 a, vec4 b) {
+    return abs(a - b);
+}
+
+// 0.0 / 1.0 per component
+vec4 eq(vec4 a, vec4 b) {
+    return vec4(lessThan(df(a, b), vec4(EQ_THRESHOLD)));
+}
+
+vec4 neq(vec4 a, vec4 b) {
+    return vec4(greaterThanEqual(df(a, b), vec4(EDGE_THRESHOLD)));
+}
+
+vec4 weighted_distance(vec4 a, vec4 b, vec4 c, vec4 d, vec4 e, vec4 f, vec4 g, vec4 h) {
+    return df(a, b) + df(a, c) + df(d, e) + df(d, f) + 4.0 * df(g, h);
+}
+
+float c_df(vec3 a, vec3 b) {
+    vec3 d = abs(a - b);
+    return d.r + d.g + d.b;
+}
+
+vec3 resolve(vec3 E, vec3 B, vec3 D, vec3 F, vec3 H, vec4 px, vec4 amount) {
+    vec3 res1 = mix(E, mix(H, F, px.x), amount.x);
+    res1 = mix(res1, mix(B, D, px.z), amount.z);
+    vec3 res2 = mix(E, mix(F, B, px.y), amount.y);
+    res2 = mix(res2, mix(D, H, px.w), amount.w);
+    return mix(res1, res2, step(c_df(E, res1), c_df(E, res2)));
+}
+
+// Bilinear blend of the 2x2 block around src, or E if the block has a key pixel or a clear edge in it
+vec3 smoothed(vec2 src, vec3 E) {
+    vec2 p = src - 0.5;
+    ivec2 b = ivec2(floor(p));
+    vec2 t = fract(p);
+    ivec2 hi = texSize - 1;
+    vec3 c00 = texelFetch(uSampler, clamp(b, ivec2(0), hi), 0).rgb;
+    vec3 c10 = texelFetch(uSampler, clamp(b + ivec2(1, 0), ivec2(0), hi), 0).rgb;
+    vec3 c01 = texelFetch(uSampler, clamp(b + ivec2(0, 1), ivec2(0), hi), 0).rgb;
+    vec3 c11 = texelFetch(uSampler, clamp(b + ivec2(1, 1), ivec2(0), hi), 0).rgb;
+    if (c00 == KEY || c10 == KEY || c01 == KEY || c11 == KEY) {
+        return E;
+    }
+    vec4 l = luma4(c00, c10, c01, c11);
+    float range = max(max(l.x, l.y), max(l.z, l.w)) - min(min(l.x, l.y), min(l.z, l.w));
+    if (range >= SMOOTH_THRESHOLD) {
+        return E;
+    }
+    return mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);
+}
+
+vec3 xbr(vec2 src) {
+    texSize = textureSize(uSampler, 0);
+    base = ivec2(floor(src));
+    vec2 fp = fract(src);
+
+    vec3 E = fetch(0, 0);
+    vec3 B = fetch(0, -1);
+    vec3 D = fetch(-1, 0);
+    vec3 F = fetch(1, 0);
+    vec3 H = fetch(0, 1);
+
+    // Fast path: most of the screen in a race is key
+    if (E == KEY && B == KEY && D == KEY && F == KEY && H == KEY) {
+        return KEY;
+    }
+
+    vec3 A = fetch(-1, -1);
+    vec3 C = fetch(1, -1);
+    vec3 G = fetch(-1, 1);
+    vec3 I = fetch(1, 1);
+    vec3 A1 = fetch(-1, -2);
+    vec3 B1 = fetch(0, -2);
+    vec3 C1 = fetch(1, -2);
+    vec3 A0 = fetch(-2, -1);
+    vec3 C4 = fetch(2, -1);
+    vec3 D0 = fetch(-2, 0);
+    vec3 F4 = fetch(2, 0);
+    vec3 G0 = fetch(-2, 1);
+    vec3 I4 = fetch(2, 1);
+    vec3 G5 = fetch(-1, 2);
+    vec3 H5 = fetch(0, 2);
+    vec3 I5 = fetch(1, 2);
+
+    // Each component is one corner of E: x = bottom right, y = top right, z = top left, w = bottom left
+    vec4 b = luma4(B, D, H, F);
+    vec4 c = luma4(C, A, G, I);
+    vec4 e = luma4(E, E, E, E);
+    vec4 d = b.yzwx;
+    vec4 f = b.wxyz;
+    vec4 g = c.zwxy;
+    vec4 h = b.zwxy;
+    vec4 i = c.wxyz;
+    vec4 i4 = luma4(I4, C1, A0, G5);
+    vec4 i5 = luma4(I5, C4, A1, G0);
+    vec4 h5 = luma4(H5, F4, B1, D0);
+    vec4 f4 = h5.yzwx;
+
+    const vec4 Ao = vec4(1.0, -1.0, -1.0, 1.0);
+    const vec4 Bo = vec4(1.0, 1.0, -1.0, -1.0);
+    const vec4 Co = vec4(1.5, 0.5, -0.5, 0.5);
+    const vec4 Ax = vec4(1.0, -1.0, -1.0, 1.0);
+    const vec4 Bx = vec4(0.5, 2.0, -0.5, -2.0);
+    const vec4 Cx = vec4(1.0, 1.0, -0.5, 0.0);
+    const vec4 Ay = vec4(1.0, -1.0, -1.0, 1.0);
+    const vec4 By = vec4(2.0, 0.5, -2.0, -0.5);
+    const vec4 Cy = vec4(2.0, 0.0, -1.0, 0.5);
+
+    // These lines split E: on the far side of a line E takes the neighbouring colour
+    vec4 fx = Ao * fp.y + Bo * fp.x;
+    vec4 fx_left = Ax * fp.y + Bx * fp.x;
+    vec4 fx_up = Ay * fp.y + By * fp.x;
+
+    vec4 interp_restriction_lv1 = neq(e, f) * neq(e, h)
+        * clamp((1.0 - eq(f, b)) * (1.0 - eq(h, d))
+                + eq(e, i) * (1.0 - eq(f, i4)) * (1.0 - eq(h, i5))
+                + eq(e, g) + eq(e, c),
+            0.0, 1.0);
+    vec4 interp_restriction_lv2_left = neq(e, g) * neq(d, g);
+    vec4 interp_restriction_lv2_up = neq(e, c) * neq(b, c);
+
+    vec4 edr = vec4(lessThan(weighted_distance(e, c, g, i, h5, f4, h, f), weighted_distance(h, d, i5, f, i4, b, e, i)))
+        * interp_restriction_lv1;
+    vec4 edr_left = vec4(lessThanEqual(LV2_COEFFICIENT * df(f, g), df(h, c))) * interp_restriction_lv2_left * edr;
+    vec4 edr_up = vec4(greaterThanEqual(df(f, g), LV2_COEFFICIENT * df(h, c))) * interp_restriction_lv2_up * edr;
+    vec4 px = vec4(lessThanEqual(df(e, f), df(e, h)));
+
+    if (E == KEY || B == KEY || D == KEY || F == KEY || H == KEY) {
+        vec4 hard = max(max(edr_left * step(Cx, fx_left), edr_up * step(Cy, fx_up)), edr * step(Co, fx));
+        return resolve(E, B, D, F, H, px, hard);
+    }
+
+    // Anti-alias each edge over about one output pixel; widths come from srcStep, as fp jumps at source pixel edges
+    vec4 w45 = max(abs(Ao) * srcStep.y + abs(Bo) * srcStep.x, vec4(1e-4));
+    vec4 w30 = max(abs(Ax) * srcStep.y + abs(Bx) * srcStep.x, vec4(1e-4));
+    vec4 w60 = max(abs(Ay) * srcStep.y + abs(By) * srcStep.x, vec4(1e-4));
+    vec4 fx45 = edr * smoothstep(Co - w45 / 2.0, Co + w45 / 2.0, fx);
+    vec4 fx30 = edr_left * smoothstep(Cx - w30 / 2.0, Cx + w30 / 2.0, fx_left);
+    vec4 fx60 = edr_up * smoothstep(Cy - w60 / 2.0, Cy + w60 / 2.0, fx_up);
+    vec4 amount = max(max(fx30, fx60), fx45);
+    if (amount == vec4(0.0)) {
+        return smoothed(src, E);
+    }
+    return resolve(E, B, D, F, H, px, amount);
+}
+
+// Square pixels blended with their neighbour only within half an output pixel of the edge; nearest pixel near a key
+vec3 sharp(vec2 src) {
+    texSize = textureSize(uSampler, 0);
+    vec2 scale = 1.0 / max(srcStep, vec2(1e-4));
+    vec2 cell = floor(src);
+    vec2 d = fract(src) - 0.5;
+    vec2 range = max(0.5 - 0.5 / scale, vec2(0.0));
+    vec2 q = cell + (d - clamp(d, -range, range)) * scale;
+    ivec2 b = ivec2(floor(q));
+    vec2 t = fract(q);
+    ivec2 hi = texSize - 1;
+    vec3 c00 = texelFetch(uSampler, clamp(b, ivec2(0), hi), 0).rgb;
+    vec3 c10 = texelFetch(uSampler, clamp(b + ivec2(1, 0), ivec2(0), hi), 0).rgb;
+    vec3 c01 = texelFetch(uSampler, clamp(b + ivec2(0, 1), ivec2(0), hi), 0).rgb;
+    vec3 c11 = texelFetch(uSampler, clamp(b + ivec2(1, 1), ivec2(0), hi), 0).rgb;
+    if (c00 == KEY || c10 == KEY || c01 == KEY || c11 == KEY) {
+        return texelFetch(uSampler, clamp(ivec2(cell), ivec2(0), hi), 0).rgb;
+    }
+    return mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);
+}
+
 void main()
 {
-    mainColour = texture(uSampler, vec2(uv.x, abs(uFlipVertically - uv.y)));
+    vec2 coord = vec2(uv.x, abs(uFlipVertically - uv.y));
+    vec2 src = coord * vec2(textureSize(uSampler, 0));
+    srcStep = fwidth(src);
+    if (uUpscale == 2) {
+        mainColour = vec4(xbr(src), 1.0);
+    } else if (uUpscale == 1) {
+        mainColour = vec4(sharp(src), 1.0);
+    } else {
+        mainColour = texture(uSampler, coord);
+    }
     if (uDiscardPurplePixels == 1 && mainColour.rgb == vec3(1.0, 0.0, 1.0)) {
         discard;
     }
