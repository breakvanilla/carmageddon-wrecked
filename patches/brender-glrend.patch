+// brender.frag.glsl for a GLSL 4.10 core context: GL_CORE parts only, no extension line
+static char* Frag410(void) {
+    char* out;
+    char line[2048];
+    size_t i, n, len;
+    int skip;
+
+    out = calloc(1, sizeof(BRENDER_FRAG_GLSL) + 64);
+    skip = 0;
+    for (i = 0; i < sizeof(BRENDER_FRAG_GLSL); i += n) {
+        for (n = 0; i + n < sizeof(BRENDER_FRAG_GLSL) && BRENDER_FRAG_GLSL[i + n] != '\n'; n++) {
+        }
+        n++;
+        len = n < sizeof(line) - 1 ? n : sizeof(line) - 1;
+        memcpy(line, BRENDER_FRAG_GLSL + i, len);
+        line[len] = '\0';
+        if (strncmp(line, "##ifdef GL_ES", 13) == 0) {
+            skip = 1;
+        } else if (strncmp(line, "##ifdef GL_CORE", 15) == 0 || strncmp(line, "##endif", 7) == 0) {
+            skip = 0;
+        } else if (!skip && strncmp(line, "#extension", 10) != 0) {
+            strcat(out, strncmp(line, "#version", 8) == 0 ? "#version 410 core\n" : line);
+        }
+    }
+    return out;
+}
