+static br_uint_32 pixels_crc32(br_pixelmap* pm) {
+    static br_uint_32 table[256];
+    br_uint_32 crc;
+    br_uint_8* row;
+    int x, y, k;
+
+    if (table[1] == 0) {
+        for (k = 0; k < 256; k++) {
+            crc = k;
+            for (x = 0; x < 8; x++) {
+                crc = (crc & 1) ? 0xEDB88320u ^ (crc >> 1) : crc >> 1;
+            }
+            table[k] = crc;
+        }
+    }
+    crc = 0xFFFFFFFFu;
+    for (y = 0; y < pm->height; y++) {
+        row = (br_uint_8*)pm->pixels + y * pm->row_bytes;
+        for (x = 0; x < pm->width; x++) {
+            crc = table[(crc ^ row[x]) & 0xFF] ^ (crc >> 8);
+        }
+    }
+    return crc ^ 0xFFFFFFFFu;
+}
+
+static br_boolean load_replacement(br_pixelmap* pm, br_boolean* pSoft_alpha) {
+    static int announced;
+    static int log_lookups = -1;
+    char path[1200];
+    char name[256];
+    unsigned char* pixels;
+    char* dot;
+    int width, height, channels;
+    int i;
+    int dir;
+    br_uint_32 crc = 0;
+
+    if (gTexture_dir_count == 0 || pm->identifier == NULL || pm->identifier[0] == '\0') {
+        return BR_FALSE;
+    }
+    for (i = 0; pm->identifier[i] != '\0' && i < (int)sizeof(name) - 1; i++) {
+        name[i] = (char)tolower((unsigned char)pm->identifier[i]);
+    }
+    name[i] = '\0';
+    if ((dot = strrchr(name, '.')) != NULL) {
+        *dot = '\0';
+    }
+    pixels = NULL;
+    for (dir = 0; dir < gTexture_dir_count && pixels == NULL; dir++) {
+        if (strncmp(name, "carmamod_", 9) == 0) {
+            BrSprintfN(path, sizeof(path) - 1, "%s/%s.png", gTexture_dirs[dir], name);
+        } else {
+            if (dir == 0) {
+                crc = pixels_crc32(pm);
+            }
+            BrSprintfN(path, sizeof(path) - 1, "%s/%s-%dx%d-%08x.png", gTexture_dirs[dir], name, pm->width, pm->height, crc);
+        }
+        pixels = stbi_load(path, &width, &height, &channels, 4);
+    }
+    if (log_lookups < 0) {
+        log_lookups = getenv("CARMA_TEXTURE_LOG") != NULL;
+    }
+    if (log_lookups) {
+        BrLogPrintf("GLREND: %s %s\n", pixels != NULL ? "hi-res" : "original", strrchr(path, '/') + 1);
+    }
+    if (pixels == NULL) {
+        return BR_FALSE;
+    }
+    if (!announced) {
+        BrLogPrintf("GLREND: using hi-res textures from %s\n", gTexture_dirs[dir - 1]);
+        announced = 1;
+    }
+    // Partial alpha (smoke, fire): drawn blended instead of colour-keyed
+    *pSoft_alpha = BR_FALSE;
+    if (channels == 4) {
+        for (i = 0; i < width * height; i++) {
+            if (pixels[i * 4 + 3] < 250) {
+                *pSoft_alpha = BR_TRUE;
+                break;
+            }
+        }
+    }
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+    stbi_image_free(pixels);
+    return BR_TRUE;
+}
