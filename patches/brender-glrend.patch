+// PN-triangle patches (brender_tess.tese.glsl)
+static void DrawTessellated(HVIDEO hVideo, br_device_pixelmap* screen, const gl_groupinfo* groupinfo) {
+    typedef void (*patch_parameteri_fn)(GLenum, GLint);
+    static patch_parameteri_fn patch_parameteri;
