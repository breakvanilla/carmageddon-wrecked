+static void UploadLights(GLint count_loc, GLint position_loc, GLint colour_loc, GLint direction_loc) {
+    GLfloat position[GLREND_MAX_LIGHTS][4];
+    GLfloat colour[GLREND_MAX_LIGHTS][4];
+    GLfloat direction[GLREND_MAX_LIGHTS][4];
+    br_matrix34 world_to_view;
+    br_vector3 v;
+    int i;
+
+    BrMatrix34Inverse(&world_to_view, &gReflection.camera_to_world);
+    for (i = 0; i < gLights.count; i++) {
+        const glrend_light* l = &gLights.lights[i];
+        BrMatrix34ApplyP(&v, (br_vector3*)&l->position, &world_to_view);
+        position[i][0] = v.v[0];
+        position[i][1] = v.v[1];
+        position[i][2] = v.v[2];
+        position[i][3] = l->radius;
+        BrMatrix34ApplyV(&v, (br_vector3*)&l->direction, &world_to_view);
+        direction[i][0] = v.v[0];
+        direction[i][1] = v.v[1];
+        direction[i][2] = v.v[2];
+        direction[i][3] = l->spot_inner_cos;
+        colour[i][0] = l->colour.v[0];
+        colour[i][1] = l->colour.v[1];
+        colour[i][2] = l->colour.v[2];
+        colour[i][3] = l->spot_outer_cos;
+    }
+    glUniform1i(count_loc, gLights.count);
+    if (gLights.count > 0) {
+        glUniform4fv(position_loc, gLights.count, &position[0][0]);
+        glUniform4fv(colour_loc, gLights.count, &colour[0][0]);
+        glUniform4fv(direction_loc, gLights.count, &direction[0][0]);
+    }
+}
