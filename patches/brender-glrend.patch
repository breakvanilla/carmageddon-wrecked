+static void CompileTessProgram(HVIDEO hVideo) {
+    static const char* names[] = { "aPosition", "aUV", "aNormal", "aColour" };
+    GLint locations[4];
+    GLuint stages[4];
+    GLuint program;
+    GLint status;
+    char* frag;
+    char log[1024];
+    int i;
+
+    hVideo->tessProgram.program = 0;
+    if (GLVersion.major < 4 || getenv("CARMA_TESSELLATION") != NULL && atoi(getenv("CARMA_TESSELLATION")) == 0) {
+        return;
+    }
+    frag = Frag410();
+    stages[0] = CompileTessStage(GL_VERTEX_SHADER, "brender_tess.vert", BRENDER_TESS_VERT_GLSL, sizeof(BRENDER_TESS_VERT_GLSL));
+    stages[1] = CompileTessStage(0x8E88 /* GL_TESS_CONTROL_SHADER */, "brender_tess.tesc", BRENDER_TESS_TESC_GLSL, sizeof(BRENDER_TESS_TESC_GLSL));
+    stages[2] = CompileTessStage(0x8E87 /* GL_TESS_EVALUATION_SHADER */, "brender_tess.tese", BRENDER_TESS_TESE_GLSL, sizeof(BRENDER_TESS_TESE_GLSL));
+    stages[3] = CompileTessStage(GL_FRAGMENT_SHADER, "brender.frag (4.10)", frag, (GLint)strlen(frag));
+    free(frag);
+    if (!stages[0] || !stages[1] || !stages[2] || !stages[3]) {
+        return;
+    }
+
+    program = glCreateProgram();
+    for (i = 0; i < 4; i++) {
+        glAttachShader(program, stages[i]);
+    }
+    // Same attribute slots as brenderProgram: both use the same vertex arrays
+    locations[0] = hVideo->brenderProgram.attributes.aPosition;
+    locations[1] = hVideo->brenderProgram.attributes.aUV;
+    locations[2] = hVideo->brenderProgram.attributes.aNormal;
+    locations[3] = hVideo->brenderProgram.attributes.aColour;
+    for (i = 0; i < 4; i++) {
+        if (locations[i] >= 0) {
+            glBindAttribLocation(program, locations[i], names[i]);
+        }
+    }
+    glBindAttribLocation(program, GLREND_ATTRIB_SMOOTH, "aSmooth");
+    glBindAttribLocation(program, GLREND_ATTRIB_CREASE, "aCrease");
+    glLinkProgram(program);
+    for (i = 0; i < 4; i++) {
+        glDeleteShader(stages[i]);
+    }
+    glGetProgramiv(program, GL_LINK_STATUS, &status);
+    if (status != GL_TRUE) {
+        glGetProgramInfoLog(program, sizeof(log), NULL, log);
+        BrLogPrintf("GLREND: curved surfaces off, link failed:\n%s\n", log);
+        glDeleteProgram(program);
+        return;
+    }
+
+    glUniformBlockBinding(program, glGetUniformBlockIndex(program, "br_scene_state"), hVideo->brenderProgram.blockBindingScene);
+    glUniformBlockBinding(program, glGetUniformBlockIndex(program, "br_model_state"), hVideo->brenderProgram.blockBindingModel);
+    glUseProgram(program);
+    glUniform1i(glGetUniformLocation(program, "main_texture"), hVideo->brenderProgram.mainTextureBinding);
+    glUniform1i(glGetUniformLocation(program, "env_texture"), 1);
+    hVideo->tessProgram.tess_level = glGetUniformLocation(program, "tess_level");
+    hVideo->tessProgram.dl_count = glGetUniformLocation(program, "dl_count");
+    hVideo->tessProgram.dl_position = glGetUniformLocation(program, "dl_position");
+    hVideo->tessProgram.dl_colour = glGetUniformLocation(program, "dl_colour");
+    hVideo->tessProgram.dl_direction = glGetUniformLocation(program, "dl_direction");
+    glUniform1i(hVideo->tessProgram.dl_count, 0);
+    glUseProgram(hVideo->brenderProgram.program);
+    hVideo->tessProgram.program = program;
+    BrLogPrintf("GLREND: curved surfaces for cars available\n");
+}
