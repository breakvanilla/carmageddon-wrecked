+}
+
+static void UploadShadow(HVIDEO hVideo) {
+    br_matrix34 world_to_view;
+    br_vector3 v;
+
+    glUniform1i(hVideo->brenderProgram.uniforms.shadow_on, gShadow.active && gShadow.program != 0);
+    if (gShadow.active && gShadow.program != 0) {
+        glUniformMatrix4fv(hVideo->brenderProgram.uniforms.shadow_vp, 1, GL_FALSE, &gShadow.light_vp.m[0][0]);
+        BrMatrix34Inverse(&world_to_view, &gReflection.camera_to_world);
+        BrMatrix34ApplyV(&v, &gShadow.light_dir, &world_to_view);
+        BrVector3Normalise(&v, &v);
+        glUniform3f(hVideo->brenderProgram.uniforms.shadow_light, v.v[0], v.v[1], v.v[2]);
+        glUniform1f(hVideo->brenderProgram.uniforms.shadow_texel, 1.f / SHADOW_MAP_SIZE);
+    }
+}
