+/*
+ * Wrecked Carmageddon: curved-surface program (OpenGL 4.0 tessellation). If anything fails, cars are drawn flat.
+ */
+static GLuint CompileTessStage(GLenum type, const char* name, const char* source, GLint length) {
+    GLuint shader;
+    GLint status;
+    char log[1024];
+
+    shader = glCreateShader(type);
+    glShaderSource(shader, 1, &source, &length);
+    glCompileShader(shader);
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &status);
+    if (status != GL_TRUE) {
+        glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+        BrLogPrintf("GLREND: curved surfaces off, %s failed to compile:\n%s\n", name, log);
+        glDeleteShader(shader);
+        return 0;
+    }
+    return shader;
+}
