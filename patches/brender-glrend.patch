+/* Wrecked Carmageddon: car paint reflects the track's sky texture, mapped as the game draws the sky, darker below the
+ * horizon. */
+vec3 environmentColour(vec3 r) {
+    vec3 sky;
+    float elevation = asin(clamp(r.y, -1.0, 1.0));
+
+    if (has_sky != 0u) {
+        float height = float(textureSize(env_texture, 0).y);
+        float u = atan(r.x, -r.z) / sky_width;
+        float v = 1.0 - (elevation + sky_underground) / sky_height;
+        sky = textureLod(env_texture, vec2(u, clamp(v, 0.5 / height, 1.0 - 0.5 / height)), 0.0).rgb;
+    } else {
+        sky = mix(vec3(0.55, 0.6, 0.65), vec3(0.3, 0.45, 0.7), clamp(r.y, 0.0, 1.0));
+    }
+    return sky * mix(0.3, 1.0, smoothstep(-0.25, 0.05, r.y));
+}
+
+void applyReflection(vec3 base) {
+    vec3 n = normalize(normal.xyz);
+    vec3 i = normalize(position.xyz);
+    if (dot(n, i) > 0.0) {
+        n = -n;
+    }
+    vec3 rw = normalize(mat3(view_to_world) * reflect(i, n));
+    float fresnel = 0.04 + 0.96 * pow(1.0 - clamp(dot(-i, n), 0.0, 1.0), 5.0);
+    // Dark parts (tyres, grilles, shadows in the paint) stay matte
