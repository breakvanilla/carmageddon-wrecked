+/*
+ * Wrecked Carmageddon: sun shadows. Casters (drawn before the track) also go into a depth map seen from the sun.
+ * Keyed and soft-alpha see-through parts cast no shadow.
+ */
+#define SHADOW_MAP_SIZE 2048
+
+extern GLint gGLREND_scene_viewport[4];
+
+static struct {
+    int active;
+    int casting;
+    int receiving;
+    int dirty;     /* brenderProgram needs the uniforms */
+    int failed;
+    GLuint fbo;
+    GLuint depth_tex;
+    GLuint program;
+    GLint loc_mvp;
+    GLint loc_key;
+    GLint loc_alpha;
+    br_matrix4 light_vp;  /* world to the map's clip space (row vectors, as BRender) */
+    br_vector3 light_dir; /* world space */
+    int casters;          /* this frame */
+} gShadow;
+
+static const char* gShadow_vertex_src = "#version 410 core\n"
+    "uniform mat4 u_mvp;\n"
+    "in vec3 aPosition;\n"
+    "in vec2 aUV;\n"
+    "out vec2 v_uv;\n"
+    "void main() { v_uv = aUV; gl_Position = u_mvp * vec4(aPosition, 1.0); }\n";
+
+static const char* gShadow_fragment_src = "#version 410 core\n"
+    "uniform sampler2D main_texture;\n"
+    "uniform int u_key;\n"
+    "uniform int u_alpha;\n"
+    "in vec2 v_uv;\n"
+    "out vec4 colour;\n"
+    "void main() {\n"
+    "    if (u_key != 0 || u_alpha != 0) {\n"
+    "        vec4 t = texture(main_texture, v_uv);\n"
+    "        if ((u_alpha != 0 && t.a < 0.5) || (u_alpha == 0 && t.rgb == vec3(0.0))) discard;\n"
+    "    }\n"
+    "    colour = vec4(1.0);\n"
+    "}\n";
+
+static GLuint ShadowCompile(GLenum type, const char* src) {
+    GLuint shader;
+    GLint status;
+    char log[512];
+
+    shader = glCreateShader(type);
+    glShaderSource(shader, 1, &src, NULL);
+    glCompileShader(shader);
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &status);
+    if (status != GL_TRUE) {
+        glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+        BrLogPrintf("GLREND: no sun shadows, shader failed:\n%s\n", log);
+        glDeleteShader(shader);
+        return 0;
+    }
+    return shader;
+}
+
+static int ShadowInit(HVIDEO hVideo) {
+    GLuint vs, fs;
+    GLint status;
+
+    if (gShadow.program != 0) {
+        return 1;
+    }
+    if (gShadow.failed || GLVersion.major < 4) {
+        gShadow.failed = 1;
+        return 0;
+    }
+    vs = ShadowCompile(GL_VERTEX_SHADER, gShadow_vertex_src);
+    fs = ShadowCompile(GL_FRAGMENT_SHADER, gShadow_fragment_src);
+    if (vs == 0 || fs == 0) {
+        gShadow.failed = 1;
+        return 0;
+    }
+    gShadow.program = glCreateProgram();
+    glAttachShader(gShadow.program, vs);
+    glAttachShader(gShadow.program, fs);
+    /* Same attribute slots as brenderProgram: same vertex arrays */
+    glBindAttribLocation(gShadow.program, hVideo->brenderProgram.attributes.aPosition, "aPosition");
+    if (hVideo->brenderProgram.attributes.aUV >= 0) {
+        glBindAttribLocation(gShadow.program, hVideo->brenderProgram.attributes.aUV, "aUV");
+    }
+    glLinkProgram(gShadow.program);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    glGetProgramiv(gShadow.program, GL_LINK_STATUS, &status);
+    if (status != GL_TRUE) {
+        BrLogPrintf("GLREND: no sun shadows, link failed\n");
+        glDeleteProgram(gShadow.program);
+        gShadow.program = 0;
+        gShadow.failed = 1;
+        return 0;
+    }
+    gShadow.loc_mvp = glGetUniformLocation(gShadow.program, "u_mvp");
+    gShadow.loc_key = glGetUniformLocation(gShadow.program, "u_key");
+    gShadow.loc_alpha = glGetUniformLocation(gShadow.program, "u_alpha");
+    glUseProgram(gShadow.program);
+    glUniform1i(glGetUniformLocation(gShadow.program, "main_texture"), 0);
+    glUseProgram(hVideo->brenderProgram.program);
+
+    glGenTextures(1, &gShadow.depth_tex);
+    glBindTexture(GL_TEXTURE_2D, gShadow.depth_tex);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT24, SHADOW_MAP_SIZE, SHADOW_MAP_SIZE, 0, GL_DEPTH_COMPONENT, GL_FLOAT, NULL);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glGenFramebuffers(1, &gShadow.fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, gShadow.fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, gShadow.depth_tex, 0);
+    glDrawBuffer(GL_NONE);
+    glReadBuffer(GL_NONE);
+    status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    if (status != GL_FRAMEBUFFER_COMPLETE) {
+        BrLogPrintf("GLREND: no sun shadows, framebuffer incomplete (0x%x)\n", status);
+        gShadow.failed = 1;
+        return 0;
+    }
+    BrLogPrintf("GLREND: sun shadows on\n");
+    return 1;
+}
+
+static int gShadow_needs_clear;
+
+/* Carried with deferred draws (GLRENDI_SaveDrawSettings()) */
+static int GLRENDI_ShadowFlags(void) {
+    return gShadow.casting | (gShadow.receiving << 1);
+}
+
+static void GLRENDI_SetShadowFlags(int flags) {
+    gShadow.casting = flags & 1;
+    gShadow.receiving = (flags >> 1) & 1;
+}
+
+void BR_PUBLIC_ENTRY GLREND_ShadowBegin(const br_vector3* pLight_dir, const br_vector3* pCentre, float pExtent) {
+    br_vector3 x, y, z, up, centre;
+    br_matrix4 world_to_light, projection;
+    br_scalar lx, ly, texel;
+    const br_scalar depth = 40.f; /* world units either side of the centre, along the light */
+    int i;
+
+    if (gShadow.failed) {
+        return;
+    }
+    BrVector3Normalise(&gShadow.light_dir, (br_vector3*)pLight_dir);
+    /* The map looks along the light: its z axis points back at the sun */
+    BrVector3Negate(&z, &gShadow.light_dir);
+    BrVector3Set(&up, 0.f, 1.f, 0.f);
+    if (fabsf(z.v[1]) > 0.99f) {
+        BrVector3Set(&up, 0.f, 0.f, 1.f);
+    }
+    BrVector3Cross(&x, &up, &z);
+    BrVector3Normalise(&x, &x);
+    BrVector3Cross(&y, &z, &x);
+    /* Snap to whole texels so shadow edges don't crawl */
+    texel = 2.f * pExtent / SHADOW_MAP_SIZE;
+    lx = BrVector3Dot((br_vector3*)pCentre, &x);
+    ly = BrVector3Dot((br_vector3*)pCentre, &y);
+    centre = *pCentre;
+    for (i = 0; i < 3; i++) {
+        centre.v[i] += x.v[i] * (floorf(lx / texel) * texel - lx) + y.v[i] * (floorf(ly / texel) * texel - ly);
+    }
+    BrMatrix4Identity(&world_to_light);
+    for (i = 0; i < 3; i++) {
+        world_to_light.m[i][0] = x.v[i];
+        world_to_light.m[i][1] = y.v[i];
+        world_to_light.m[i][2] = z.v[i];
+    }
+    world_to_light.m[3][0] = -BrVector3Dot(&centre, &x);
+    world_to_light.m[3][1] = -BrVector3Dot(&centre, &y);
+    world_to_light.m[3][2] = -BrVector3Dot(&centre, &z);
+    BrMatrix4Identity(&projection);
+    projection.m[0][0] = 1.f / pExtent;
+    projection.m[1][1] = 1.f / pExtent;
+    projection.m[2][2] = -1.f / depth; /* nearer the sun, smaller depth */
+    BrMatrix4Mul(&gShadow.light_vp, &world_to_light, &projection);
+    gShadow.active = 1;
+    gShadow.dirty = 1;
+    gShadow.casters = 0;
+    gShadow_needs_clear = 1;
+}
+
+void BR_PUBLIC_ENTRY GLREND_ShadowCasting(int on) {
+    gShadow.casting = on;
+}
+
+void BR_PUBLIC_ENTRY GLREND_ShadowReceiving(int on) {
+    gShadow.receiving = on;
+}
+
+void BR_PUBLIC_ENTRY GLREND_ShadowEnd(void) {
+    gShadow.active = 0;
+    gShadow.casting = 0;
+    gShadow.receiving = 0;
+    gShadow.dirty = 1;
+}
+
+/* Draws the group into the shadow map, then restores the scene's state */
+static void DrawShadowCaster(HVIDEO hVideo, const gl_groupinfo* groupinfo, const shader_data_model* model, br_boolean blending, br_boolean depth_write) {
+    br_matrix4 model_to_world, mvp;
+
+    if (!ShadowInit(hVideo)) {
+        return;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, gShadow.fbo);
+    glViewport(0, 0, SHADOW_MAP_SIZE, SHADOW_MAP_SIZE);
+    glDepthMask(GL_TRUE);
+    if (gShadow_needs_clear) {
+        glClear(GL_DEPTH_BUFFER_BIT);
+        gShadow_needs_clear = 0;
+    }
+    glDisable(GL_BLEND);
+    glDisable(GL_SAMPLE_ALPHA_TO_COVERAGE);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LESS);
+    glUseProgram(gShadow.program);
+    BrMatrix4Mul(&model_to_world, &model->model_view, &gReflection.view_to_world);
+    BrMatrix4Mul(&mvp, &model_to_world, &gShadow.light_vp);
+    glUniformMatrix4fv(gShadow.loc_mvp, 1, GL_FALSE, &mvp.m[0][0]);
+    glUniform1i(gShadow.loc_key, !model->disable_texture && !model->disable_colour_key);
+    glUniform1i(gShadow.loc_alpha, !model->disable_texture && model->texture_alpha);
+    glDrawElements(GL_TRIANGLES, groupinfo->count, GL_UNSIGNED_SHORT, groupinfo->offset);
+    gShadow.casters++;
+
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glViewport(gGLREND_scene_viewport[0], gGLREND_scene_viewport[1], gGLREND_scene_viewport[2], gGLREND_scene_viewport[3]);
+    glUseProgram(hVideo->brenderProgram.program);
+    glDepthMask(depth_write ? GL_TRUE : GL_FALSE);
+    if (blending) {
+        glEnable(GL_BLEND);
+    }
+    if (model->texture_alpha && !blending) {
+        glEnable(GL_SAMPLE_ALPHA_TO_COVERAGE);
