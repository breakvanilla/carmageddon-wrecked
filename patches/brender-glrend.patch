+    vec2 uv = clamp(frag + wobble, u_viewport.xy + 1.0, u_viewport.xy + u_viewport.zw - 1.0) / u_drawable;
+    vec3 colour = texture(scene_colour, uv).rgb;
+    float depth = texture(scene_depth, uv).r;
