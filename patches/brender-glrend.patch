+            out->smooth.v[1] = a->v[1];
+            out->smooth.v[2] = a->v[2];
+            out->smooth.v[3] = nclusters <= 1 ? 0.f : nclusters == 2 ? 1.f : 2.f;
+            out->crease.v[0] = out->crease.v[1] = out->crease.v[2] = out->crease.v[3] = 0.f;
+            if (nclusters == 2) {
