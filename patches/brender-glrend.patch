+    vec2 ndc = local * 2.0 - 1.0;
+    vec4 v = u_inv_projection * vec4(ndc, depth * 2.0 - 1.0, 1.0);
+    vec3 view = v.xyz / v.w;
+    float dist = depth >= 1.0 ? 1000.0 : length(view);
+    vec3 world = (u_view_to_world * vec4(view, 1.0)).xyz;
+
+    /* Stronger nearer the surface */
+    if (depth < 1.0) {
+        float below = max(0.0, u_surface - world.y);
+        colour += colour * caustics(world.xz * 3.0, u_time) * 0.9 * exp(-below * 4.0);
+    }
+    float murk = 1.0 - exp(-dist * 0.9);
+    colour = mix(colour * vec3(0.55, 0.85, 0.9), u_tint, murk);
+    /* Light shafts from the surface */
+    float shafts = noise(vec2(local.x * 9.0 + local.y * 2.5 + u_time * 0.15, u_time * 0.1)) * smoothstep(0.1, 1.0, local.y);
+    colour += u_tint * 1.4 * pow(shafts, 3.0) * 0.6;
+    fragColour = vec4(colour, 1.0);
+}
