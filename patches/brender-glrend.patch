+/* Surfaces are prelit, so this is added on top. Wraps around a little as old models have rough normals. */
+vec3 dynamicLight(vec3 p) {
+    vec3 n = normalize(normal.xyz);
+    if (dot(n, p) > 0.0) {
+        n = -n;
+    }
+    vec3 sum = vec3(0.0);
+    for (int k = 0; k < dl_count; k++) {
+        vec3 d = dl_position[k].xyz - p;
+        float dist = length(d);
+        float radius = dl_position[k].w;
+        if (dist >= radius) {
+            continue;
+        }
+        vec3 l = d / max(dist, 1e-4);
+        float falloff = 1.0 - (dist * dist) / (radius * radius);
+        falloff *= falloff;
+        float lambert = clamp(dot(n, l) * 0.75 + 0.25, 0.0, 1.0);
+        float spot = 1.0;
