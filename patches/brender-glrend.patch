+    fragColour.rgb += vec3(1.0, 0.95, 0.85) * pow(max(dot(rw, sun), 0.0), 80.0) * reflectivity * paint;
+}
+
+/* 0 to 1 */
+float sunShadow() {
+    vec4 world = view_to_world * position;
+    vec4 clip = shadow_vp * world;
+    vec3 p = clip.xyz / clip.w * 0.5 + 0.5;
+    if (p.x <= 0.0 || p.x >= 1.0 || p.y <= 0.0 || p.y >= 1.0 || p.z >= 1.0) {
+        return 0.0;
+    }
+    float blocked = 0.0;
+    for (int dy = -1; dy <= 1; dy++) {
+        for (int dx = -1; dx <= 1; dx++) {
+            float d = texture(shadow_map, p.xy + vec2(dx, dy) * shadow_texel).r;
+            blocked += d < p.z - 0.0008 ? 1.0 : 0.0;
