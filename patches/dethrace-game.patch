+static void CarModelToWorld(tCar_spec* pCar, br_matrix34* pOut, br_bounds** pBounds) {
+    br_actor* actor;
+
+    actor = pCar->car_model_actors[pCar->principal_car_actor].actor;
+    *pBounds = &actor->model->bounds;
+    BrMatrix34Mul(pOut, &actor->t.t.mat, &pCar->car_master_actor->t.t.mat);
