+static struct {
+    int built;
+    br_actor* root;
+    br_material* chunk_material;
+    br_material* decal_material;
+    br_material* scorch_material;
+    tDebris debris[DEBRIS_COUNT];
+    int next_debris;
+    tDecal decals[DECAL_COUNT];
+    int next_decal;
+    int decals_used;
+    tProp props[PROP_COUNT];
+    int prop_count;
+    tU32 race; // gRace_serial of the race the state belongs to
+    tColour_cache colours[64];
+    int next_colour;
+    struct {
+        br_vector3 pos;
+        br_vector3 force;
+        int material;
+        int pending;
+    } crash;
+    tU32 last_crash;
+    br_vector3 last_hole;
+    int impacts;
+    int props_knocked;
+    int props_shattered;
+    int crashes;
+    int explosions;
+} gDestruct;
+
+// Remembers which actor the ray hit
+static struct {
+    br_scalar t;
+    br_actor* actor;
+    br_actor* current;
+} gPick;
+
+static int PickPolyCallback(br_model* pModel, br_material* pMaterial, br_vector3* pRay_pos, br_vector3* pRay_dir, br_scalar pT, int pF, int pE, int pV, br_vector3* pPoint, br_vector2* pMap, void* pArg) {
+    if (pT < gPick.t) {
+        gPick.t = pT;
+        gPick.actor = gPick.current;
+    }
+    return 0;
+}
+
+static int PickActorCallback(br_actor* pActor, br_model* pModel, br_material* pMaterial, br_vector3* pRay_pos, br_vector3* pRay_dir, br_scalar pT_near, br_scalar pT_far, void* pArg) {
+    gPick.current = pActor;
+    DRModelPick2D__finteray(pModel, pMaterial, pRay_pos, pRay_dir, pT_near, pT_far, PickPolyCallback, pArg);
+    return 0;
+}
+
+// pFrom + t * pDir, t in 0..1; returns t (> 1 if nothing) and the actor
+static br_scalar PickTrack(br_vector3* pFrom, br_vector3* pDir, br_actor** pActor) {
+    gPick.t = 100.f;
+    gPick.actor = NULL;
+    DRSceneRayPick2D(gTrack_actor, pFrom, pDir, PickActorCallback);
+    *pActor = gPick.actor;
+    return gPick.t;
+}
+
+// Knockable props are "&NN..." actors in the track
+static br_actor* PropOf(br_actor* pActor) {
+    for (; pActor != NULL && pActor != gTrack_actor; pActor = pActor->parent) {
+        if (pActor->identifier != NULL && pActor->identifier[0] == '&' && pActor->identifier[1] >= '0' && pActor->identifier[1] <= '9') {
+            return pActor;
+        }
+    }
+    return NULL;
+}
+
+static br_uintptr_t CollectPropsCB(br_actor* pActor, void* pArg) {
+    if (gDestruct.prop_count < PROP_COUNT && PropOf(pActor) == pActor) {
+        gDestruct.props[gDestruct.prop_count].actor = pActor;
+        gDestruct.props[gDestruct.prop_count].hits = 0;
+        gDestruct.prop_count++;
+        return 0;
+    }
+    BrActorEnum(pActor, CollectPropsCB, pArg);
+    return 0;
+}
+
+static tProp* FindPropEntry(br_actor* pActor) {
+    int i;
+
+    for (i = 0; i < gDestruct.prop_count; i++) {
+        if (gDestruct.props[i].actor == pActor) {
+            return &gDestruct.props[i];
+        }
+    }
+    return NULL;
+}
