+#ifndef _DESTRUCT_H_
+#define _DESTRUCT_H_
+
+// Bullet impacts, shootable street furniture and crash debris
+
+#include "dr_types.h"
+
+void MungeDestruct(tU32 pFrame_period);
+
+// Bullet from pFrom towards pTo (and a little past it) hitting a wall, the road or a prop
+void DestructBulletImpact(br_vector3* pFrom, br_vector3* pTo);
+
+// Called from CrashNoise(), during physics
+void DestructQueueCrash(br_vector3* pPosition, br_vector3* pForce, int pMaterial);
+
+// Nearest standing prop within pRange of pFrom that a bullet would hit; its centre in pPoint
+br_actor* DestructFindProp(br_vector3* pFrom, br_scalar pRange, br_vector3* pPoint);
+
+// Whether a prop from DestructFindProp() is still standing; its centre in pPoint
+int DestructPropStanding(br_actor* pProp, br_vector3* pPoint);
+
+// Nearest hit on the track (props included) along pFrom + t * pDir, t in 0..1: returns t (> 1 if none) and the
+// normal facing pFrom
+br_scalar DestructRayPick(br_vector3* pFrom, br_vector3* pDir, br_vector3* pNormal);
+
+// Explosion at pPos on a surface facing pNormal; knocks over props within pRadius
+void DestructExplosion(br_vector3* pPos, br_vector3* pNormal, br_scalar pRadius);
+
+// Nearest standing prop to pFrom at any range; its centre in pPoint
+br_actor* DestructNearestProp(br_vector3* pFrom, br_vector3* pPoint);
+
+void DestructDumpState(void);
+
+#endif
