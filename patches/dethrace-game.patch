+static void DamageCar(tCar_spec* pVictim, br_vector3* pHit) {
+    // The systems that wreck a car when they reach 99
+    static const int units[] = { eDamage_engine, eDamage_transmission, eDamage_driver };
+    int was_knackered;
+    br_vector3 push;
+
+    was_knackered = pVictim->knackered;
+    if (PercentageChance(MINIGUN_CAR_DAMAGE_CHANCE)) {
+        // DamageUnit2() won't take a system to 99 with less than 10 points
+        DamageUnit2(pVictim, units[IRandomBetween(0, COUNT_OF(units) - 1)], 10);
+    }
+    BrVector3Scale(&push, &gMinigun.aim_dir, 0.03f);
+    BrVector3Accumulate(&pVictim->v, &push);
+    if (PercentageChance(30)) {
+        DRS3StartSound3D(gCar_outlet, IRandomBetween(5010, 5012), &pVictim->pos, &gZero_v__car, 1, 160, 0x10000, 0x10000);
+    }
+    gMinigun.stats.cars_wasted += WeaponCarHit(pVictim, gMinigun.car, was_knackered);
+}
+
+// Same wasted bonus as for ramming
+int WeaponCarHit(tCar_spec* pVictim, tCar_spec* pCulprit, int pWas_knackered) {
+    int credits;
+
+    SetKnackeredFlag(pVictim);
+    pVictim->last_hit_by = pCulprit;
+    pVictim->time_last_hit = GetTotalTime();
+    if (!pVictim->knackered || pWas_knackered || pCulprit != &gProgram_state.current_car) {
+        return 0;
+    }
+    PratcamEvent(kPratcam_opponent_wasted);
+    DoFancyHeadup(kFancyHeadupYouWastedEm);
+    credits = 100 * (int)((sqr(0.7 / pVictim->car_model_actors[pVictim->principal_car_actor].crush_data.softness_factor) * gWasted_creds[gProgram_state.skill_level] + 50.0f) / 100.0);
+    AwardTime(gWasted_time[gProgram_state.skill_level]);
+    EarnCredits(credits);
+    return 1;
+}
