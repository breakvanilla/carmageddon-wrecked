diff --git a/src/DETHRACE/common/water.c b/src/DETHRACE/common/water.c
new file mode 100644
index 0000000..4e82e7c
--- /dev/null
+++ b/src/DETHRACE/common/water.c
@@ -0,0 +1,905 @@
+#include "water.h"
+#include "brender.h"
+#include "car.h"
+#include "constants.h"
+#include "formats.h"
+#include "globvars.h"
+#include "globvrbm.h"
+#include "globvrkm.h"
+#include "graphics.h"
+#include "macros.h"
+#include "mainloop.h"
+#include "modmesh.h"
+#include "opponent.h"
+#include "pedestrn.h"
+#include "utility.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+/*
+ * Water. The glrend driver's water.c draws the surface; this module finds the track's water, tells the renderer which
+ * materials it is, and passes it ripples, time and sun each frame. A car floats on its four corners by how deep each
+ * is (waves included), and fills with water and sinks, faster once wrecked.
+ */
+
+#define WATER_CELL 1.f               // world units, grid cell for the water's faces
+#define RIPPLE_COUNT 32
+#define RIPPLE_LIFE 3500             // ms
+#define PARTICLE_COUNT 320
+#define SPRAY_LEVELS 6
+#define CAR_STATE_COUNT 48
+#define WAKE_PERIOD 140              // ms between wake ripples of a moving car
+#define BUBBLE_PERIOD 70             // ms between bubbles from a car under water
+#define BUOYANCY 2.2f                // a car floats about 1 / BUOYANCY under
+#define FLOOD_TIME 3.f               // seconds to fill with water (it goes under about two thirds of the way)
+#define FLOOD_TIME_WRECKED 1.5f
+
+typedef struct tWater_face {
+    br_vector3 p[3];
+} tWater_face;
+
+typedef enum tParticle_type {
+    eParticle_spray,
+    eParticle_drop,
+    eParticle_bubble
+} tParticle_type;
+
+typedef struct tParticle {
+    br_actor* actor;
+    br_vector3 pos;
+    br_vector3 vel;
+    br_scalar size;
+    br_scalar grow;
+    br_scalar spin;
+    tU32 birth;
+    tU32 life;
+    tParticle_type type;
+    int active;
+} tParticle;
+
+typedef struct tCar_water {
+    tCar_spec* car;
+    br_scalar submerged; // 0 to 1, from the last physics step
+    br_scalar flooded;   // 0 to 1
+    br_scalar surface;
+    int was_in;
+    tU32 last_wake;
+    tU32 last_bubble;
+    tU32 last_spray;
+} tCar_water;
+
+static struct {
+    tU32 race; // gRace_serial of the race the state belongs to
+    tWater_face* faces;
+    int face_count;
+    br_scalar min_x, min_z;
+    int nx, nz;
+    int* cell_start; // faces in each cell: cell_faces[cell_start[c] .. cell_start[c + 1]]
+    int* cell_faces;
+    br_material* materials[16];
+    int material_count;
+    tU32 start_time;
+    br_scalar time; // seconds since the race started
+    float ripples[RIPPLE_COUNT][4];
+    int next_ripple;
+    br_actor* root;
+    br_model* sprite_model;
+    br_material* spray[SPRAY_LEVELS];
+    br_material* drop;
+    br_material* bubble;
+    tParticle particles[PARTICLE_COUNT];
+    int next_particle;
+    tCar_water cars[CAR_STATE_COUNT];
+    int camera_under;
+    br_scalar camera_surface;
+    struct {
+        int splashes;
+        int wake_ripples;
+        int bubbles;
+    } stats;
+} gWater;
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Finding the water
+
+static int IsProp(br_actor* pActor) {
+    for (; pActor != NULL && pActor != gTrack_actor; pActor = pActor->parent) {
+        if (pActor->identifier != NULL && pActor->identifier[0] == '&' && pActor->identifier[1] >= '0' && pActor->identifier[1] <= '9') {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+// The game's water ("!" materials) and any material with a water texture (the open sea drawn as scenery)
+static int IsWaterMaterial(br_material* pMaterial) {
+    const char* map;
+
+    if (pMaterial == NULL) {
+        return 0;
+    }
+    if (pMaterial->identifier != NULL && pMaterial->identifier[0] == '!') {
+        return 1;
+    }
+    map = pMaterial->colour_map != NULL ? pMaterial->colour_map->identifier : NULL;
+    return map != NULL && strncasecmp(map, "water", 5) == 0;
+}
+
+typedef struct tScan {
+    int count;
+    int max;
+    br_material* materials[64];
+    br_scalar flat_area[64];
+    br_scalar area[64];
+    int material_count;
+} tScan;
+
+static br_uintptr_t ScanCB(br_actor* pActor, void* pArg) {
+    tScan* scan = pArg;
+    struct v11model* v11;
+    struct v11group* g;
+    br_matrix34 m;
+    br_vector3 p[3], e1, e2, n;
+    br_material* mat;
+    br_scalar a;
+    int gi, f, k, mi;
+
+    if (pActor->type == BR_ACTOR_MODEL && pActor->model != NULL && pActor->model->prepared != NULL && !IsProp(pActor)) {
+        v11 = pActor->model->prepared;
+        BrActorToActorMatrix34(&m, pActor, gUniverse_actor);
+        for (gi = 0; gi < v11->ngroups; gi++) {
+            g = &v11->groups[gi];
+            mat = g->user;
+            if (!IsWaterMaterial(mat)) {
+                continue;
+            }
+            for (mi = 0; mi < scan->material_count && scan->materials[mi] != mat; mi++) {
+            }
+            if (mi == scan->material_count && mi < COUNT_OF(scan->materials)) {
+                scan->materials[mi] = mat;
+                scan->flat_area[mi] = scan->area[mi] = 0.f;
+                scan->material_count++;
+            }
+            for (f = 0; f < g->nfaces; f++) {
+                for (k = 0; k < 3; k++) {
+                    BrVector3Add(&e1, &g->position[g->vertex_numbers[f].v[k]], &pActor->model->pivot);
+                    BrMatrix34ApplyP(&p[k], &e1, &m);
+                }
+                BrVector3Sub(&e1, &p[1], &p[0]);
+                BrVector3Sub(&e2, &p[2], &p[0]);
+                BrVector3Cross(&n, &e1, &e2);
+                a = BrVector3Length(&n);
+                if (a < 1e-10f) {
+                    continue;
+                }
+                if (mi < COUNT_OF(scan->materials)) {
+                    scan->area[mi] += a;
+                }
+                if (fabsf(n.v[1]) / a < 0.9f) {
+                    continue;
+                }
+                if (mi < COUNT_OF(scan->materials)) {
+                    scan->flat_area[mi] += a;
+                }
+                if (gWater.faces != NULL && scan->count < scan->max) {
+                    memcpy(gWater.faces[scan->count].p, p, sizeof(p));
+                }
+                scan->count++;
+            }
+        }
+    }
+    BrActorEnum(pActor, ScanCB, pArg);
+    return 0;
+}
+
+static void FaceBounds(tWater_face* pFace, br_scalar* pMin_x, br_scalar* pMax_x, br_scalar* pMin_z, br_scalar* pMax_z) {
+    *pMin_x = MIN(pFace->p[0].v[0], MIN(pFace->p[1].v[0], pFace->p[2].v[0]));
+    *pMax_x = MAX(pFace->p[0].v[0], MAX(pFace->p[1].v[0], pFace->p[2].v[0]));
+    *pMin_z = MIN(pFace->p[0].v[2], MIN(pFace->p[1].v[2], pFace->p[2].v[2]));
+    *pMax_z = MAX(pFace->p[0].v[2], MAX(pFace->p[1].v[2], pFace->p[2].v[2]));
+}
+
+static void FindWater(void) {
+    tScan scan;
+    br_scalar x0, x1, z0, z1, max_x, max_z;
+    int i, x, z, c, total;
+    int* fill;
+
+    free(gWater.faces);
+    free(gWater.cell_start);
+    free(gWater.cell_faces);
+    gWater.faces = NULL;
+    gWater.cell_start = gWater.cell_faces = NULL;
+    gWater.face_count = 0;
+    gWater.material_count = 0;
+#ifdef DETHRACE_3DFX_PATCH
+    GLREND_ClearWaterMaterials();
+#endif
+    // CARMA_WATER=0 leaves water as the game had it
+    if (gTrack_actor == NULL || (getenv("CARMA_WATER") != NULL && atoi(getenv("CARMA_WATER")) == 0)) {
+        return;
+    }
+    memset(&scan, 0, sizeof(scan));
+    ScanCB(gTrack_actor, &scan);
+    if (scan.count == 0) {
+        return;
+    }
+    gWater.faces = malloc(scan.count * sizeof(tWater_face));
+    scan.max = scan.count;
+    scan.count = 0;
+    scan.material_count = 0;
+    ScanCB(gTrack_actor, &scan);
+    gWater.face_count = scan.count;
+
+    // Materials mostly used flat are water; others (rocks and walls under the sea) are left alone
+    for (i = 0; i < scan.material_count; i++) {
+        if (scan.area[i] > 0.f && scan.flat_area[i] / scan.area[i] > 0.7f && gWater.material_count < COUNT_OF(gWater.materials)) {
+            gWater.materials[gWater.material_count++] = scan.materials[i];
+#ifdef DETHRACE_3DFX_PATCH
+            GLREND_SetWaterMaterial(scan.materials[i]);
+#endif
+        }
+    }
+
+    gWater.min_x = gWater.min_z = 1e30f;
+    max_x = max_z = -1e30f;
+    for (i = 0; i < gWater.face_count; i++) {
+        FaceBounds(&gWater.faces[i], &x0, &x1, &z0, &z1);
+        gWater.min_x = MIN(gWater.min_x, x0);
+        gWater.min_z = MIN(gWater.min_z, z0);
+        max_x = MAX(max_x, x1);
+        max_z = MAX(max_z, z1);
+    }
+    gWater.nx = MIN(1024, (int)((max_x - gWater.min_x) / WATER_CELL) + 1);
+    gWater.nz = MIN(1024, (int)((max_z - gWater.min_z) / WATER_CELL) + 1);
+    gWater.cell_start = calloc(gWater.nx * gWater.nz + 1, sizeof(int));
+    fill = calloc(gWater.nx * gWater.nz, sizeof(int));
+    for (total = 0, c = 0; c < 2; c++) {
+        for (i = 0; i < gWater.face_count; i++) {
+            FaceBounds(&gWater.faces[i], &x0, &x1, &z0, &z1);
+            for (x = (int)((x0 - gWater.min_x) / WATER_CELL); x <= (int)((x1 - gWater.min_x) / WATER_CELL) && x < gWater.nx; x++) {
+                for (z = (int)((z0 - gWater.min_z) / WATER_CELL); z <= (int)((z1 - gWater.min_z) / WATER_CELL) && z < gWater.nz; z++) {
+                    if (c == 0) {
+                        gWater.cell_start[z * gWater.nx + x + 1]++;
+                        total++;
+                    } else {
+                        gWater.cell_faces[gWater.cell_start[z * gWater.nx + x] + fill[z * gWater.nx + x]++] = i;
+                    }
+                }
+            }
+        }
+        if (c == 0) {
+            for (i = 0; i < gWater.nx * gWater.nz; i++) {
+                gWater.cell_start[i + 1] += gWater.cell_start[i];
+            }
+            gWater.cell_faces = malloc(MAX(1, total) * sizeof(int));
+        }
+    }
+    free(fill);
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// The surface
+
+// Biggest waves from water.frag.glsl, so floating things ride the waves that are seen
+static br_scalar WaveHeight(br_scalar pX, br_scalar pZ) {
+    static const float waves[2][4] = { { 0.8f, 0.6f, 1.9f, 0.010f }, { -0.45f, 0.89f, 1.1f, 0.007f } };
+    br_scalar h, k, w, len;
+    int i;
+
+    h = 0.f;
+    for (i = 0; i < 2; i++) {
+        len = sqrtf(waves[i][0] * waves[i][0] + waves[i][1] * waves[i][1]);
+        k = 6.2831853f / waves[i][2];
+        w = sqrtf(9.8f / 6.9f * k);
+        h += waves[i][3] * sinf((waves[i][0] * pX + waves[i][1] * pZ) / len * k - w * gWater.time);
+    }
+    return h;
+}
+
+// Without waves: the water face above or below nearest in height
+static int FlatSurfaceAt(br_vector3* pPos, br_scalar* pHeight) {
+    tWater_face* f;
+    br_scalar d, u, v, w, y, best;
+    int x, z, c, i, found;
+
+    if (gWater.face_count == 0) {
+        return 0;
+    }
+    x = (int)floorf((pPos->v[0] - gWater.min_x) / WATER_CELL);
+    z = (int)floorf((pPos->v[2] - gWater.min_z) / WATER_CELL);
+    if (x < 0 || z < 0 || x >= gWater.nx || z >= gWater.nz) {
+        return 0;
+    }
+    c = z * gWater.nx + x;
+    found = 0;
+    best = 1e30f;
+    for (i = gWater.cell_start[c]; i < gWater.cell_start[c + 1]; i++) {
+        f = &gWater.faces[gWater.cell_faces[i]];
+        d = (f->p[1].v[2] - f->p[2].v[2]) * (f->p[0].v[0] - f->p[2].v[0]) + (f->p[2].v[0] - f->p[1].v[0]) * (f->p[0].v[2] - f->p[2].v[2]);
+        if (fabsf(d) < 1e-10f) {
+            continue;
+        }
+        u = ((f->p[1].v[2] - f->p[2].v[2]) * (pPos->v[0] - f->p[2].v[0]) + (f->p[2].v[0] - f->p[1].v[0]) * (pPos->v[2] - f->p[2].v[2])) / d;
+        v = ((f->p[2].v[2] - f->p[0].v[2]) * (pPos->v[0] - f->p[2].v[0]) + (f->p[0].v[0] - f->p[2].v[0]) * (pPos->v[2] - f->p[2].v[2])) / d;
+        w = 1.f - u - v;
+        if (u < -1e-4f || v < -1e-4f || w < -1e-4f) {
+            continue;
+        }
+        y = u * f->p[0].v[1] + v * f->p[1].v[1] + w * f->p[2].v[1];
+        if (fabsf(y - pPos->v[1]) < best) {
+            best = fabsf(y - pPos->v[1]);
+            *pHeight = y;
+            found = 1;
+        }
+    }
+    return found;
+}
+
+int WaterSurfaceAt(br_vector3* pPos, br_scalar* pHeight) {
+    if (!FlatSurfaceAt(pPos, pHeight)) {
+        return 0;
+    }
+    *pHeight += WaveHeight(pPos->v[0], pPos->v[2]);
+    return 1;
+}
+
+static void AddRipple(br_vector3* pPos, br_scalar pStrength) {
+    float* r;
+
+    r = gWater.ripples[gWater.next_ripple];
+    gWater.next_ripple = (gWater.next_ripple + 1) % RIPPLE_COUNT;
+    r[0] = pPos->v[0];
+    r[1] = pPos->v[2];
+    r[2] = gWater.time;
+    r[3] = pStrength;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Floating
+
+static tCar_water* CarState(tCar_spec* pCar) {
+    int i, free_slot;
+
+    free_slot = -1;
+    for (i = 0; i < CAR_STATE_COUNT; i++) {
+        if (gWater.cars[i].car == pCar) {
+            return &gWater.cars[i];
+        }
+        if (free_slot < 0 && gWater.cars[i].car == NULL) {
+            free_slot = i;
+        }
+    }
+    if (free_slot < 0) {
+        return NULL;
+    }
+    memset(&gWater.cars[free_slot], 0, sizeof(tCar_water));
+    gWater.cars[free_slot].car = pCar;
+    return &gWater.cars[free_slot];
+}
+
+int WaterCarBuoyancy(tCar_spec* pCar, br_matrix34* pMat, br_vector3* pForce, br_vector3* pTorque, br_scalar dt) {
+    static const br_scalar corners[4][2] = { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } };
+    tCar_water* state;
+    br_bounds* b;
+    br_vector3 centre, corner, world, up, fc, r, tq;
+    br_scalar flat, surface, depth, height, s, total, lift, damp;
+    int i;
+
+    if (gWater.face_count == 0 || pCar->car_master_actor == NULL) {
+        return 0;
+    }
+    BrVector3InvScale(&centre, (br_vector3*)pMat->m[3], WORLD_SCALE);
+    if (!FlatSurfaceAt(&centre, &flat)) {
+        // Out of the water, or put back after sinking: dry, so it floats again next time
+        for (i = 0; i < CAR_STATE_COUNT; i++) {
+            if (gWater.cars[i].car == pCar) {
+                gWater.cars[i].submerged = 0.f;
+                gWater.cars[i].flooded = 0.f;
+            }
+        }
+        return 0;
+    }
+    state = CarState(pCar);
+    b = &pCar->bounds[0];
+    height = MAX(0.01f, b->max.v[1] - b->min.v[1]);
+    // Up, in car space
+    BrVector3Set(&up, pMat->m[0][1], pMat->m[1][1], pMat->m[2][1]);
+    lift = pCar->M * GRAVITY * gGravity_multiplier * BUOYANCY * (1.f - 0.8f * (state != NULL ? state->flooded : 0.f)) / 4.f;
+    total = 0.f;
+    for (i = 0; i < 4; i++) {
+        // A column up from each bottom corner, held up by how much of it is under
+        BrVector3Set(&corner, corners[i][0] ? b->max.v[0] : b->min.v[0], b->min.v[1], corners[i][1] ? b->max.v[2] : b->min.v[2]);
+        BrVector3Scale(&r, &corner, WORLD_SCALE);
+        BrMatrix34ApplyP(&world, &r, pMat);
+        BrVector3InvScale(&world, &world, WORLD_SCALE);
+        surface = flat + WaveHeight(world.v[0], world.v[2]);
+        depth = surface - world.v[1];
+        s = MAX(0.f, MIN(1.f, depth / height));
+        if (s <= 0.f) {
+            continue;
+        }
+        total += s;
+        damp = -pCar->M * 2.5f * pCar->v.v[1] * s / 4.f;
+        BrVector3Scale(&fc, &up, lift * s + damp);
+        BrVector3Accumulate(pForce, &fc);
+        corner.v[1] += s * height * 0.5f;
+        BrVector3Scale(&r, &corner, WORLD_SCALE);
+        BrVector3Sub(&r, &r, &pCar->cmpos);
+        BrVector3Cross(&tq, &r, &fc);
+        BrVector3Accumulate(pTorque, &tq);
+    }
+    total /= 4.f;
+    if (state != NULL) {
+        state->submerged = total;
+        state->surface = flat;
+        if (total > 0.2f) {
+            state->flooded = MIN(1.f, state->flooded + dt / (pCar->knackered ? FLOOD_TIME_WRECKED : FLOOD_TIME));
+        } else if (total < 0.05f) {
+            state->flooded = MAX(0.f, state->flooded - dt / 20.f);
+        }
+    }
+    if (total <= 0.f) {
+        return 0;
+    }
+    // Afloat, the wheels paddle and steer it
+    if (total > 0.25f) {
+        int acc = pCar->keys.acc || pCar->joystick.acc > 0;
+        int dec = pCar->keys.dec || pCar->joystick.dec > 0;
+        int steer = (pCar->keys.left ? 1 : 0) - (pCar->keys.right ? 1 : 0);
+        pForce->v[2] -= pCar->M * 3.f * MIN(1.f, total * 2.f) * ((acc ? 1.f : 0.f) - (dec ? 0.6f : 0.f));
+        pTorque->v[1] += pCar->I.v[1] * 1.5f * steer * MIN(1.f, total * 2.f);
+    }
+    pTorque->v[0] -= pCar->I.v[0] * pCar->omega.v[0] * 2.f * total;
+    pTorque->v[1] -= pCar->I.v[1] * pCar->omega.v[1] * 1.f * total;
+    pTorque->v[2] -= pCar->I.v[2] * pCar->omega.v[2] * 2.f * total;
+    return 1;
+}
+
+int WaterCarSunk(tCar_spec* pCar) {
+    int i;
+
+    for (i = 0; i < CAR_STATE_COUNT; i++) {
+        if (gWater.cars[i].car == pCar) {
+            return gWater.cars[i].flooded > 0.9f;
+        }
+    }
+    return gWater.face_count == 0; // no water of ours: the game's behaviour
+}
+
+int WaterCarAfloat(tCar_spec* pCar) {
+    int i;
+
+    for (i = 0; i < CAR_STATE_COUNT; i++) {
+        if (gWater.cars[i].car == pCar) {
+            return gWater.cars[i].submerged > 0.02f && gWater.cars[i].flooded <= 0.9f;
+        }
+    }
+    return 0;
+}
+
+void WaterNonCarBuoyancy(tCollision_info* pThing, br_scalar dt) {
+    br_vector3 centre;
+    br_scalar surface, height, s;
+
+    if (gWater.face_count == 0 || pThing->car_master_actor == NULL) {
+        return;
+    }
+    BrVector3InvScale(&centre, (br_vector3*)pThing->car_master_actor->t.t.mat.m[3], WORLD_SCALE);
+    if (!WaterSurfaceAt(&centre, &surface)) {
+        return;
+    }
+    height = MAX(0.01f, pThing->bounds[0].max.v[1] - pThing->bounds[0].min.v[1]);
+    s = MAX(0.f, MIN(1.f, (surface - (centre.v[1] + pThing->bounds[0].min.v[1])) / height));
+    if (s <= 0.f) {
+        return;
+    }
+    pThing->v.v[1] += dt * 10.f * 1.8f * s;
+    BrVector3Scale(&pThing->v, &pThing->v, MAX(0.f, 1.f - dt * 2.f * s));
+    BrVector3Scale(&pThing->omega, &pThing->omega, MAX(0.f, 1.f - dt * 2.f * s));
+}
