+static int gLight_candidate_count;
+
+static void AddLightCandidate(br_vector3* pPos, br_scalar pRadius, br_scalar pR, br_scalar pG, br_scalar pB, br_vector3* pSpot_dir, br_scalar pOuter_cos, br_scalar pInner_cos, br_vector3* pCamera_pos) {
+    tLight_candidate* c;
+
+    if (gLight_candidate_count >= COUNT_OF(gLight_candidates)) {
+        return;
+    }
+    c = &gLight_candidates[gLight_candidate_count++];
+    memset(c, 0, sizeof(*c));
+    c->light.position = *pPos;
+    c->light.radius = pRadius;
+    BrVector3Set(&c->light.colour, pR, pG, pB);
+    if (pSpot_dir != NULL) {
+        c->light.direction = *pSpot_dir;
+        c->light.spot_outer_cos = pOuter_cos;
+        c->light.spot_inner_cos = pInner_cos;
+    }
+    // Nearest lights first, measured from the edge of their reach
+    c->priority = sqrtf(Vector3DistanceSquared(pPos, pCamera_pos)) - pRadius;
+}
+
+static int CompareLightCandidates(const void* pA, const void* pB) {
+    br_scalar a = ((const tLight_candidate*)pA)->priority;
+    br_scalar b = ((const tLight_candidate*)pB)->priority;
+
+    return a < b ? -1 : a > b;
+}
+
+static float LightsSetting(void) {
+    static float setting = -1.f;
+    const char* value;
+
+    if (setting < 0.f) {
+        value = getenv("CARMA_LIGHTS");
+        setting = value != NULL ? atof(value) : 1.f;
+        if (setting < 0.f) {
+            setting = 0.f;
+        }
+    }
+    return setting;
+}
+
+static int HeadlightsOn(void) {
+    static int setting = -1; // 0 off, 1 on, 2 only on dark tracks
+    static int key_was_down;
+    const char* value;
+    int key_down;
+
+    if (setting < 0) {
+        value = getenv("CARMA_HEADLIGHTS");
+        setting = value == NULL ? 0 : strcmp(value, "on") == 0 ? 1 : strcmp(value, "auto") == 0 ? 2 : 0;
+    }
+    key_down = PDKeyDown(KEY_N);
+    if (key_down && !key_was_down && !gEntering_message) {
+        setting = setting == 1 ? 0 : 1;
+        NewTextHeadupSlot(eHeadupSlot_misc, 0, 1000, -kFont_MEDIUMHD, setting ? "HEADLIGHTS ON" : "HEADLIGHTS OFF");
+    }
+    key_was_down = key_down;
+    if (setting == 2) {
+        return gProgram_state.current_depth_effect.type == eDepth_effect_darkness;
+    }
+    return setting;
+}
+
+// pX, pY, pZ run from -1 to 1 across the principal model's bounding box
+static void CarModelPoint(tCar_spec* pCar, br_scalar pX, br_scalar pY, br_scalar pZ, br_vector3* pOut) {
+    br_actor* actor;
+    br_bounds* b;
+    br_matrix34 model_to_world;
+    br_vector3 p;
+
+    actor = pCar->car_model_actors[pCar->principal_car_actor].actor;
+    b = &actor->model->bounds;
+    BrVector3Set(&p,
+        (b->min.v[0] + b->max.v[0]) / 2.f + pX * (b->max.v[0] - b->min.v[0]) / 2.f,
+        (b->min.v[1] + b->max.v[1]) / 2.f + pY * (b->max.v[1] - b->min.v[1]) / 2.f,
+        (b->min.v[2] + b->max.v[2]) / 2.f + pZ * (b->max.v[2] - b->min.v[2]) / 2.f);
+    BrMatrix34Mul(&model_to_world, &actor->t.t.mat, &pCar->car_master_actor->t.t.mat);
+    BrMatrix34ApplyP(pOut, &p, &model_to_world);
+}
+
+static int CarCanHaveLights(tCar_spec* pCar) {
+    return pCar != NULL && pCar->car_master_actor != NULL && pCar->car_model_actors[pCar->principal_car_actor].actor != NULL
+        && pCar->car_model_actors[pCar->principal_car_actor].actor->model != NULL;
+}
+
+static void AddHeadlights(tCar_spec* pCar, br_scalar pIntensity, br_vector3* pCamera_pos) {
+    br_vector3 lamp;
+    br_vector3 dir;
+    br_matrix34* mat;
+    int side;
+
+    if (!CarCanHaveLights(pCar) || pCar->knackered) {
+        return;
+    }
+    mat = &pCar->car_master_actor->t.t.mat;
+    // Cars face down -z; aim the beams slightly at the road
+    BrVector3Set(&dir, -mat->m[2][0] - 0.12f * mat->m[1][0], -mat->m[2][1] - 0.12f * mat->m[1][1], -mat->m[2][2] - 0.12f * mat->m[1][2]);
+    BrVector3Normalise(&dir, &dir);
+    for (side = -1; side <= 1; side += 2) {
+        CarModelPoint(pCar, side * 0.6f, -0.2f, -1.f, &lamp);
+        AddLightCandidate(&lamp, 6.f, 1.0f * pIntensity, 0.93f * pIntensity, 0.8f * pIntensity, &dir, 0.82f, 0.95f, pCamera_pos);
+    }
+}
+
+void SetDynamicLights(br_matrix34* pCamera_to_world) {
+    glrend_light lights[GLREND_MAX_LIGHTS];
+    br_vector3 camera_pos;
+    br_vector3 pos;
+    br_vector3 sum;
+    br_scalar strength;
+    br_scalar flicker;
+    br_scalar age;
+    br_scalar flash;
+    tU32 now;
+    tCar_spec* car;
+    int count;
+    int i;
+
+    strength = LightsSetting();
+    gLight_candidate_count = 0;
+    if (strength <= 0.f || !gProgram_state.racing) {
+        GLREND_SetLights(lights, 0);
+        return;
+    }
+    now = GetTotalTime();
+    BrVector3Copy(&camera_pos, (br_vector3*)pCamera_to_world->m[3]);
+
+    // Burning cars, with a flash when a wreck goes up
+    for (i = 0; i < MAX_SMOKE_COLUMNS; i++) {
+        if (!TEST_BIT(gColumn_flags, i) || gSmoke_column[i].colour != 0) {
+            continue;
+        }
+        flicker = 0.75f + 0.15f * sinf(now * 0.023f + i * 1.7f) + 0.1f * sinf(now * 0.061f + i * 3.1f);
+        age = (now - gColumn_start_time[i]) / 1000.f;
+        flash = gColumn_exploded[i] ? 5.f * expf(-age * 4.f) : 0.f;
+        AddLightCandidate(&gSmoke_column[i].pos, 2.2f + flash * 0.5f,
+            (1.6f * flicker + flash) * strength, (0.75f * flicker + flash * 0.8f) * strength, (0.25f * flicker + flash * 0.5f) * strength,
+            NULL, 0.f, 0.f, &camera_pos);
+    }
+
+    // Sparks: one light at their centre, brighter the more there are
+    BrVector3Set(&sum, 0.f, 0.f, 0.f);
+    count = 0;
+    for (i = 0; i < COUNT_OF(gSparks); i++) {
+        if (!TEST_BIT(gSpark_flags, i)) {
+            continue;
+        }
+        if (gSparks[i].car != NULL) {
+            BrMatrix34ApplyP(&pos, &gSparks[i].pos, &gSparks[i].car->car_master_actor->t.t.mat);
+        } else {
+            BrVector3Copy(&pos, &gSparks[i].pos);
+        }
+        BrVector3Accumulate(&sum, &pos);
+        count++;
+    }
+    if (count > 0) {
+        BrVector3InvScale(&sum, &sum, (br_scalar)count);
+        flicker = (0.6f + 0.4f * (rand() / (float)RAND_MAX)) * MIN(0.5f + count * 0.15f, 2.f) * strength;
+        AddLightCandidate(&sum, 1.2f, 1.f * flicker, 0.8f * flicker, 0.45f * flicker, NULL, 0.f, 0.f, &camera_pos);
+    }
+
+    if (MinigunMuzzleFlash(&pos, &flash)) {
+        AddLightCandidate(&pos, 2.5f, 1.f * flash * strength, 0.8f * flash * strength, 0.4f * flash * strength, NULL, 0.f, 0.f, &camera_pos);
+    }
+
+    // Rocket exhaust and explosions
+    for (i = 0; RocketLight(i, &pos, &flash, &sum); i++) {
+        AddLightCandidate(&pos, flash, sum.v[0] * strength, sum.v[1] * strength, sum.v[2] * strength, NULL, 0.f, 0.f, &camera_pos);
+    }
+
+    // Electro-Bastard Ray victims
+    for (i = 0; i < COUNT_OF(gProximity_rays); i++) {
+        if (gProximity_rays[i].start_time == 0 || gProximity_rays[i].ped == NULL) {
+            continue;
+        }
+        flicker = (0.5f + 0.5f * (rand() / (float)RAND_MAX)) * 1.6f * strength;
+        AddLightCandidate(&gProximity_rays[i].ped->pos, 1.5f, 0.55f * flicker, 0.8f * flicker, 1.f * flicker, NULL, 0.f, 0.f, &camera_pos);
+    }
+
+    // Police roof lights, alternating red and blue
+    for (i = 0; i < GetCarCount(eVehicle_rozzer); i++) {
+        car = GetCarSpec(eVehicle_rozzer, i);
+        if (!CarCanHaveLights(car) || car->knackered) {
+            continue;
+        }
+        CarModelPoint(car, 0.f, 1.f, 0.f, &pos);
+        if (((now + i * 170) / 250) % 2 == 0) {
+            AddLightCandidate(&pos, 2.f, 1.8f * strength, 0.1f * strength, 0.1f * strength, NULL, 0.f, 0.f, &camera_pos);
+        } else {
+            AddLightCandidate(&pos, 2.f, 0.15f * strength, 0.35f * strength, 2.f * strength, NULL, 0.f, 0.f, &camera_pos);
+        }
+    }
+
+    if (HeadlightsOn()) {
+        AddHeadlights(&gProgram_state.current_car, 1.4f * strength, &camera_pos);
+        for (i = 0; i < GetCarCount(eVehicle_opponent); i++) {
+            AddHeadlights(GetCarSpec(eVehicle_opponent, i), 1.f * strength, &camera_pos);
+        }
+        for (i = 0; i < GetCarCount(eVehicle_rozzer); i++) {
+            AddHeadlights(GetCarSpec(eVehicle_rozzer, i), 1.f * strength, &camera_pos);
+        }
+    }
+
+    qsort(gLight_candidates, gLight_candidate_count, sizeof(tLight_candidate), CompareLightCandidates);
+    count = MIN(gLight_candidate_count, GLREND_MAX_LIGHTS);
+    for (i = 0; i < count; i++) {
+        lights[i] = gLight_candidates[i].light;
+    }
+    GLREND_SetLights(lights, count);
+}
+#endif
