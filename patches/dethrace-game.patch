+int MinigunDoomPedestrian(tPedestrian_data* pPedestrian) {
+    tMinigun_ped_hits* hits;
+
+    if (gMinigun.car == NULL || !PedIsTarget(pPedestrian)) {
+        return 0;
+    }
+    hits = PedHits(pPedestrian);
+    hits->doomed = 1;
+    return 1;
+}
+
+static void AddTracer(br_vector3* pStart, br_vector3* pEnd) {
+    tMinigun_tracer* t;
+
+    t = &gMinigun.tracers[gMinigun.next_tracer];
+    gMinigun.next_tracer = (gMinigun.next_tracer + 1) % COUNT_OF(gMinigun.tracers);
+    t->start = *pStart;
+    t->end = *pEnd;
+    t->birth = GetTotalTime();
+}
+
+static void FireRound(void) {
+    tMinigun_ped_hits* hits;
+    br_vector3 target;
+    br_vector3 end;
+    br_vector3 v;
+    int hit;
+    int i;
+
+    TargetPoint(&target);
+    hit = PercentageChance(MINIGUN_HIT_CHANCE);
+    BrVector3Copy(&end, &target);
+    if (!hit) {
+        // A miss goes a little past the target, scattered
+        BrVector3Sub(&v, &target, &gMinigun.muzzle);
+        BrVector3Scale(&v, &v, 1.3f);
+        BrVector3Add(&end, &gMinigun.muzzle, &v);
+        end.v[0] += SRandomPosNeg(0.15f);
+        end.v[1] += SRandomPosNeg(0.08f);
+        end.v[2] += SRandomPosNeg(0.15f);
+    } else {
+        end.v[0] += SRandomPosNeg(0.03f);
+        end.v[1] += SRandomPosNeg(0.03f);
+        end.v[2] += SRandomPosNeg(0.03f);
+    }
+    AddTracer(&gMinigun.muzzle, &end);
+    gMinigun.last_round = GetTotalTime();
+    gMinigun.stats.rounds++;
+    gMinigun.stats.hits += hit;
+
+    if (!hit || gMinigun.target_type == eMinigun_target_prop) {
+        // Misses carry on into whatever is behind; props are hit like walls
+        DestructBulletImpact(&gMinigun.muzzle, &end);
+        return;
+    }
+    if (gMinigun.target_type == eMinigun_target_ped) {
+        hits = PedHits(gMinigun.target);
+        hits->hits++;
+        if (hits->hits >= MINIGUN_PED_HITS && !hits->doomed) {
+            hits->doomed = 1;
+            gMinigun.stats.peds_doomed++;
+        }
+    } else {
+        DamageCar(gMinigun.target, &end);
+        for (i = 0; i < 2; i++) {
+            BrVector3Set(&v, SRandomPosNeg(1.5f), FRandomBetween(0.3f, 1.5f), SRandomPosNeg(1.5f));
+            CreateSingleSpark(NULL, &end, &v);
+        }
+    }
+}
+
+static br_scalar TurnTowards(br_scalar pFrom, br_scalar pTo, br_scalar pMax_step) {
+    br_scalar d;
+
+    d = pTo - pFrom;
+    while (d > (float)M_PI) {
+        d -= 2.f * (float)M_PI;
+    }
+    while (d < -(float)M_PI) {
+        d += 2.f * (float)M_PI;
+    }
+    if (d > pMax_step) {
+        d = pMax_step;
+    } else if (d < -pMax_step) {
+        d = -pMax_step;
+    }
+    return pFrom + d;
+}
+
+static void AimAt(br_vector3* pTarget, br_scalar pStep, br_scalar* pError) {
+    br_matrix34 world;
+    br_matrix34 inverse;
+    br_vector3 local;
+    br_scalar want_yaw;
+    br_scalar want_pitch;
+
+    BrActorToActorMatrix34(&world, gMinigun.mount, gUniverse_actor);
+    BrMatrix34Inverse(&inverse, &world);
+    BrMatrix34ApplyP(&local, pTarget, &inverse);
+    local.v[1] -= 0.2f;
+    want_yaw = atan2f(-local.v[0], -local.v[2]);
+    want_pitch = atan2f(local.v[1], sqrtf(local.v[0] * local.v[0] + local.v[2] * local.v[2]));
+    want_pitch = MAX(-0.35f, MIN(0.8f, want_pitch));
+    gMinigun.yaw = TurnTowards(gMinigun.yaw, want_yaw, pStep);
+    gMinigun.pitch = TurnTowards(gMinigun.pitch, want_pitch, pStep);
+    *pError = fabsf(TurnTowards(gMinigun.yaw, want_yaw, 10.f) - gMinigun.yaw) + fabsf(gMinigun.pitch - want_pitch);
+}
+
+// Pedestrians and cars from the last race no longer exist
+static void ResetMinigunState(void) {
+    gMinigun.target_type = eMinigun_target_none;
+    gMinigun.target = NULL;
+    memset(gMinigun.ped_hits, 0, sizeof(gMinigun.ped_hits));
+    memset(gMinigun.tracers, 0, sizeof(gMinigun.tracers));
+    gMinigun.heat = 0.f;
+    gMinigun.overheated = 0;
+    gMinigun.spin_speed = 0.f;
+    gMinigun.last_round = 0;
+    gMinigun.race = gRace_serial;
+    gMinigun.on = 0;
+    gMinigun.deploy = 0.f;
+    gMinigun.deploy_dir = -1;
+}
+
+static br_scalar DeployPhase(br_scalar pStart, br_scalar pEnd) {
+    return MAX(0.f, MIN(1.f, (gMinigun.deploy - pStart) / (pEnd - pStart)));
+}
+
+static br_scalar SmoothStep(br_scalar pX) {
+    return pX * pX * (3.f - 2.f * pX);
+}
+
+// Rises a little past the top and settles back
+static br_scalar EaseOutBack(br_scalar pX) {
+    br_scalar c = 1.7f;
+
+    return 1.f + (c + 1.f) * (pX - 1.f) * (pX - 1.f) * (pX - 1.f) + c * (pX - 1.f) * (pX - 1.f);
+}
+
+// Debug log, printed when CARMA_MINIGUN_LOG is set
+static void MinigunLog(const char* pFormat, ...) {
+    static int enabled = -1;
+    va_list ap;
+
+    if (enabled < 0) {
+        enabled = getenv("CARMA_MINIGUN_LOG") != NULL;
+    }
+    if (!enabled) {
+        return;
+    }
+    va_start(ap, pFormat);
+    printf("[minigun] ");
+    vprintf(pFormat, ap);
+    printf("\n");
+    fflush(stdout);
+    va_end(ap);
+}
+
+static int Crossed(br_scalar pBefore, br_scalar pAfter, br_scalar pMark) {
+    return (pBefore < pMark && pAfter >= pMark) || (pBefore > pMark && pAfter <= pMark);
+}
+
+// Advances the deploy sequence and plays each stage's sound
+static void MungeDeploy(tU32 pFrame_period) {
+    br_scalar before;
+    br_scalar unfold;
+
+    before = gMinigun.deploy;
+    // pFrame_period is unsigned, so keep the direction signed
+    gMinigun.deploy = MAX(0.f, MIN(1.f, gMinigun.deploy + (float)gMinigun.deploy_dir * (float)pFrame_period / (float)MINIGUN_DEPLOY_TIME));
+    if (gMinigun.deploy != before) {
+        if ((before == 0.f && gMinigun.deploy > 0.f) || (Crossed(before, gMinigun.deploy, DEPLOY_DOORS_END) && gMinigun.deploy_dir < 0)) {
+            DRS3StartSound(gEffects_outlet, MINIGUN_HATCH_SOUND_ID);
+        }
+        if ((Crossed(before, gMinigun.deploy, DEPLOY_DOORS_END) && gMinigun.deploy_dir > 0)
+            || (Crossed(before, gMinigun.deploy, DEPLOY_RISE_END) && gMinigun.deploy_dir < 0)) {
+            DRS3StartSound(gEffects_outlet, MINIGUN_LIFT_SOUND_ID);
+        }
+        if ((Crossed(before, gMinigun.deploy, DEPLOY_RISE_END) && gMinigun.deploy_dir > 0) || (before == 1.f && gMinigun.deploy < 1.f)) {
+            DRS3StartSound(gEffects_outlet, MINIGUN_LOCK_SOUND_ID);
+        }
+        if (Crossed(before, gMinigun.deploy, DEPLOY_UNFOLD_END) && gMinigun.deploy_dir > 0) {
+            DRS3StartSound(gEffects_outlet, MINIGUN_SPIN_SOUND_ID);
+        }
+        if (gMinigun.deploy == 1.f) {
+            NewTextHeadupSlot(eHeadupSlot_misc, 0, 1500, -kFont_MEDIUMHD, "MINIGUN READY");
+        }
+        if ((int)(before * 10.f) != (int)(gMinigun.deploy * 10.f) || gMinigun.deploy == 0.f || gMinigun.deploy == 1.f) {
+            MinigunLog("deploy %.2f doors %.2f lift %.3f cockpit %d", gMinigun.deploy, SmoothStep(DeployPhase(0.f, DEPLOY_DOORS_END)),
+                MINIGUN_STOWED_LIFT * (1.f - EaseOutBack(DeployPhase(DEPLOY_DOORS_END, DEPLOY_RISE_END))), gProgram_state.cockpit_on);
+        }
+    }
+
+    gMinigun.door_open = SmoothStep(DeployPhase(0.f, DEPLOY_DOORS_END));
+    gMinigun.lift = MINIGUN_STOWED_LIFT * (1.f - EaseOutBack(DeployPhase(DEPLOY_DOORS_END, DEPLOY_RISE_END)));
+    unfold = SmoothStep(DeployPhase(DEPLOY_RISE_END, DEPLOY_UNFOLD_END));
+    gMinigun.pose_pitch = MINIGUN_FOLDED_PITCH * (1.f - unfold) + gMinigun.pitch * unfold;
+    // Test spin once unfolded
+    if (gMinigun.deploy > DEPLOY_UNFOLD_END && gMinigun.deploy < 1.f && gMinigun.deploy_dir > 0) {
+        gMinigun.spin_speed = MAX(gMinigun.spin_speed, 0.7f);
+    }
+}
+
+static void StopFiringSound(void) {
+    if (gMinigun.sound_tag != 0) {
+        DRS3StopSound(gMinigun.sound_tag);
+        gMinigun.sound_tag = 0;
+    }
+}
+
+void MungeMinigun(tU32 pFrame_period) {
+    tCar_spec* car;
+    br_vector3 target;
+    br_scalar error;
+    int can_fire;
+    int firing;
+    int key_down;
+    tU32 now;
+
+    car = &gProgram_state.current_car;
+    if (!gProgram_state.racing || gNet_mode != eNet_mode_none || car->car_master_actor == NULL
+        || car->car_model_actors[car->principal_car_actor].actor == NULL) {
+        if (gMinigun.built) {
+            gMinigun.mount->render_style = BR_RSTYLE_NONE;
+            gMinigun.hatch_root->render_style = BR_RSTYLE_NONE;
+        }
+        StopFiringSound();
+        ResetMinigunState();
+        return;
+    }
+    if (!gMinigun.built) {
+        BuildMinigun();
+    }
+    if (gMinigun.race != gRace_serial) {
+        ResetMinigunState();
+    }
+    now = GetTotalTime();
+
+    key_down = PDKeyDown(KEY_G);
+    if (key_down && !gMinigun.key_was_down && !gEntering_message && !gAction_replay_mode && !car->knackered) {
+        gMinigun.on = !gMinigun.on;
+        gMinigun.deploy_dir = gMinigun.on ? 1 : -1;
+        NewTextHeadupSlot(eHeadupSlot_misc, 0, 1500, -kFont_MEDIUMHD, gMinigun.on ? "MINIGUN DEPLOYING" : "MINIGUN STOWING");
+        MinigunLog("G pressed: %s, deploy %.2f, cockpit view %d, car width %.3f", gMinigun.on ? "deploying" : "stowing",
+            gMinigun.deploy, gProgram_state.cockpit_on && gCar_to_view == car, gMinigun.size);
+    }
+    gMinigun.key_was_down = key_down;
+    gMinigun.car = car;
+
+    if (!gAction_replay_mode) {
+        MungeDeploy(pFrame_period);
+    }
+    {
+        int hidden = gProgram_state.cockpit_on && gCar_to_view == car;
+        gMinigun.hatch_root->render_style = hidden ? BR_RSTYLE_NONE : BR_RSTYLE_FACES;
+        gMinigun.well_actor->render_style = gMinigun.door_open > 0.01f ? BR_RSTYLE_FACES : BR_RSTYLE_NONE;
+        gMinigun.mount->render_style = (!hidden && gMinigun.deploy > DEPLOY_DOORS_END * 0.9f) ? BR_RSTYLE_FACES : BR_RSTYLE_NONE;
+    }
+    if (gMinigun.deploy < 1.f || gAction_replay_mode) {
+        // Not ready: no firing, face forward and let the barrels run down
+        StopFiringSound();
+        gMinigun.target_type = eMinigun_target_none;
+        gMinigun.yaw = TurnTowards(gMinigun.yaw, 0.f, MINIGUN_TURN_SPEED * pFrame_period / 1000.f);
+        gMinigun.pitch = TurnTowards(gMinigun.pitch, 0.f, MINIGUN_TURN_SPEED * pFrame_period / 1000.f);
+        gMinigun.spin_speed = MAX(0.f, gMinigun.spin_speed - pFrame_period / 1500.f);
+        gMinigun.spin = fmodf(gMinigun.spin + gMinigun.spin_speed * 2.f * (float)M_PI * 25.f * pFrame_period / 1000.f, 2.f * (float)M_PI);
+        gMinigun.heat = MAX(0.f, gMinigun.heat - pFrame_period * MINIGUN_COOL_PER_MS);
+        UpdateMinigunLooks();
+        PoseMinigun(car);
+        return;
+    }
+
+    can_fire = !gCountdown && !gRace_finished && !car->knackered && !gMinigun.overheated;
+    if (can_fire && (now - gMinigun.last_target_search > 100 || !TargetStillValid())) {
+        if (!TargetStillValid()) {
+            FindTarget();
+        }
+        gMinigun.last_target_search = now;
+    }
+    if (!can_fire) {
+        gMinigun.target_type = eMinigun_target_none;
+    }
+
+    firing = 0;
+    if (gMinigun.target_type != eMinigun_target_none) {
+        TargetPoint(&target);
+        AimAt(&target, MINIGUN_TURN_SPEED * pFrame_period / 1000.f, &error);
+        if (gMinigun.spin_speed == 0.f) {
+            gMinigun.spinning_since = now;
+        }
+        gMinigun.spin_speed = MIN(1.f, gMinigun.spin_speed + pFrame_period / (float)MINIGUN_SPIN_UP);
+        if (error < MINIGUN_AIM_TOLERANCE && now - gMinigun.spinning_since >= MINIGUN_SPIN_UP) {
+            firing = 1;
+            while (now - gMinigun.last_round >= MINIGUN_ROUND_PERIOD && gMinigun.target_type != eMinigun_target_none) {
+                FireRound();
+                if (now - gMinigun.last_round > 4 * MINIGUN_ROUND_PERIOD) {
+                    gMinigun.last_round = now;
+                }
+            }
+        }
+    } else {
+        gMinigun.yaw = TurnTowards(gMinigun.yaw, 0.f, MINIGUN_TURN_SPEED * pFrame_period / 2000.f);
+        gMinigun.pitch = TurnTowards(gMinigun.pitch, 0.f, MINIGUN_TURN_SPEED * pFrame_period / 2000.f);
+        gMinigun.spin_speed = MAX(0.f, gMinigun.spin_speed - pFrame_period / 1500.f);
+    }
+    gMinigun.spin += gMinigun.spin_speed * 2.f * (float)M_PI * 25.f * pFrame_period / 1000.f;
+    gMinigun.spin = fmodf(gMinigun.spin, 2.f * (float)M_PI);
+
+    if (firing) {
+        gMinigun.heat += pFrame_period * MINIGUN_HEAT_PER_MS;
+        if (gMinigun.heat >= 1.f) {
+            gMinigun.heat = 1.f;
+            gMinigun.overheated = 1;
+            NewTextHeadupSlot(eHeadupSlot_misc, 0, 1500, -kFont_MEDIUMHD, "MINIGUN OVERHEATED");
+        }
+        if (gMinigun.sound_tag == 0 || !DRS3SoundStillPlaying(gMinigun.sound_tag)) {
+            gMinigun.sound_tag = DRS3StartSound(gEffects_outlet, MINIGUN_SOUND_ID);
+        }
+    } else {
+        gMinigun.heat = MAX(0.f, gMinigun.heat - pFrame_period * MINIGUN_COOL_PER_MS);
+        if (gMinigun.overheated && gMinigun.heat <= MINIGUN_RESUME_HEAT) {
+            gMinigun.overheated = 0;
+        }
+        StopFiringSound();
+    }
+    gMinigun.pose_pitch = gMinigun.pitch;
+    UpdateMinigunLooks();
+    PoseMinigun(car);
+}
+
+void RenderMinigunTracers(br_actor* pCamera) {
+    br_vector3 start;
+    br_vector3 end;
+    br_vector3 start_cam;
+    br_vector3 end_cam;
+    tU32 now;
+    int i;
+    int any;
+
+    now = GetTotalTime();
+    any = 0;
+    for (i = 0; i < COUNT_OF(gMinigun.tracers); i++) {
+        if (gMinigun.tracers[i].birth != 0 && now - gMinigun.tracers[i].birth < MINIGUN_TRACER_LIFE) {
+            any = 1;
+            break;
+        }
+    }
+    if (!any) {
+        return;
+    }
+#ifdef DETHRACE_3DFX_PATCH
+    if (gNo_2d_effects) {
+        BrActorRemove(gLine_actor);
+        BrActorAdd(pCamera, gLine_actor);
+        gLine_model->vertices[0].red = 255;
+        gLine_model->vertices[0].grn = 255;
+        gLine_model->vertices[0].blu = 200;
+        gLine_model->vertices[1].red = 255;
+        gLine_model->vertices[1].grn = 170;
+        gLine_model->vertices[1].blu = 60;
+        BrModelUpdate(gLine_model, BR_MODU_ALL);
+    }
+#endif
+    for (i = 0; i < COUNT_OF(gMinigun.tracers); i++) {
+        tMinigun_tracer* t = &gMinigun.tracers[i];
+        br_vector3 mid;
+        br_scalar age;
+
+        if (t->birth == 0 || now - t->birth >= MINIGUN_TRACER_LIFE) {
+            continue;
+        }
+        // A short streak flying from the muzzle to the target
+        age = (now - t->birth) / (float)MINIGUN_TRACER_LIFE;
+        BrVector3Sub(&mid, &t->end, &t->start);
+        BrVector3Scale(&start, &mid, MAX(0.f, age - 0.35f));
+        BrVector3Accumulate(&start, &t->start);
+        BrVector3Scale(&end, &mid, MIN(1.f, age + 0.35f));
+        BrVector3Accumulate(&end, &t->start);
+        DRMatrix34TApplyP(&start_cam, &start, &gCamera_to_world);
+        DRMatrix34TApplyP(&end_cam, &end, &gCamera_to_world);
+        DrawLine3D(&start_cam, &end_cam, gRender_screen, gDepth_buffer, gFog_shade_table);
+    }
+#ifdef DETHRACE_3DFX_PATCH
+    if (gNo_2d_effects) {
+        BrActorRemove(gLine_actor);
+        BrActorAdd(gDont_render_actor, gLine_actor);
+    }
+#endif
+}
+
+void MinigunDumpState(void) {
+    static const char* target_names[] = { "none", "pedestrian", "car", "prop" };
+    br_vector3 hatch;
+
+    if (!gMinigun.built) {
+        printf("[state] minigun not built yet\n");
+        return;
+    }
+    BrVector3Copy(&hatch, (br_vector3*)gMinigun.hatch_root->t.t.mat.m[3]);
+    printf("[state] minigun on %d deploy %.2f doors %.2f lift %.3f pitch %.2f yaw %.2f heat %.2f overheated %d target %s\n",
+        gMinigun.on, gMinigun.deploy, gMinigun.door_open, gMinigun.lift, gMinigun.pose_pitch, gMinigun.yaw, gMinigun.heat,
+        gMinigun.overheated, target_names[gMinigun.target_type]);
+    printf("[state] minigun rounds %d hits %d pedestrians killed %d cars wasted %d hatch at %.2f %.2f %.2f, car width %.3f, drawn %s/%s\n",
+        gMinigun.stats.rounds, gMinigun.stats.hits, gMinigun.stats.peds_doomed, gMinigun.stats.cars_wasted,
+        hatch.v[0], hatch.v[1], hatch.v[2], gMinigun.size,
+        gMinigun.hatch_root->render_style == BR_RSTYLE_NONE ? "hatch hidden" : "hatch shown",
+        gMinigun.mount->render_style == BR_RSTYLE_NONE ? "gun hidden" : "gun shown");
+}
+
+int MinigunIsActor(br_actor* pActor) {
+    return gMinigun.built && (pActor == gMinigun.mount || pActor == gMinigun.hatch_root);
+}
+
+int MinigunMuzzleFlash(br_vector3* pPos, br_scalar* pIntensity) {
+    if (gMinigun.deploy < 1.f || gMinigun.last_round == 0 || GetTotalTime() - gMinigun.last_round > 50) {
+        return 0;
+    }
+    *pPos = gMinigun.muzzle;
+    *pIntensity = FRandomBetween(1.5f, 3.f);
+    return 1;
+}
