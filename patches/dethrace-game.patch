+#include "globvrkm.h"
+#include "globvrpb.h"
+#include "input.h"
+#include "macros.h"
+#include "mainloop.h"
+#include "minigun.h"
+#include "modmesh.h"
+#include "opponent.h"
+#include "pedestrn.h"
+#include "sound.h"
+#include "spark.h"
+#include "utility.h"
+#include "water.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// Twin rocket pods on the player's front bumper; F fires, holding it fires a salvo. Rockets steer a little towards a car
+// near their line and explode on whatever they hit, or in the air at the end of their flight.
+
+#define ROCKET_FIRE_SOUND_ID 5605        // added to SOUND.TXT by tools/add_minigun_sound.py
+#define ROCKET_BOOM_SOUND_ID 5606
+#define ROCKET_TUBES 4                   // two pods of two tubes
+#define ROCKET_RELOAD 2500               // ms for an empty tube to reload
+#define ROCKET_FIRE_INTERVAL 250         // ms between rockets while F is held
+#define ROCKET_COUNT 8                   // rockets in flight at once
+#define ROCKET_START_SPEED 5.f           // world units a second (1 unit is 6.9 m), on top of the car's speed
+#define ROCKET_MAX_SPEED 14.f            // about 350 km/h
+#define ROCKET_ACCELERATION 35.f
+#define ROCKET_LIFE 3000                 // ms before it blows up in the air
+#define ROCKET_HOMING_COS 0.966f         // steers towards a car within 15 degrees of its line...
+#define ROCKET_HOMING_RANGE 20.f         // ...and this far away
+#define ROCKET_TURN_RATE 0.9f            // radians a second
+#define ROCKET_BLAST_RADIUS 0.9f         // world units, about 6 m
+#define ROCKET_PED_RADIUS 0.06f          // how close a rocket passes to a pedestrian to hit them
+#define ROCKET_TRAIL_PERIOD 18           // ms between puffs of the smoke trail
+#define PUFF_COUNT 160
+#define BLAST_COUNT 6
+#define BLAST_SPRITES 7
+#define FIREBALL_FRAMES 8
+#define SMOKE_LEVELS 8
+#define LIGHT_COUNT 16
+#define FLAME_COUNT 160                  // fire on burning cars
+#define FLAME_PERIOD 28                  // ms between new flames on a burning car
+
+typedef struct tRocket {
+    br_actor* actor;
+    br_vector3 pos;
+    br_vector3 dir;   // where it points
+    br_vector3 carry; // the car's velocity when it was fired
+    br_scalar speed;
+    br_scalar size;   // width of the car that fired it
+    br_scalar roll;
+    tU32 birth;
+    tU32 last_puff;
+    tCar_spec* target;
+    int active;
+} tRocket;
+
+typedef struct tPuff {
+    br_actor* actor;
+    br_vector3 pos;
+    br_vector3 vel;
+    br_scalar size;
+    br_scalar grow;
+    br_scalar spin;
+    br_scalar strength; // opacity at its thickest, 0..1
+    tU32 birth;
+    tU32 life;
+    int dark;
+    int active;
+} tPuff;
+
+typedef struct tBlast_sprite {
+    br_actor* actor;
+    br_vector3 offset; // from the centre of the blast
+    br_vector3 drift;
+    br_scalar size;
+    br_scalar spin;
+    tU32 delay;
+    tU32 life;
+} tBlast_sprite;
+
+typedef struct tBlast {
+    br_vector3 pos;
+    tU32 birth;
+    int active;
+    tBlast_sprite sprites[BLAST_SPRITES];
+} tBlast;
+
+typedef struct tFlame {
+    br_actor* actor;
+    br_vector3 pos;
+    br_vector3 vel;
+    br_scalar size;
+    br_scalar spin;
+    tU32 birth;
+    tU32 life;
