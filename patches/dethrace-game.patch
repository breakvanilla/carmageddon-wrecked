+#ifndef _DEFORM_H_
+#define _DEFORM_H_
+
+// Explosions dent the track: craters in the road, dents in walls
+
+#include "dr_types.h"
+
+// Pushes track surfaces within pRadius of pCentre away from it, up to pDepth, and scorches the dent with pScorch.
+// Returns 0 if nothing changed (no surface in range, or no room left).
+int DeformExplosion(br_vector3* pCentre, br_scalar pRadius, br_scalar pDepth, br_material* pScorch);
+
+// Clears scorch marks and resets the budget of new faces
+void DeformReset(void);
+
+void DeformDumpState(void);
+
+#endif
diff --git a/src/DETHRACE/common/depth.c b/src/DETHRACE/common/depth.c
index d2aff2d..94286ed 100644
