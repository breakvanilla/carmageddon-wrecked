+#ifdef DETHRACE_3DFX_PATCH
+// Wrecked Carmageddon: curved, glossy car bodies; 0 turns either off
+static int CarTessellation(void) {
+    static int level = -1;
+    const char* value;
+
+    if (level < 0) {
+        value = getenv("CARMA_TESSELLATION");
+        level = value != NULL ? atoi(value) : 6;
+        level = level < 0 ? 0 : level > 16 ? 16 : level;
+    }
+    return level;
+}
+
+static float CarReflectivity(void) {
+    static float reflectivity = -1.f;
+    const char* value;
+
+    if (reflectivity < 0.f) {
+        value = getenv("CARMA_REFLECTIONS");
+        reflectivity = value != NULL ? atof(value) : 0.35f;
+        if (reflectivity < 0.f) {
+            reflectivity = 0.f;
+        }
+    }
+    return reflectivity;
+}
+
+static int IsCarActor(br_actor* pActor) {
+    static const tVehicle_type categories[] = { eVehicle_self, eVehicle_net_player, eVehicle_opponent, eVehicle_rozzer };
+    tCar_spec* car;
+    int c;
+    int i;
+
+    for (c = 0; c < COUNT_OF(categories); c++) {
+        for (i = 0; i < GetCarCount(categories[c]); i++) {
+            car = GetCarSpec(categories[c], i);
+            if (car != NULL && car->car_master_actor == pActor) {
+                return 1;
+            }
+        }
+    }
+    return 0;
+}
+#endif
