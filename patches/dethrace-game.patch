+// A byte no data file has means the line was decoded with the wrong method
+static int DecodedBadly(const char* pS) {
+    for (; *pS != '\0'; pS++) {
+        if ((unsigned char)*pS >= 0x7f) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+// Some releases mix the two encryption methods (DOS RACES/VOODOO.TXT read in 3dfx mode), so a line that decodes badly
+// is retried with the other
+void EncodeLine(char* pS) {
+    char copy[1024];
+    size_t len;
+    int method;
+
+    len = strlen(pS);
+    if (len >= sizeof(copy)) {
+        EncodeLineOnce(pS);
+        return;
+    }
+    memcpy(copy, pS, len + 1);
+    EncodeLineOnce(pS);
+    if (harness_game_info.mode == eGame_carmageddon_demo || (gEncryption_method != 1 && gEncryption_method != 2) || !DecodedBadly(pS)) {
+        return;
+    }
+    method = gEncryption_method;
+    gEncryption_method = 3 - method;
+    EncodeLineOnce(copy);
+    gEncryption_method = method;
+    if (!DecodedBadly(copy)) {
+        strcpy(pS, copy);
+    }
+}
