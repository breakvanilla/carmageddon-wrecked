+// Average texture colour, so chunks look like the wall they came from
+static void MaterialColour(br_material* pMaterial, br_scalar* pRgb) {
+    br_pixelmap* map;
+    br_uint_32* palette;
+    br_uint_32 c;
+    br_uint_8* row;
+    int x, y, n;
+    int i;
+
+    pRgb[0] = pRgb[1] = pRgb[2] = 0.55f;
+    if (pMaterial == NULL) {
+        return;
+    }
+    for (i = 0; i < COUNT_OF(gDestruct.colours); i++) {
+        if (gDestruct.colours[i].material == pMaterial) {
+            memcpy(pRgb, gDestruct.colours[i].rgb, sizeof(gDestruct.colours[i].rgb));
+            return;
+        }
+    }
+    map = pMaterial->colour_map;
+    if (map != NULL && map->type == BR_PMT_INDEX_8 && map->pixels != NULL && gRender_palette != NULL) {
+        palette = gRender_palette->pixels;
+        pRgb[0] = pRgb[1] = pRgb[2] = 0.f;
+        n = 0;
+        for (y = 0; y < map->height; y += MAX(1, map->height / 16)) {
+            row = (br_uint_8*)map->pixels + y * map->row_bytes;
+            for (x = 0; x < map->width; x += MAX(1, map->width / 16)) {
+                if (row[x] == 0) {
+                    continue;
+                }
+                c = palette[row[x]];
+                pRgb[0] += BR_RED(c) / 255.f;
+                pRgb[1] += BR_GRN(c) / 255.f;
+                pRgb[2] += BR_BLU(c) / 255.f;
+                n++;
+            }
+        }
+        for (i = 0; i < 3; i++) {
+            pRgb[i] = n > 0 ? pRgb[i] / n : 0.55f;
+        }
+    } else {
+        c = pMaterial->colour;
+        pRgb[0] = BR_RED(c) / 255.f;
+        pRgb[1] = BR_GRN(c) / 255.f;
+        pRgb[2] = BR_BLU(c) / 255.f;
+    }
+    gDestruct.colours[gDestruct.next_colour].material = pMaterial;
+    memcpy(gDestruct.colours[gDestruct.next_colour].rgb, pRgb, sizeof(gDestruct.colours[0].rgb));
+    gDestruct.next_colour = (gDestruct.next_colour + 1) % COUNT_OF(gDestruct.colours);
+}
+
+// Texture is carmamod_<name>.png from the hi-res texture folder
+static br_material* ModMaterial(char* pName, int pColour_key) {
+    br_pixelmap* map;
+    br_material* material;
+    char identifier[64];
+
+    BrSprintfN(identifier, sizeof(identifier) - 1, "carmamod_%s", pName);
+    map = BrPixelmapAllocate(BR_PMT_INDEX_8, 16, 16, NULL, BR_PMAF_NORMAL);
+    memset(map->pixels, pColour_key ? 0 : 8, 16 * 16);
+    map->identifier = BrResStrDup(map, identifier);
+    BrMapAdd(map);
+    material = BrMaterialAllocate(identifier);
+    material->flags = BR_MATF_PRELIT | BR_MATF_LIGHT | BR_MATF_SMOOTH | BR_MATF_MAP_INTERPOLATION | BR_MATF_MIP_INTERPOLATION
+        | BR_MATF_PERSPECTIVE | BR_MATF_TWO_SIDED;
+    if (!pColour_key) {
+        material->flags |= BR_MATF_DISABLE_COLOUR_KEY;
+    }
+    material->colour_map = map;
+    BrMaterialAdd(material);
+    return material;
+}
