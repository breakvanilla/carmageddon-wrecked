+} gRocket;
+
+// Tube mouths in launcher space (units of the car's width, the car facing -z)
+static const br_scalar gTube_x[ROCKET_TUBES] = { -0.334f, 0.334f, -0.266f, 0.266f };
+#define POD_X 0.3f
+#define TUBE_MOUTH_Z -0.1f
+#define TUBE_RADIUS 0.03f
+
+// The rocket model points down -z, nose at z = -0.2 and tail at 0.15, in car widths. The plume and glow are separate
+// parts, drawn additively and left off the rockets in the tubes.
+static br_material* RocketMaterial(char* pName, int pColour_key) {
+    char name[48];
+
+    BrSprintfN(name, sizeof(name) - 1, "rocket_%s", pName);
+    return MeshMaterial(name, pColour_key);
+}
+
+// A material drawn as light added to the scene (fire, exhaust): black adds nothing
+static br_material* GlowMaterial(char* pName) {
+    br_material* material;
+
+    material = RocketMaterial(pName, 1);
+    material->mode = (material->mode & ~BR_MATM_BLEND_MODE_MASK) | BR_MATM_BLEND_MODE_SUMMED;
+    MeshSetOpacity(material, 254); // under 255, so dynamic lights leave it alone
+    return material;
+}
+
+// One frame of an explosion's fireball, more see-through as it burns out
+static br_material* FireballMaterial(int pFrame) {
+    br_material* material;
+    char name[32];
+
+    BrSprintfN(name, sizeof(name) - 1, "fireball_%d", pFrame);
+    material = RocketMaterial(name, 1);
+    MeshSetOpacity(material, 255 - 110 * pFrame / (FIREBALL_FRAMES - 1));
+    return material;
+}
+
+// See-through smoke at one of SMOKE_LEVELS opacities, level 0 the thinnest
+static br_material* SmokeMaterial(int pDark, int pLevel) {
+    br_material* material;
+
+    material = RocketMaterial(pDark ? "smoke_dark" : "smoke", 1);
+    MeshSetOpacity(material, 200 * (pLevel + 1) / SMOKE_LEVELS);
+    return material;
+}
+
+static void BuildRocketModel(br_actor* pParent, int pWith_exhaust) {
+    static br_material* body;
+    static br_material* nose;
+    static br_material* fin;
+    static br_material* tube;
+    static br_material* exhaust;
+    static br_material* glow;
+    static br_model* body_model;
+    static br_model* nose_model;
+    static br_model* fin_model;
+    static br_model* nozzle_model;
+    static br_model* exhaust_model;
+    static br_model* glow_model;
+    br_vector3 n = { { 0.f, 0.f, 1.f } };
+    int b;
+    int i;
+
+    if (body == NULL) {
+        body = RocketMaterial("body", 0);
+        nose = RocketMaterial("nose", 0);
+        fin = RocketMaterial("fin", 0);
+        tube = RocketMaterial("tube", 0);
+        exhaust = GlowMaterial("exhaust");
+        glow = GlowMaterial("glow");
+
+        MeshBegin();
+        MeshCylinder(2, 0.f, 0.f, 0.022f, -0.12f, 0.13f, 12, 0, 1.f, 1.f);
+        body_model = MeshModel("rocket_body");
+        MeshBegin();
+        MeshFrustum(2, 0.f, 0.f, 0.022f, 0.f, -0.12f, -0.2f, 12, 0, 1.f, 1.f);
+        nose_model = MeshModel("rocket_nose");
+        MeshBegin();
+        for (i = 0; i < 4; i++) {
+            // Four swept fins round the tail
+            br_scalar c = cosf(i * (float)M_PI / 2.f);
+            br_scalar s = sinf(i * (float)M_PI / 2.f);
+            MeshBox(c * 0.034f, s * 0.034f, 0.105f, c != 0.f ? 0.014f : 0.002f, s != 0.f ? 0.014f : 0.002f, 0.025f);
+        }
+        fin_model = MeshModel("rocket_fins");
+        MeshBegin();
+        MeshFrustum(2, 0.f, 0.f, 0.016f, 0.021f, 0.13f, 0.15f, 12, 1, 1.f, 0.2f);
+        nozzle_model = MeshModel("rocket_nozzle");
+
+        // Plume: two crossed planes behind the nozzle, u across and v away from it
+        MeshBegin();
+        b = gMesh.nvertices;
+        MeshVertex(-0.05f, 0.f, 0.15f, &n, 0.f, 0.f);
+        MeshVertex(0.05f, 0.f, 0.15f, &n, 1.f, 0.f);
+        MeshVertex(0.05f, 0.f, 0.55f, &n, 1.f, 1.f);
+        MeshVertex(-0.05f, 0.f, 0.55f, &n, 0.f, 1.f);
+        MeshQuad(b, b + 1, b + 2, b + 3);
+        b = gMesh.nvertices;
+        MeshVertex(0.f, -0.05f, 0.15f, &n, 0.f, 0.f);
+        MeshVertex(0.f, 0.05f, 0.15f, &n, 1.f, 0.f);
+        MeshVertex(0.f, 0.05f, 0.55f, &n, 1.f, 1.f);
+        MeshVertex(0.f, -0.05f, 0.55f, &n, 0.f, 1.f);
+        MeshQuad(b, b + 1, b + 2, b + 3);
+        for (i = 0; i < gMesh.nvertices; i++) {
+            gMesh.vertices[i].red = gMesh.vertices[i].grn = gMesh.vertices[i].blu = 255;
+        }
+        exhaust_model = MeshModel("rocket_exhaust");
+        // Glow round the nozzle, seen from behind
+        MeshBegin();
+        b = gMesh.nvertices;
+        MeshVertex(-0.07f, -0.07f, 0.16f, &n, 0.f, 0.f);
+        MeshVertex(0.07f, -0.07f, 0.16f, &n, 1.f, 0.f);
+        MeshVertex(0.07f, 0.07f, 0.16f, &n, 1.f, 1.f);
+        MeshVertex(-0.07f, 0.07f, 0.16f, &n, 0.f, 1.f);
+        MeshQuad(b, b + 1, b + 2, b + 3);
+        for (i = 0; i < gMesh.nvertices; i++) {
+            gMesh.vertices[i].red = gMesh.vertices[i].grn = gMesh.vertices[i].blu = 255;
+        }
+        glow_model = MeshModel("rocket_glow");
+    }
+    NewPart(pParent, body_model, body);
+    NewPart(pParent, nose_model, nose);
+    NewPart(pParent, fin_model, fin);
+    NewPart(pParent, nozzle_model, tube);
+    if (pWith_exhaust) {
+        NewPart(pParent, exhaust_model, exhaust);
+        NewPart(pParent, glow_model, glow);
+    }
+}
+
+static void BuildLauncher(void) {
+    br_material* pod;
+    br_material* tube;
+    br_material* bracket;
+    br_actor* actor;
+    int side;
+    int i;
+
+    pod = RocketMaterial("pod", 0);
+    tube = RocketMaterial("tube", 0);
+    tube->flags |= BR_MATF_TWO_SIDED; // seen from inside, looking down the tube
+    BrMaterialUpdate(tube, BR_MATU_ALL);
+    bracket = RocketMaterial("fin", 0);
+
+    gRocket.launcher = NewPart(gNon_track_actor, NULL, NULL);
+    // Housings, one each side, with the back half buried in the bodywork
+    MeshBegin();
+    for (side = -1; side <= 1; side += 2) {
+        MeshBox(side * POD_X, 0.f, 0.075f, 0.075f, 0.045f, 0.145f);
+    }
+    NewPart(gRocket.launcher, MeshModel("rocket_pods"), pod);
+    // Tubes, open at the front, sticking out a little
+    MeshBegin();
+    for (i = 0; i < ROCKET_TUBES; i++) {
+        MeshCylinder(2, gTube_x[i], 0.f, TUBE_RADIUS, TUBE_MOUTH_Z, 0.12f, 12, 0, 1.f, 1.f);
+        MeshCylinder(2, gTube_x[i], 0.f, TUBE_RADIUS, 0.12f, 0.13f, 12, 1, 1.f, 0.1f);
+    }
+    NewPart(gRocket.launcher, MeshModel("rocket_tubes"), tube);
+    // A bar across the front joining the pods, and the brackets bolting them on
+    MeshBegin();
+    MeshBox(0.f, -0.035f, 0.1f, POD_X, 0.012f, 0.025f);
+    for (side = -1; side <= 1; side += 2) {
+        MeshBox(side * POD_X, -0.05f, 0.12f, 0.03f, 0.012f, 0.06f);
+    }
+    NewPart(gRocket.launcher, MeshModel("rocket_bracket"), bracket);
+
+    // The rocket in each tube, its nose just inside the mouth
+    for (i = 0; i < ROCKET_TUBES; i++) {
+        actor = NewPart(gRocket.launcher, NULL, NULL);
+        BrMatrix34Translate(&actor->t.t.mat, gTube_x[i], 0.f, TUBE_MOUTH_Z + 0.015f + 0.2f);
+        BuildRocketModel(actor, 0);
+        gRocket.tube_rockets[i] = actor;
+        gRocket.tube_loaded[i] = 1;
+    }
+    gRocket.launcher->render_style = BR_RSTYLE_NONE;
+}
+
+static void BuildRocket(void) {
+    br_vector3 n = { { 0.f, 0.f, 1.f } };
+    int i, k, b;
+
+    BuildLauncher();
+    // Drawn last, by RocketRenderEffects(): smoke and fire don't write depth, so anything drawn later would cover them
+    gRocket.root = NewPart(gUniverse_actor, NULL, NULL);
+    for (i = 0; i < ROCKET_COUNT; i++) {
+        gRocket.rockets[i].actor = NewPart(gRocket.root, NULL, NULL);
+        BuildRocketModel(gRocket.rockets[i].actor, 1);
+        gRocket.rockets[i].actor->render_style = BR_RSTYLE_NONE;
+    }
+
+    // Billboards for smoke and fire: a unit square facing +z, turned to face the camera
+    MeshBegin();
+    b = gMesh.nvertices;
+    MeshVertex(-0.5f, -0.5f, 0.f, &n, 0.f, 1.f);
+    MeshVertex(0.5f, -0.5f, 0.f, &n, 1.f, 1.f);
+    MeshVertex(0.5f, 0.5f, 0.f, &n, 1.f, 0.f);
+    MeshVertex(-0.5f, 0.5f, 0.f, &n, 0.f, 0.f);
+    MeshQuad(b, b + 1, b + 2, b + 3);
+    for (i = 0; i < gMesh.nvertices; i++) {
+        gMesh.vertices[i].red = gMesh.vertices[i].grn = gMesh.vertices[i].blu = 255;
+    }
+    gRocket.sprite_model = MeshModel("rocket_sprite");
+    for (i = 0; i < FIREBALL_FRAMES; i++) {
+        gRocket.fireball[i] = FireballMaterial(i);
+    }
+    for (k = 0; k < 2; k++) {
+        for (i = 0; i < SMOKE_LEVELS; i++) {
+            gRocket.smoke[k][i] = SmokeMaterial(k, i);
+        }
+    }
+    for (i = 0; i < PUFF_COUNT; i++) {
+        gRocket.puffs[i].actor = NewPart(gRocket.root, gRocket.sprite_model, gRocket.smoke[0][0]);
+        gRocket.puffs[i].actor->render_style = BR_RSTYLE_NONE;
+    }
+    for (i = 0; i < BLAST_COUNT; i++) {
+        for (k = 0; k < BLAST_SPRITES; k++) {
+            gRocket.blasts[i].sprites[k].actor = NewPart(gRocket.root, gRocket.sprite_model, gRocket.fireball[0]);
+            gRocket.blasts[i].sprites[k].actor->render_style = BR_RSTYLE_NONE;
+        }
+    }
+    for (i = 0; i < FLAME_COUNT; i++) {
+        gRocket.flames[i].actor = NewPart(gRocket.root, gRocket.sprite_model, gRocket.fireball[0]);
+        gRocket.flames[i].actor->render_style = BR_RSTYLE_NONE;
+    }
+    gRocket.built = 1;
+}
+
+// Front-most body surface at (pX, pY) in model space
+static int FrontSurface(br_model* pModel, br_scalar pX, br_scalar pY, br_scalar* pZ) {
+    br_vector3* a;
+    br_vector3* b;
+    br_vector3* c;
+    br_scalar d, u, v, w, z;
+    int found;
+    int i;
+
+    found = 0;
+    for (i = 0; i < pModel->nfaces; i++) {
+        a = &pModel->vertices[pModel->faces[i].vertices[0]].p;
+        b = &pModel->vertices[pModel->faces[i].vertices[1]].p;
+        c = &pModel->vertices[pModel->faces[i].vertices[2]].p;
+        d = (b->v[1] - c->v[1]) * (a->v[0] - c->v[0]) + (c->v[0] - b->v[0]) * (a->v[1] - c->v[1]);
+        if (fabsf(d) < 1e-8f) {
+            continue;
+        }
+        u = ((b->v[1] - c->v[1]) * (pX - c->v[0]) + (c->v[0] - b->v[0]) * (pY - c->v[1])) / d;
+        v = ((c->v[1] - a->v[1]) * (pX - c->v[0]) + (a->v[0] - c->v[0]) * (pY - c->v[1])) / d;
+        w = 1.f - u - v;
+        if (u < 0.f || v < 0.f || w < 0.f) {
+            continue;
+        }
+        z = u * a->v[2] + v * b->v[2] + w * c->v[2];
+        if (!found || z < *pZ) {
+            *pZ = z;
+            found = 1;
+        }
+    }
+    return found;
+}
+
+// Launcher position on the front bumper, once per model. Each pod goes back to the deepest point behind it, so it
+// doesn't float in front of a spoiler.
+static void MountPoint(br_actor* pActor, br_vector3* pOut) {
+    static br_model* cached_model;
+    static br_vector3 cached;
+    br_bounds* b;
+    br_scalar width;
+    br_scalar x, y;
+    br_scalar z;
+    br_scalar front;
+    int found;
+    int side, i, j;
+
+    if (pActor->model == cached_model) {
+        *pOut = cached;
+        return;
+    }
+    b = &pActor->model->bounds;
+    width = b->max.v[0] - b->min.v[0];
+    x = (b->min.v[0] + b->max.v[0]) / 2.f;
+    y = b->min.v[1] + 0.27f * (b->max.v[1] - b->min.v[1]);
+    found = 0;
+    front = b->min.v[2];
+    for (side = -1; side <= 1; side += 2) {
+        for (i = -1; i <= 1; i++) {
+            for (j = -1; j <= 1; j++) {
+                if (FrontSurface(pActor->model, x + (side * POD_X + i * 0.06f) * width, y + j * 0.035f * width, &z)) {
+                    front = found ? MAX(front, z) : z;
+                    found = 1;
+                }
+            }
+        }
+    }
+    // The tube mouths stick out past the bodywork
+    BrVector3Set(&cached, x, y, front - 0.04f * width);
+    cached_model = pActor->model;
+    *pOut = cached;
+}
+
+static void CarModelToWorld(tCar_spec* pCar, br_matrix34* pOut, br_bounds** pBounds) {
+    br_actor* actor;
+
+    actor = pCar->car_model_actors[pCar->principal_car_actor].actor;
+    *pBounds = &actor->model->bounds;
+    BrMatrix34Mul(pOut, &actor->t.t.mat, &pCar->car_master_actor->t.t.mat);
+}
+
+static void PoseLauncher(tCar_spec* pCar) {
+    br_matrix34 model_to_world;
+    br_matrix34 m;
+    br_bounds* b;
+    br_vector3 mount;
+    tU32 now;
+    int i;
+
+    CarModelToWorld(pCar, &model_to_world, &b);
+    gRocket.size = b->max.v[0] - b->min.v[0];
+    MountPoint(pCar->car_model_actors[pCar->principal_car_actor].actor, &mount);
+    BrMatrix34Scale(&m, gRocket.size, gRocket.size, gRocket.size);
+    BrMatrix34PostTranslate(&m, mount.v[0], mount.v[1], mount.v[2]);
+    BrMatrix34Mul(&gRocket.launcher->t.t.mat, &m, &model_to_world);
+
+    // A reloaded rocket slides forward into place
+    now = GetTotalTime();
+    for (i = 0; i < ROCKET_TUBES; i++) {
+        br_scalar back = 0.f;
+        if (!gRocket.tube_loaded[i]) {
+            gRocket.tube_rockets[i]->render_style = BR_RSTYLE_NONE;
+            continue;
+        }
+        if (now - gRocket.tube_emptied[i] < ROCKET_RELOAD + 300 && gRocket.tube_emptied[i] != 0) {
+            back = 0.25f * (1.f - (now - gRocket.tube_emptied[i] - ROCKET_RELOAD) / 300.f);
+        }
+        BrMatrix34Translate(&gRocket.tube_rockets[i]->t.t.mat, gTube_x[i], 0.f, TUBE_MOUTH_Z + 0.015f + 0.2f + back);
+        gRocket.tube_rockets[i]->render_style = BR_RSTYLE_FACES;
+    }
+}
+
+static void RocketMatrix(tRocket* pRocket, br_matrix34* pOut) {
+    br_vector3 x, y, z;
+    br_vector3 up = { { 0.f, 1.f, 0.f } };
+    br_scalar c, s;
+    int k;
+
+    BrVector3Negate(&z, &pRocket->dir);
+    if (fabsf(z.v[1]) > 0.98f) {
+        BrVector3Set(&up, 1.f, 0.f, 0.f);
+    }
+    BrVector3Cross(&x, &up, &z);
+    BrVector3Normalise(&x, &x);
+    BrVector3Cross(&y, &z, &x);
+    c = cosf(pRocket->roll) * pRocket->size;
+    s = sinf(pRocket->roll) * pRocket->size;
+    for (k = 0; k < 3; k++) {
+        pOut->m[0][k] = x.v[k] * c + y.v[k] * s;
+        pOut->m[1][k] = y.v[k] * c - x.v[k] * s;
+        pOut->m[2][k] = z.v[k] * pRocket->size;
+        pOut->m[3][k] = pRocket->pos.v[k];
+    }
+}
+
+static void AddPuff(br_vector3* pPos, br_vector3* pVel, br_scalar pSize, br_scalar pGrow, br_scalar pStrength, tU32 pLife, int pDark) {
+    tPuff* p;
+
+    p = &gRocket.puffs[gRocket.next_puff];
+    gRocket.next_puff = (gRocket.next_puff + 1) % PUFF_COUNT;
+    p->pos = *pPos;
+    p->vel = *pVel;
+    p->size = pSize;
+    p->grow = pGrow;
+    p->spin = FRandomBetween(0.f, 6.28f);
+    p->strength = pStrength;
+    p->birth = GetTotalTime();
+    p->life = pLife;
+    p->dark = pDark;
+    p->active = 1;
+}
+
+static void MovePuffs(tU32 pFrame_period) {
+    tPuff* p;
+    br_scalar dt;
+    br_scalar age;
+    br_scalar opacity;
+    int i;
+
+    dt = pFrame_period / 1000.f;
+    for (i = 0; i < PUFF_COUNT; i++) {
+        p = &gRocket.puffs[i];
+        if (!p->active) {
+            continue;
+        }
+        age = (GetTotalTime() - p->birth) / (br_scalar)p->life;
+        if (age >= 1.f) {
+            p->active = 0;
+            p->actor->render_style = BR_RSTYLE_NONE;
+            continue;
+        }
+        p->pos.v[0] += p->vel.v[0] * dt;
+        p->pos.v[1] += p->vel.v[1] * dt;
+        p->pos.v[2] += p->vel.v[2] * dt;
+        BrVector3Scale(&p->vel, &p->vel, MAX(0.f, 1.f - 2.5f * dt));
+        p->vel.v[1] += 0.15f * dt; // rises
+        // Thickens quickly, then thins out
+        opacity = p->strength * MIN(1.f, age / 0.08f) * (1.f - age);
+        if (opacity < 0.5f / SMOKE_LEVELS) {
+            p->actor->render_style = BR_RSTYLE_NONE;
+            continue;
+        }
+        p->actor->material = gRocket.smoke[p->dark][MIN(SMOKE_LEVELS - 1, (int)(opacity * SMOKE_LEVELS))];
+        MeshBillboard(p->actor, &p->pos, p->size * (1.f + p->grow * sqrtf(age)), p->spin + age * 0.6f);
+        p->actor->render_style = BR_RSTYLE_FACES;
+    }
+}
+
+static void StartBlast(br_vector3* pPos, br_vector3* pNormal) {
+    tBlast* blast;
+    tBlast_sprite* s;
+    br_scalar r;
+    int i;
+
+    blast = &gRocket.blasts[gRocket.next_blast];
+    gRocket.next_blast = (gRocket.next_blast + 1) % BLAST_COUNT;
+    blast->pos = *pPos;
+    // Pushed off the surface so it isn't half buried
+    blast->pos.v[0] += pNormal->v[0] * 0.08f;
+    blast->pos.v[1] += pNormal->v[1] * 0.08f;
+    blast->pos.v[2] += pNormal->v[2] * 0.08f;
+    blast->birth = GetTotalTime();
+    blast->active = 1;
+    r = ROCKET_BLAST_RADIUS;
+    for (i = 0; i < BLAST_SPRITES; i++) {
+        s = &blast->sprites[i];
+        if (i == 0) {
+            BrVector3Set(&s->offset, 0.f, 0.f, 0.f);
+            s->size = r * 1.4f;
+            s->delay = 0;
+            s->life = 700;
+        } else {
+            BrVector3Set(&s->offset, SRandomPosNeg(r * 0.3f), FRandomBetween(0.f, r * 0.3f), SRandomPosNeg(r * 0.3f));
+            s->size = r * FRandomBetween(0.6f, 1.f);
+            s->delay = IRandomBetween(0, 160);
+            s->life = IRandomBetween(550, 900);
+        }
+        BrVector3Set(&s->drift, SRandomPosNeg(0.2f), FRandomBetween(0.2f, 0.5f), SRandomPosNeg(0.2f));
+        s->spin = FRandomBetween(0.f, 6.28f);
+        s->actor->render_style = BR_RSTYLE_NONE;
+    }
+}
+
+static void MoveBlasts(void) {
+    tBlast* blast;
+    tBlast_sprite* s;
+    br_vector3 pos;
+    br_scalar age;
+    br_scalar t;
+    tU32 now;
+    int alive;
+    int i, k;
+
+    now = GetTotalTime();
+    for (i = 0; i < BLAST_COUNT; i++) {
+        blast = &gRocket.blasts[i];
+        if (!blast->active) {
+            continue;
+        }
+        alive = 0;
+        for (k = 0; k < BLAST_SPRITES; k++) {
+            s = &blast->sprites[k];
+            age = (br_scalar)(now - blast->birth) - (br_scalar)s->delay;
+            if (age < 0.f) {
+                alive = 1;
+                continue;
+            }
+            t = age / s->life;
+            if (t >= 1.f) {
+                s->actor->render_style = BR_RSTYLE_NONE;
+                continue;
+            }
+            alive = 1;
+            pos = blast->pos;
+            pos.v[0] += s->offset.v[0] + s->drift.v[0] * t;
+            pos.v[1] += s->offset.v[1] + s->drift.v[1] * t;
+            pos.v[2] += s->offset.v[2] + s->drift.v[2] * t;
+            s->actor->material = gRocket.fireball[MIN(FIREBALL_FRAMES - 1, (int)(t * FIREBALL_FRAMES))];
+            // Swells fast, then slowly
+            MeshBillboard(s->actor, &pos, s->size * (0.35f + 0.65f * sqrtf(t)), s->spin + t * 0.8f);
+            s->actor->render_style = BR_RSTYLE_FACES;
+        }
+        blast->active = alive;
+    }
+}
+
+// Bigger flames on burning cars than the game's own, rising from each fire smoke column
+static void MungeFlames(tU32 pFrame_period) {
+    tFlame* f;
+    br_scalar dt, t;
+    tU32 now;
+    int i;
+
+    now = GetTotalTime();
+    dt = pFrame_period / 1000.f;
+    if (now - gRocket.last_flame >= FLAME_PERIOD) {
+        gRocket.last_flame = now;
+        for (i = 0; i < COUNT_OF(gSmoke_column) && i < 32; i++) {
+            if (!(gColumn_flags & (1u << i)) || gSmoke_column[i].colour != 0 || gSmoke_column[i].car == NULL) {
+                continue;
+            }
+            f = &gRocket.flames[gRocket.next_flame];
+            gRocket.next_flame = (gRocket.next_flame + 1) % FLAME_COUNT;
+            f->pos = gSmoke_column[i].pos;
+            f->pos.v[0] += SRandomPosNeg(0.04f);
+            f->pos.v[1] += FRandomBetween(0.03f, 0.07f);
+            f->pos.v[2] += SRandomPosNeg(0.04f);
+            // Rises, and trails behind a moving car
+            BrVector3InvScale(&f->vel, &gSmoke_column[i].car->v, WORLD_SCALE * 3.f);
+            f->vel.v[0] += SRandomPosNeg(0.05f);
+            f->vel.v[1] = FRandomBetween(0.5f, 0.85f);
+            f->vel.v[2] += SRandomPosNeg(0.05f);
+            f->size = FRandomBetween(0.17f, 0.28f);
+            f->spin = FRandomBetween(0.f, 6.28f);
+            f->birth = now;
+            f->life = IRandomBetween(380, 620);
+            f->active = 1;
+        }
+    }
+    for (i = 0; i < FLAME_COUNT; i++) {
+        f = &gRocket.flames[i];
+        if (!f->active) {
+            continue;
+        }
+        t = (now - f->birth) / (br_scalar)f->life;
+        if (t >= 1.f) {
+            f->active = 0;
+            f->actor->render_style = BR_RSTYLE_NONE;
+            continue;
+        }
+        f->pos.v[0] += f->vel.v[0] * dt;
+        f->pos.v[1] += f->vel.v[1] * dt;
+        f->pos.v[2] += f->vel.v[2] * dt;
+        // Starts white-hot and cools as it rises, shrinking to a lick at the top
+        f->actor->material = gRocket.fireball[MIN(FIREBALL_FRAMES - 1, 1 + (int)(t * (FIREBALL_FRAMES - 1)))];
+        MeshBillboard(f->actor, &f->pos, f->size * (1.f - 0.55f * t), f->spin + t);
+        f->actor->render_style = BR_RSTYLE_FACES;
+    }
+}
