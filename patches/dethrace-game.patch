diff --git a/src/DETHRACE/common/shatter.c b/src/DETHRACE/common/shatter.c
new file mode 100644
index 0000000..a0928f7
--- /dev/null
+++ b/src/DETHRACE/common/shatter.c
@@ -0,0 +1,540 @@
+#include "shatter.h"
+#include "brender.h"
+#include "finteray.h"
+#include "formats.h"
+#include "globvars.h"
+#include "macros.h"
+#include "modmesh.h"
+#include "utility.h"
+#include "water.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/*
+ * Rubble: a broken surface is cut into chunks of its own textured triangles, given a back and broken edges so they
+ * look solid.
+ */
+
+#define SHARD_COUNT 64
+#define SHARD_MAX_TRIANGLES 160          // surface triangles per chunk
+#define SHARD_LIFE 30000                 // ms
+#define SHARD_GRAVITY (10.f / WORLD_SCALE)
+#define SHARD_GROUND_CHECK 100           // ms between ground lookups for a moving chunk
+#define CLUSTER_MAX_SEEDS 16
+
+typedef struct tShard {
+    br_actor* actor;
+    br_model* model;
+    br_vector3 pos;
+    br_vector3 vel;
+    br_vector3 axis;
+    br_scalar angle;
+    br_scalar spin;
+    br_scalar half_height; // below its centre, lying down
+    br_scalar ground;
+    tU32 birth;
+    tU32 next_ground_check;
+    int in_water;
+    int resting;
+    int active;
+} tShard;
+
+static struct {
+    br_actor* root;
+    br_material* rim;
+    tShard shards[SHARD_COUNT];
+    int next;
+    struct {
+        int broken;
+        int made;
+    } stats;
+} gShatter;
+
+br_material* ShatterRimMaterial(void) {
+    if (gShatter.rim == NULL) {
+        gShatter.rim = MeshMaterial("destruct_rim", 0);
+        gShatter.rim->flags |= BR_MATF_TWO_SIDED;
+        BrMaterialUpdate(gShatter.rim, BR_MATU_ALL);
+    }
+    return gShatter.rim;
+}
+
+static void Build(void) {
+    int i;
+
+    gShatter.root = BrActorAllocate(BR_ACTOR_NONE, NULL);
+    BrActorAdd(gNon_track_actor, gShatter.root);
+    for (i = 0; i < SHARD_COUNT; i++) {
+        gShatter.shards[i].actor = BrActorAllocate(BR_ACTOR_MODEL, NULL);
+        gShatter.shards[i].actor->render_style = BR_RSTYLE_NONE;
+        BrActorAdd(gShatter.root, gShatter.shards[i].actor);
+    }
+    ShatterRimMaterial();
+}
+
+static void FreeShard(tShard* pShard) {
+    pShard->active = 0;
+    pShard->actor->render_style = BR_RSTYLE_NONE;
+    pShard->actor->model = NULL;
+    if (pShard->model != NULL) {
+        BrModelRemove(pShard->model);
+        BrModelFree(pShard->model);
+        pShard->model = NULL;
+    }
+}
+
+static br_scalar GroundUnder(br_vector3* pPos) {
+    br_vector3 down = { { 0.f, -3.f, 0.f } };
+    br_vector3 start;
+    br_vector3 normal;
+    br_material* material;
+    br_scalar t;
+
+    start = *pPos;
+    start.v[1] += 0.3f;
+    FindFace(&start, &down, &normal, &t, &material);
+    return t <= 1.f ? start.v[1] - 3.f * t : pPos->v[1] - 10.f;
+}
+
+static void TriangleNormal(tShard_triangle* pT, br_vector3* pN) {
+    br_vector3 e1, e2;
+
+    BrVector3Sub(&e1, &pT->p[1], &pT->p[0]);
+    BrVector3Sub(&e2, &pT->p[2], &pT->p[0]);
+    BrVector3Cross(pN, &e1, &e2);
+}
+
+// Draw scale round the chunk's centre (under 1: smaller than the gap it leaves)
+static br_scalar gShard_scale = 1.f;
+
+static void SetVertex(br_vertex* pV, br_vector3* pP, br_vector3* pCentre, br_scalar pU, br_scalar pW, br_uint_8 pShade) {
+    memset(pV, 0, sizeof(*pV));
+    BrVector3Sub(&pV->p, pP, pCentre);
+    BrVector3Scale(&pV->p, &pV->p, gShard_scale);
+    BrVector2Set(&pV->map, pU, pW);
+    pV->red = pV->grn = pV->blu = pShade;
+}
+
+static int SameEdge(br_vector3* pA, br_vector3* pB, br_vector3* pC, br_vector3* pD) {
+    return (Vector3DistanceSquared(pA, pD) < 1e-10f && Vector3DistanceSquared(pB, pC) < 1e-10f)
+        || (Vector3DistanceSquared(pA, pC) < 1e-10f && Vector3DistanceSquared(pB, pD) < 1e-10f);
+}
+
+// The surface, a back pThickness behind it and the broken edges between them
+static void MakeShard(tShard_triangle** pTris, int pCount, br_vector3* pBlast, br_scalar pThickness, br_scalar pSpeed, br_scalar pScale) {
+    br_vector3 centre, normal, n, back[3], out, size_min, size_max;
+    br_model* model;
+    br_vertex* v;
+    br_face* f;
+    tShard* shard;
+    br_scalar area, a, len;
+    int nv, nf, edges;
+    int i, j, k, e, other;
+
+    gShard_scale = pScale;
+    BrVector3Set(&centre, 0.f, 0.f, 0.f);
+    BrVector3Set(&normal, 0.f, 0.f, 0.f);
+    area = 0.f;
+    for (i = 0; i < pCount; i++) {
+        TriangleNormal(pTris[i], &n);
+        a = BrVector3Length(&n);
+        BrVector3Accumulate(&normal, &n);
+        for (k = 0; k < 3; k++) {
+            BrVector3Scale(&out, &pTris[i]->p[k], a / 3.f);
+            BrVector3Accumulate(&centre, &out);
+        }
+        area += a;
+    }
+    if (area < 1e-10f) {
+        return;
+    }
+    BrVector3InvScale(&centre, &centre, area);
+    if (BrVector3LengthSquared(&normal) < 1e-12f) {
+        BrVector3Set(&normal, 0.f, 1.f, 0.f);
+    }
+    BrVector3Normalise(&normal, &normal);
+    BrVector3Scale(&out, &normal, -pThickness);
+
+    // Broken edges: those no other triangle of the chunk shares
+    edges = 0;
+    for (i = 0; i < pCount; i++) {
+        for (e = 0; e < 3; e++) {
+            for (other = 0; other < pCount; other++) {
+                if (other == i) {
+                    continue;
+                }
+                for (j = 0; j < 3; j++) {
+                    if (SameEdge(&pTris[i]->p[e], &pTris[i]->p[(e + 1) % 3], &pTris[other]->p[j], &pTris[other]->p[(j + 1) % 3])) {
+                        break;
+                    }
+                }
+                if (j < 3) {
+                    break;
+                }
+            }
+            edges += other == pCount;
+        }
+    }
+
+    nv = pCount * 6 + edges * 4;
+    nf = pCount * 2 + edges * 2;
+    model = BrModelAllocate("shard", nv, nf);
+    if (model == NULL) {
+        return;
+    }
+    memset(model->vertices, 0, nv * sizeof(br_vertex));
+    memset(model->faces, 0, nf * sizeof(br_face));
+    v = model->vertices;
+    f = model->faces;
+    BrVector3Set(&size_min, 1e9f, 1e9f, 1e9f);
+    BrVector3Set(&size_max, -1e9f, -1e9f, -1e9f);
+    nv = nf = 0;
+    for (i = 0; i < pCount; i++) {
+        for (k = 0; k < 3; k++) {
+            SetVertex(&v[nv + k], &pTris[i]->p[k], &centre, pTris[i]->map[k].v[0], pTris[i]->map[k].v[1], 255);
+            BrVector3Add(&back[k], &pTris[i]->p[k], &out);
+            for (j = 0; j < 3; j++) {
+                size_min.v[j] = MIN(size_min.v[j], v[nv + k].p.v[j]);
+                size_max.v[j] = MAX(size_max.v[j], v[nv + k].p.v[j]);
+            }
+        }
+        f[nf].vertices[0] = nv;
+        f[nf].vertices[1] = nv + 1;
+        f[nf].vertices[2] = nv + 2;
+        f[nf].material = pTris[i]->material;
+        nf++;
+        nv += 3;
+        for (k = 0; k < 3; k++) {
+            SetVertex(&v[nv + k], &back[2 - k], &centre, back[2 - k].v[0] * 6.f, back[2 - k].v[2] * 6.f + back[2 - k].v[1] * 6.f, 150);
+        }
+        f[nf].vertices[0] = nv;
+        f[nf].vertices[1] = nv + 1;
+        f[nf].vertices[2] = nv + 2;
+        f[nf].material = gShatter.rim;
+        nf++;
+        nv += 3;
+    }
+    for (i = 0; i < pCount; i++) {
+        for (e = 0; e < 3; e++) {
+            for (other = 0; other < pCount; other++) {
+                if (other == i) {
+                    continue;
+                }
+                for (j = 0; j < 3; j++) {
+                    if (SameEdge(&pTris[i]->p[e], &pTris[i]->p[(e + 1) % 3], &pTris[other]->p[j], &pTris[other]->p[(j + 1) % 3])) {
+                        break;
+                    }
+                }
+                if (j < 3) {
+                    break;
+                }
+            }
+            if (other < pCount) {
+                continue;
+            }
+            br_vector3* p0 = &pTris[i]->p[e];
+            br_vector3* p1 = &pTris[i]->p[(e + 1) % 3];
+            br_vector3 b0, b1;
+            BrVector3Add(&b0, p0, &out);
+            BrVector3Add(&b1, p1, &out);
+            len = sqrtf(Vector3DistanceSquared(p0, p1)) * 8.f;
+            SetVertex(&v[nv + 0], p1, &centre, 0.f, 0.f, 200);
+            SetVertex(&v[nv + 1], p0, &centre, len, 0.f, 200);
+            SetVertex(&v[nv + 2], &b0, &centre, len, 1.f, 120);
+            SetVertex(&v[nv + 3], &b1, &centre, 0.f, 1.f, 120);
+            f[nf].vertices[0] = nv;
+            f[nf].vertices[1] = nv + 1;
+            f[nf].vertices[2] = nv + 2;
+            f[nf].material = gShatter.rim;
+            nf++;
+            f[nf].vertices[0] = nv;
+            f[nf].vertices[1] = nv + 2;
+            f[nf].vertices[2] = nv + 3;
+            f[nf].material = gShatter.rim;
+            nf++;
+            nv += 4;
+        }
+    }
+    model->nvertices = nv;
+    model->nfaces = nf;
+    BrModelAdd(model);
+
+    shard = &gShatter.shards[gShatter.next];
+    gShatter.next = (gShatter.next + 1) % SHARD_COUNT;
+    FreeShard(shard);
+    shard->model = model;
+    shard->actor->model = model;
+    shard->actor->material = gShatter.rim;
+    shard->pos = centre;
+    BrVector3Sub(&shard->vel, &centre, pBlast);
+    if (BrVector3LengthSquared(&shard->vel) < 1e-8f) {
+        shard->vel = normal;
+    }
+    BrVector3Normalise(&shard->vel, &shard->vel);
+    BrVector3Scale(&shard->vel, &shard->vel, pSpeed * FRandomBetween(0.5f, 1.2f));
+    shard->vel.v[0] += SRandomPosNeg(pSpeed * 0.3f);
+    shard->vel.v[1] += FRandomBetween(0.3f, 1.f) * pSpeed;
+    shard->vel.v[2] += SRandomPosNeg(pSpeed * 0.3f);
+    BrVector3Set(&shard->axis, SRandomPosNeg(1.f), SRandomPosNeg(1.f), SRandomPosNeg(1.f));
+    if (BrVector3LengthSquared(&shard->axis) < 1e-4f) {
+        BrVector3Set(&shard->axis, 1.f, 0.f, 0.f);
+    }
+    BrVector3Normalise(&shard->axis, &shard->axis);
+    shard->angle = 0.f;
+    shard->spin = SRandomPosNeg(9.f);
+    // About its smallest size, but at least its thickness
+    shard->half_height = MAX(pThickness, 0.35f * MIN(size_max.v[0] - size_min.v[0], MIN(size_max.v[1] - size_min.v[1], size_max.v[2] - size_min.v[2])));
+    shard->ground = GroundUnder(&centre);
+    shard->birth = GetTotalTime();
+    shard->next_ground_check = shard->birth + SHARD_GROUND_CHECK;
+    shard->resting = 0;
+    shard->in_water = 0;
+    shard->active = 1;
+    gShatter.stats.made++;
+}
+
+void ShatterTriangles(tShard_triangle* pTriangles, int pCount, br_vector3* pBlast, int pPieces, br_scalar pThickness, br_scalar pSpeed, br_scalar pScale) {
+    static tShard_triangle* cluster[SHARD_MAX_TRIANGLES];
+    br_vector3 seeds[CLUSTER_MAX_SEEDS];
+    br_vector3 c;
+    int* owner;
+    br_scalar d, best_d;
+    int s, i, k, n, best;
+
+    if (pCount <= 0) {
+        return;
+    }
+    if (gShatter.root == NULL) {
+        Build();
+    }
+    gShatter.stats.broken++;
+    owner = malloc(pCount * sizeof(int));
+    if (owner == NULL) {
+        return;
+    }
+    // Random seed triangles; every triangle joins the nearest, giving irregular pieces
+    pPieces = MAX(1, MIN(MIN(pPieces, CLUSTER_MAX_SEEDS), pCount));
+    for (s = 0; s < pPieces; s++) {
+        i = IRandomBetween(0, pCount - 1);
+        BrVector3Add(&seeds[s], &pTriangles[i].p[0], &pTriangles[i].p[1]);
+        BrVector3Accumulate(&seeds[s], &pTriangles[i].p[2]);
+        BrVector3Scale(&seeds[s], &seeds[s], 1.f / 3.f);
+    }
+    for (i = 0; i < pCount; i++) {
+        BrVector3Add(&c, &pTriangles[i].p[0], &pTriangles[i].p[1]);
+        BrVector3Accumulate(&c, &pTriangles[i].p[2]);
+        BrVector3Scale(&c, &c, 1.f / 3.f);
+        best = 0;
+        best_d = 1e30f;
+        for (s = 0; s < pPieces; s++) {
+            d = Vector3DistanceSquared(&c, &seeds[s]);
+            if (d < best_d) {
+                best_d = d;
+                best = s;
+            }
+        }
+        owner[i] = best;
+    }
+    for (s = 0; s < pPieces; s++) {
+        n = 0;
+        for (i = 0; i < pCount && n < SHARD_MAX_TRIANGLES; i++) {
+            if (owner[i] == s) {
+                cluster[n++] = &pTriangles[i];
+            }
+        }
+        if (n > 0) {
+            MakeShard(cluster, n, pBlast, pThickness * FRandomBetween(0.7f, 1.3f), pSpeed, pScale);
+        }
+    }
+    (void)k;
+    free(owner);
+}
+
+// Triangles of an actor and its children, in world space
+typedef struct {
+    tShard_triangle* tris;
+    int count;
+    int max;
+} tGather;
+
+static void GatherModel(br_actor* pActor, br_model* pModel, br_material* pMaterial, tGather* pGather) {
+    struct v11model* v11;
+    struct v11group* g;
+    br_matrix34 m;
+    tShard_triangle* t;
+    int i, k, f;
+
+    BrActorToActorMatrix34(&m, pActor, gUniverse_actor);
+    if (pModel->faces != NULL && pModel->vertices != NULL) {
+        for (f = 0; f < pModel->nfaces && pGather->count < pGather->max; f++) {
+            t = &pGather->tris[pGather->count++];
+            for (k = 0; k < 3; k++) {
+                BrMatrix34ApplyP(&t->p[k], &pModel->vertices[pModel->faces[f].vertices[k]].p, &m);
+                t->map[k] = pModel->vertices[pModel->faces[f].vertices[k]].map;
+            }
+            t->material = pModel->faces[f].material != NULL ? pModel->faces[f].material : pMaterial;
+        }
+        return;
+    }
+    v11 = pModel->prepared;
+    if (v11 == NULL) {
+        return;
+    }
+    for (i = 0; i < v11->ngroups; i++) {
+        g = &v11->groups[i];
+        for (f = 0; f < g->nfaces && pGather->count < pGather->max; f++) {
+            t = &pGather->tris[pGather->count++];
+            for (k = 0; k < 3; k++) {
+                br_vector3 p;
+                BrVector3Add(&p, &g->position[g->vertex_numbers[f].v[k]], &pModel->pivot);
+                BrMatrix34ApplyP(&t->p[k], &p, &m);
+                t->map[k] = g->map[g->vertex_numbers[f].v[k]];
+            }
+            t->material = g->user != NULL ? g->user : pMaterial;
+        }
+    }
+}
+
+static void GatherActor(br_actor* pActor, br_material* pMaterial, tGather* pGather) {
+    br_actor* child;
+    br_material* material;
+
+    material = pActor->material != NULL ? pActor->material : pMaterial;
+    if (pActor->type == BR_ACTOR_MODEL && pActor->model != NULL && pActor->render_style != BR_RSTYLE_NONE) {
+        GatherModel(pActor, pActor->model, material, pGather);
+    }
+    for (child = pActor->children; child != NULL; child = child->next) {
+        GatherActor(child, material, pGather);
+    }
+}
+
+int ShatterActor(br_actor* pActor, br_vector3* pBlast, br_scalar pSpeed) {
+    static tShard_triangle tris[600];
+    tGather gather;
+    br_vector3 lo, hi;
+    br_scalar size;
+    int before, i, k;
+
+    gather.tris = tris;
+    gather.count = 0;
+    gather.max = COUNT_OF(tris);
+    GatherActor(pActor, NULL, &gather);
+    if (gather.count == 0) {
+        return 0;
+    }
+    BrVector3Set(&lo, 1e9f, 1e9f, 1e9f);
+    BrVector3Set(&hi, -1e9f, -1e9f, -1e9f);
+    for (i = 0; i < gather.count; i++) {
+        for (k = 0; k < 3; k++) {
+            lo.v[0] = MIN(lo.v[0], tris[i].p[k].v[0]);
+            lo.v[1] = MIN(lo.v[1], tris[i].p[k].v[1]);
+            lo.v[2] = MIN(lo.v[2], tris[i].p[k].v[2]);
+            hi.v[0] = MAX(hi.v[0], tris[i].p[k].v[0]);
+            hi.v[1] = MAX(hi.v[1], tris[i].p[k].v[1]);
+            hi.v[2] = MAX(hi.v[2], tris[i].p[k].v[2]);
+        }
+    }
+    size = MAX(hi.v[0] - lo.v[0], MAX(hi.v[1] - lo.v[1], hi.v[2] - lo.v[2]));
+    before = gShatter.stats.made;
+    // Props are closed shapes, so their pieces only need a thin back
+    ShatterTriangles(tris, gather.count, pBlast, (int)MIN(10.f, 3.f + size * 12.f), 0.006f, pSpeed, 1.f);
+    return gShatter.stats.made - before;
+}
+
+void MungeShatter(tU32 pFrame_period) {
+    br_vector3 at;
+    br_scalar water;
+    br_scalar dt;
+    br_scalar scale;
+    br_scalar age;
+    br_matrix34 m;
+    tShard* s;
+    tU32 now;
+    int i;
+
+    if (gShatter.root == NULL) {
+        return;
+    }
+    now = GetTotalTime();
+    dt = pFrame_period / 1000.f;
+    for (i = 0; i < SHARD_COUNT; i++) {
+        s = &gShatter.shards[i];
+        if (!s->active) {
+            continue;
+        }
+        age = (br_scalar)(now - s->birth);
+        if (age >= SHARD_LIFE) {
+            FreeShard(s);
+            continue;
+        }
+        if (!s->resting) {
+            s->vel.v[1] -= SHARD_GRAVITY * dt;
+            BrVector3Scale(&s->vel, &s->vel, MAX(0.f, 1.f - 0.3f * dt));
+            s->pos.v[0] += s->vel.v[0] * dt;
+            s->pos.v[1] += s->vel.v[1] * dt;
+            s->pos.v[2] += s->vel.v[2] * dt;
+            s->angle += s->spin * dt;
+            if (WaterSurfaceAt(&s->pos, &water) && s->pos.v[1] < water) {
+                if (!s->in_water) {
+                    s->in_water = 1;
+                    BrVector3Set(&at, s->pos.v[0], water, s->pos.v[2]);
+                    WaterSplash(&at, MIN(0.6f, 0.15f + fabsf(s->vel.v[1]) * 0.3f));
+                }
+                s->vel.v[1] += ((water - s->pos.v[1]) * 30.f - s->vel.v[1] * 4.f) * dt;
+                s->vel.v[0] *= MAX(0.f, 1.f - 2.f * dt);
+                s->vel.v[2] *= MAX(0.f, 1.f - 2.f * dt);
+                s->spin *= MAX(0.f, 1.f - 2.f * dt);
+            }
+            if (now >= s->next_ground_check) {
+                s->ground = GroundUnder(&s->pos);
+                s->next_ground_check = now + SHARD_GROUND_CHECK;
+            }
+            if (s->pos.v[1] - s->half_height < s->ground && s->vel.v[1] < 0.f) {
+                s->pos.v[1] = s->ground + s->half_height;
+                s->vel.v[1] *= -0.25f;
+                s->vel.v[0] *= 0.5f;
+                s->vel.v[2] *= 0.5f;
+                s->spin *= 0.4f;
+                if (BrVector3LengthSquared(&s->vel) < 0.05f * 0.05f) {
+                    s->resting = 1;
+                }
+            }
+            if (s->pos.v[1] < s->ground - 5.f) {
+                FreeShard(s); // fell out of the world
+                continue;
+            }
+        }
+        scale = age > SHARD_LIFE - 1000 ? (SHARD_LIFE - age) / 1000.f : 1.f;
+        BrMatrix34Rotate(&m, BrRadianToAngle(s->angle), &s->axis);
+        BrMatrix34PreScale(&m, scale, scale, scale);
+        BrMatrix34PostTranslate(&m, s->pos.v[0], s->pos.v[1], s->pos.v[2]);
+        s->actor->t.t.mat = m;
+        s->actor->render_style = BR_RSTYLE_FACES;
+    }
+}
+
+void ShatterReset(void) {
+    int i;
+
+    if (gShatter.root == NULL) {
+        return;
+    }
+    for (i = 0; i < SHARD_COUNT; i++) {
+        FreeShard(&gShatter.shards[i]);
+    }
+    memset(&gShatter.stats, 0, sizeof(gShatter.stats));
+}
+
+void ShatterDumpState(void) {
+    int i, active, resting;
+
+    active = resting = 0;
+    for (i = 0; i < SHARD_COUNT; i++) {
+        active += gShatter.shards[i].active;
+        resting += gShatter.shards[i].active && gShatter.shards[i].resting;
+    }
+    printf("[state] shatter broken %d, pieces made %d, lying about %d (%d at rest)\n", gShatter.stats.broken, gShatter.stats.made, active,
+        resting);
+}
