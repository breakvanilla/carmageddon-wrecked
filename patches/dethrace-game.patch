+static struct {
+    int built;
+    br_actor* launcher;
+    br_actor* tube_rockets[ROCKET_TUBES]; // loaded rockets, seen from the front
+    int tube_loaded[ROCKET_TUBES];
+    tU32 tube_emptied[ROCKET_TUBES];
+    int next_tube;
+    tU32 last_fire;
+    int key_was_down;
+    br_scalar size; // car width
+    br_actor* root; // rockets in flight, smoke and fireballs, all in world space, drawn after the track
+    br_model* sprite_model;
+    tRocket rockets[ROCKET_COUNT];
+    tPuff puffs[PUFF_COUNT];
+    int next_puff;
+    tBlast blasts[BLAST_COUNT];
+    int next_blast;
+    tFlame flames[FLAME_COUNT];
+    int next_flame;
+    tU32 last_flame;
+    br_material* fireball[FIREBALL_FRAMES];
+    br_material* smoke[2][SMOKE_LEVELS];
+    tRocket_light lights[LIGHT_COUNT];
+    int light_count;
+    tU32 race; // gRace_serial of the race the state belongs to
+    br_vector3 last_blast;
+    struct {
+        int fired;
+        int exploded;
+        int hit_track;
+        int hit_car;
+        int hit_ped;
+        int hit_water;
