diff --git a/src/DETHRACE/common/deform.c b/src/DETHRACE/common/deform.c
new file mode 100644
index 0000000..19b6c5e
--- /dev/null
+++ b/src/DETHRACE/common/deform.c
@@ -0,0 +1,1295 @@
+#include "deform.h"
+#include "brender.h"
+#include "car.h"
+#include "formats.h"
+#include "globvars.h"
+#include "macros.h"
+#include "modmesh.h"
+#include "shatter.h"
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+/*
+ * Explosions dent the track by editing its models in place; rendering and collision share the prepared model data.
+ * Track models keep only their prepared form, so a model's faces and vertices are rebuilt from it on its first dent.
+ * Faces near the blast are cut into small triangles, then vertices within the radius are pushed away from the centre.
+ *
+ * No cracks: whether an edge is split depends only on its end points, so faces either side (in any model) split it
+ * the same way, and unsplit edges are too far away to move. A big face with the blast over its middle gets a new
+ * vertex nearest the blast instead, which only changes its inside.
+ */
+
+#define DEFORM_MAX_MODELS 48
+#define DEFORM_MAX_COUNT 65000            // per model (the prepared data counts with 16 bits)
+#define DEFORM_MAX_NEW_FACES 9000         // per explosion
+#define DEFORM_RACE_FACE_BUDGET 200000    // per race
+#define DEFORM_SPLIT_FACTOR 1.08f         // edges are cut within this much of the radius
+#define DEFORM_EDGE_FACTOR 0.25f          // shortest edge, as a fraction of the radius (a car collides with up
+                                          // to CAR_MAX_COLLISION_FACES faces, so craters can't be too fine)
+#define DEFORM_CRATER_COUNT 64            // per race; repeated blasts in one spot dig less
+#define HOLE_FACTOR 0.75f                 // walls within this much of the radius are blown out
+#define WALL_THICKNESS 0.05f              // world units, about 35 cm
+#define MAX_BROKEN 1200                   // triangles blown out of walls per blast
+#define MAX_ROAD_CHUNKS 150               // road triangles thrown out of a crater
+#define SCORCH_COUNT 16
+#define SCORCH_MAX_FACES 2400
+#define EDGE_TABLE_SIZE (1 << 16)
+
+typedef struct tDeform_mesh {
+    br_actor* actor;
+    br_model* model;
+    br_vertex* v;
+    br_face* f;
+    int nv;
+    int nf;
+    int cap_v;
+    int cap_f;
+} tDeform_mesh;
+
+static struct {
+    br_actor* root;  // scorch marks
+    br_actor* scorch[SCORCH_COUNT];
+    br_vector3 craters[DEFORM_CRATER_COUNT];
+    int crater_count;
+    int next_crater;
+    int next_scorch;
+    int race_new_faces;
+    struct {
+        int explosions;
+        int dented;
+        int models;
+        int faces_added;
+        br_scalar open_before; // see OpenEdgeLength()
+        br_scalar open_after;
+        int skipped;
+        int lost_prepared;
+        int seams_fixed;
+        int holes;
+        int faces_blown_out;
+        int corners_joined;
+        br_scalar deepest;
+        float slowest_ms;
+    } stats;
+} gDeform;
+
+// Current blast
+static br_vector3 gCentre;
+static br_scalar gRadius;
+static br_scalar gSplit_radius;
+static br_scalar gMax_edge;
+
+static tDeform_mesh gMeshes[DEFORM_MAX_MODELS];
+static br_material* gCavity_material; // behind holes in solid walls
+static int gMesh_count;
+static int gNew_faces;
+
+static struct {
+    br_uint_32 key;
+    int value;
+} gEdge_table[EDGE_TABLE_SIZE];
+
+static br_scalar SegmentDistance2(br_vector3* pP, br_vector3* pA, br_vector3* pB) {
+    br_vector3 ab;
+    br_vector3 ap;
+    br_vector3 q;
+    br_scalar t;
+    br_scalar len2;
+
+    BrVector3Sub(&ab, pB, pA);
+    BrVector3Sub(&ap, pP, pA);
+    len2 = BrVector3LengthSquared(&ab);
+    t = len2 > 0.f ? BrVector3Dot(&ap, &ab) / len2 : 0.f;
+    t = MAX(0.f, MIN(1.f, t));
+    BrVector3Scale(&q, &ab, t);
+    BrVector3Accumulate(&q, pA);
+    return Vector3DistanceSquared(&q, pP);
+}
+
+static int PointBefore(br_vector3* pP, br_vector3* pQ) {
+    int k;
+
+    for (k = 0; k < 3; k++) {
+        if (pP->v[k] != pQ->v[k]) {
+            return pP->v[k] < pQ->v[k];
+        }
+    }
+    return 0;
+}
+
+// End points in a fixed order, so faces either side of an edge agree to the last bit
+static int EdgeQualifies(br_vector3* pA, br_vector3* pB) {
+    if (PointBefore(pB, pA)) {
+        br_vector3* t = pA;
+        pA = pB;
+        pB = t;
+    }
+    return Vector3DistanceSquared(pA, pB) > gMax_edge * gMax_edge
+        && SegmentDistance2(&gCentre, pA, pB) < gSplit_radius * gSplit_radius;
+}
+
+static int Grow(tDeform_mesh* pMesh, int pVertices, int pFaces) {
+    void* p;
+
+    if (pMesh->nv + pVertices > DEFORM_MAX_COUNT || pMesh->nf + pFaces > DEFORM_MAX_COUNT) {
+        return 0;
+    }
+    if (pMesh->nv + pVertices > pMesh->cap_v) {
+        pMesh->cap_v = MAX(pMesh->cap_v * 2, pMesh->nv + pVertices + 256);
+        p = realloc(pMesh->v, pMesh->cap_v * sizeof(br_vertex));
+        if (p == NULL) {
+            return 0;
+        }
+        pMesh->v = p;
+    }
+    if (pMesh->nf + pFaces > pMesh->cap_f) {
+        pMesh->cap_f = MAX(pMesh->cap_f * 2, pMesh->nf + pFaces + 256);
+        p = realloc(pMesh->f, pMesh->cap_f * sizeof(br_face));
+        if (p == NULL) {
+            return 0;
+        }
+        pMesh->f = p;
+    }
+    return 1;
+}
+
+// Editable copy of a model's mesh, rebuilt from the prepared data if needed
+static int LoadMesh(tDeform_mesh* pMesh) {
+    struct v11model* v11;
+    struct v11group* g;
+    br_model* model;
+    br_vertex* v;
+    br_face* f;
+    br_colour c;
+    int nv, nf, base;
+    int i, k;
+
+    model = pMesh->model;
+    pMesh->nv = pMesh->nf = 0;
+    if (model->vertices != NULL && model->faces != NULL) {
+        if (!Grow(pMesh, model->nvertices, model->nfaces)) {
+            return 0;
+        }
+        memcpy(pMesh->v, model->vertices, model->nvertices * sizeof(br_vertex));
+        memcpy(pMesh->f, model->faces, model->nfaces * sizeof(br_face));
+        pMesh->nv = model->nvertices;
+        pMesh->nf = model->nfaces;
+        return 1;
+    }
+    v11 = model->prepared;
+    if (v11 == NULL) {
+        return 0;
+    }
+    nv = nf = 0;
+    for (i = 0; i < v11->ngroups; i++) {
+        nv += v11->groups[i].nvertices;
+        nf += v11->groups[i].nfaces;
+    }
+    if (!Grow(pMesh, nv, nf)) {
+        return 0;
+    }
+    for (i = 0; i < v11->ngroups; i++) {
+        g = &v11->groups[i];
+        base = pMesh->nv;
+        for (k = 0; k < g->nvertices; k++) {
+            v = &pMesh->v[pMesh->nv++];
+            memset(v, 0, sizeof(*v));
+            BrVector3Add(&v->p, &g->position[k], &model->pivot);
+            v->map = g->map[k];
+            c = g->vertex_colours != NULL ? g->vertex_colours[k] : 0;
+            v->red = BR_RED(c);
+            v->grn = BR_GRN(c);
+            v->blu = BR_BLU(c);
+            v->index = BR_ALPHA(c);
+        }
+        for (k = 0; k < g->nfaces; k++) {
+            f = &pMesh->f[pMesh->nf++];
+            memset(f, 0, sizeof(*f));
+            f->vertices[0] = base + g->vertex_numbers[k].v[0];
+            f->vertices[1] = base + g->vertex_numbers[k].v[1];
+            f->vertices[2] = base + g->vertex_numbers[k].v[2];
+            // Vertices are already split at shading seams, so one smoothing group keeps the normals
+            f->smoothing = 1;
+            f->material = g->user;
+            f->flags = g->face_flags != NULL ? g->face_flags[k] : 0;
+            c = g->face_colours != NULL ? g->face_colours[k] : 0;
+            f->red = BR_RED(c);
+            f->grn = BR_GRN(c);
+            f->blu = BR_BLU(c);
+            f->index = BR_ALPHA(c);
+        }
+    }
+    return 1;
+}
+
+static void BlendVertex(br_vertex* pOut, br_vertex* pA, br_vertex* pB, br_vertex* pC, br_scalar pU, br_scalar pV, br_scalar pW) {
+    memset(pOut, 0, sizeof(*pOut));
+    pOut->p.v[0] = pA->p.v[0] * pU + pB->p.v[0] * pV + pC->p.v[0] * pW;
+    pOut->p.v[1] = pA->p.v[1] * pU + pB->p.v[1] * pV + pC->p.v[1] * pW;
+    pOut->p.v[2] = pA->p.v[2] * pU + pB->p.v[2] * pV + pC->p.v[2] * pW;
+    pOut->map.v[0] = pA->map.v[0] * pU + pB->map.v[0] * pV + pC->map.v[0] * pW;
+    pOut->map.v[1] = pA->map.v[1] * pU + pB->map.v[1] * pV + pC->map.v[1] * pW;
+    pOut->red = (br_uint_8)(pA->red * pU + pB->red * pV + pC->red * pW);
+    pOut->grn = (br_uint_8)(pA->grn * pU + pB->grn * pV + pC->grn * pW);
+    pOut->blu = (br_uint_8)(pA->blu * pU + pB->blu * pV + pC->blu * pW);
+    pOut->index = pA->index;
+}
+
+// Shared by the faces either side when they share the end points
+static int Midpoint(tDeform_mesh* pMesh, int pA, int pB) {
+    br_uint_32 key;
+    br_vertex mid;
+    int slot;
+
+    key = ((br_uint_32)MIN(pA, pB) << 16) | (br_uint_32)MAX(pA, pB);
+    slot = (int)((key * 2654435761u) >> 16) & (EDGE_TABLE_SIZE - 1);
+    while (gEdge_table[slot].value >= 0) {
+        if (gEdge_table[slot].key == key) {
+            return gEdge_table[slot].value;
+        }
+        slot = (slot + 1) & (EDGE_TABLE_SIZE - 1);
+    }
+    if (!Grow(pMesh, 1, 0)) {
+        return -1;
+    }
+    // a * 0.5 + b * 0.5 is the same either way round, so faces either side (in any model) get exactly the same point
+    BlendVertex(&mid, &pMesh->v[pA], &pMesh->v[pB], &pMesh->v[pA], 0.5f, 0.5f, 0.f);
+    pMesh->v[pMesh->nv] = mid;
+    gEdge_table[slot].key = key;
+    gEdge_table[slot].value = pMesh->nv;
+    return pMesh->nv++;
+}
+
+static int SplitFace(tDeform_mesh* pMesh, int pFace, int pEdge) {
+    br_face face;
+    int a, b, c, mid;
+
+    face = pMesh->f[pFace];
+    a = face.vertices[pEdge];
+    b = face.vertices[(pEdge + 1) % 3];
+    c = face.vertices[(pEdge + 2) % 3];
+    mid = Midpoint(pMesh, a, b);
+    if (mid < 0 || !Grow(pMesh, 0, 1)) {
+        return 0;
+    }
+    face.flags &= ~(BR_FACEF_COPLANAR_0 | BR_FACEF_COPLANAR_1 | BR_FACEF_COPLANAR_2);
+    pMesh->f[pFace] = face;
+    pMesh->f[pFace].vertices[0] = a;
+    pMesh->f[pFace].vertices[1] = mid;
+    pMesh->f[pFace].vertices[2] = c;
+    pMesh->f[pMesh->nf] = face;
+    pMesh->f[pMesh->nf].vertices[0] = mid;
+    pMesh->f[pMesh->nf].vertices[1] = b;
+    pMesh->f[pMesh->nf].vertices[2] = c;
+    pMesh->nf++;
+    gNew_faces++;
+    return 1;
+}
+
+// Big face with the blast over its middle: new vertex nearest the blast, joined to the corners
+static int FanInsert(tDeform_mesh* pMesh, int pFace, int* pInserted) {
+    br_vector3* a;
+    br_vector3* b;
+    br_vector3* c;
+    br_vector3 ab, ac, ap, n;
+    br_scalar d00, d01, d11, d20, d21, denom, u, v, w;
+    br_face face;
+    int vi;
+
+    *pInserted = 0;
+    face = pMesh->f[pFace];
+    a = &pMesh->v[face.vertices[0]].p;
+    b = &pMesh->v[face.vertices[1]].p;
+    c = &pMesh->v[face.vertices[2]].p;
+    if (Vector3DistanceSquared(a, b) <= gMax_edge * gMax_edge && Vector3DistanceSquared(b, c) <= gMax_edge * gMax_edge
+        && Vector3DistanceSquared(c, a) <= gMax_edge * gMax_edge) {
+        return 1;
+    }
+    BrVector3Sub(&ab, b, a);
+    BrVector3Sub(&ac, c, a);
+    BrVector3Cross(&n, &ab, &ac);
+    if (BrVector3LengthSquared(&n) < 1e-12f) {
+        return 1;
+    }
+    BrVector3Normalise(&n, &n);
+    BrVector3Sub(&ap, &gCentre, a);
+    if (fabsf(BrVector3Dot(&ap, &n)) >= gRadius) {
+        return 1;
+    }
+    // Barycentric coordinates of the blast centre projected on the face
+    d00 = BrVector3Dot(&ab, &ab);
+    d01 = BrVector3Dot(&ab, &ac);
+    d11 = BrVector3Dot(&ac, &ac);
+    d20 = BrVector3Dot(&ap, &ab);
+    d21 = BrVector3Dot(&ap, &ac);
+    denom = d00 * d11 - d01 * d01;
+    if (fabsf(denom) < 1e-12f) {
+        return 1;
+    }
+    v = (d11 * d20 - d01 * d21) / denom;
+    w = (d00 * d21 - d01 * d20) / denom;
+    u = 1.f - v - w;
+    if (u < 0.02f || v < 0.02f || w < 0.02f) {
+        return 1; // an edge is nearer, and it's either cut or too short to matter
+    }
+    if (!Grow(pMesh, 1, 2)) {
+        return 0;
+    }
+    vi = pMesh->nv++;
+    BlendVertex(&pMesh->v[vi], &pMesh->v[face.vertices[0]], &pMesh->v[face.vertices[1]], &pMesh->v[face.vertices[2]], u, v, w);
+    face.flags &= ~(BR_FACEF_COPLANAR_0 | BR_FACEF_COPLANAR_1 | BR_FACEF_COPLANAR_2);
+    pMesh->f[pFace] = face;
+    pMesh->f[pFace].vertices[2] = vi;
+    pMesh->f[pMesh->nf] = face;
+    pMesh->f[pMesh->nf].vertices[0] = vi;
+    pMesh->nf++;
+    pMesh->f[pMesh->nf] = face;
+    pMesh->f[pMesh->nf].vertices[1] = vi;
+    pMesh->nf++;
+    gNew_faces += 2;
+    *pInserted = 1;
+    return 1;
+}
+
+static int SplitFaceAt(tDeform_mesh* pMesh, int pFace, int pEdge, br_vector3* pPoint, br_scalar pT) {
+    br_face face;
+    int a, b, c, vi;
+
+    face = pMesh->f[pFace];
+    a = face.vertices[pEdge];
+    b = face.vertices[(pEdge + 1) % 3];
+    c = face.vertices[(pEdge + 2) % 3];
+    if (!Grow(pMesh, 1, 1)) {
+        return 0;
+    }
+    vi = pMesh->nv++;
+    BlendVertex(&pMesh->v[vi], &pMesh->v[a], &pMesh->v[b], &pMesh->v[a], 1.f - pT, pT, 0.f);
+    pMesh->v[vi].p = *pPoint;
+    face.flags &= ~(BR_FACEF_COPLANAR_0 | BR_FACEF_COPLANAR_1 | BR_FACEF_COPLANAR_2);
+    pMesh->f[pFace] = face;
+    pMesh->f[pFace].vertices[0] = a;
+    pMesh->f[pFace].vertices[1] = vi;
+    pMesh->f[pFace].vertices[2] = c;
+    pMesh->f[pMesh->nf] = face;
+    pMesh->f[pMesh->nf].vertices[0] = vi;
+    pMesh->f[pMesh->nf].vertices[1] = b;
+    pMesh->f[pMesh->nf].vertices[2] = c;
+    pMesh->nf++;
+    gNew_faces++;
+    return 1;
+}
+
+/*
+ * Track seams aren't exact (corners a hair apart, T-junctions), so dented sides would crack apart. Near the blast,
+ * corners closer than SEAM_TOLERANCE are joined and edges are split at other faces' corners lying on them.
+ */
+#define SEAM_TOLERANCE 1e-3f
+#define SEAM_MIN_PIECE 3e-3f              // shortest sliver split off
+#define SEAM_MAX_SPLITS 400               // per blast; the rest would only crack hairline thin
+static br_vector3* gSeam_points;
+static int gSeam_point_count;
+
+static int ComparePointsX(const void* pA, const void* pB) {
+    br_scalar a = (*(br_vector3* const*)pA)->v[0];
+    br_scalar b = (*(br_vector3* const*)pB)->v[0];
+
+    return a < b ? -1 : a > b;
+}
+
+static int CollectSeamPoints(void) {
+    br_vector3** order;
+    br_vector3* p;
+    br_vector3* q;
+    br_scalar r2;
+    int m, i, j, n;
+
+    r2 = gSplit_radius * gSplit_radius * 1.5f;
+    n = 0;
+    for (m = 0; m < gMesh_count; m++) {
+        n += gMeshes[m].nv;
+    }
+    gSeam_points = malloc(MAX(1, n) * sizeof(br_vector3));
+    order = malloc(MAX(1, n) * sizeof(br_vector3*));
+    if (gSeam_points == NULL || order == NULL) {
+        free(order);
+        return 0;
+    }
+    n = 0;
+    for (m = 0; m < gMesh_count; m++) {
+        for (i = 0; i < gMeshes[m].nv; i++) {
+            if (Vector3DistanceSquared(&gMeshes[m].v[i].p, &gCentre) < r2) {
+                order[n++] = &gMeshes[m].v[i].p;
+            }
+        }
+    }
+        qsort(order, n, sizeof(br_vector3*), ComparePointsX);
+    for (i = 0; i < n; i++) {
+        p = order[i];
+        for (j = i - 1; j >= 0 && p->v[0] - order[j]->v[0] < SEAM_TOLERANCE; j--) {
+            q = order[j];
+            if (Vector3DistanceSquared(p, q) < SEAM_TOLERANCE * SEAM_TOLERANCE) {
+                if (p->v[0] != q->v[0] || p->v[1] != q->v[1] || p->v[2] != q->v[2]) {
+                    *p = *q;
+                    gDeform.stats.corners_joined++;
+                }
+                break;
+            }
+        }
+    }
+    gSeam_point_count = 0;
+    for (i = 0; i < n; i++) {
+        gSeam_points[gSeam_point_count++] = *order[i];
+    }
+    free(order);
+    return 1;
+}
+
+static int RepairSeams(tDeform_mesh* pMesh) {
+    br_vector3* a;
+    br_vector3* b;
+    br_vector3* r;
+    br_vector3 ab, ar, closest;
+    br_scalar r2, len2, len, t;
+    int fi, k, i;
+    int split;
+    int splits;
+
+    r2 = gSplit_radius * gSplit_radius * 1.5f;
+    splits = 0;
+    for (fi = 0; fi < pMesh->nf; fi++) {
+        do {
+            split = 0;
+            for (k = 0; k < 3 && !split; k++) {
+                a = &pMesh->v[pMesh->f[fi].vertices[k]].p;
+                b = &pMesh->v[pMesh->f[fi].vertices[(k + 1) % 3]].p;
+                if (SegmentDistance2(&gCentre, a, b) > r2) {
+                    continue;
+                }
+                BrVector3Sub(&ab, b, a);
+                len2 = BrVector3LengthSquared(&ab);
+                // Short edges are our own conforming cuts; T-junctions come from the track's long edges
+                if (len2 <= gMax_edge * gMax_edge) {
+                    continue;
+                }
+                len = sqrtf(len2);
+                for (i = 0; i < gSeam_point_count; i++) {
+                    r = &gSeam_points[i];
+                    BrVector3Sub(&ar, r, a);
+                    t = BrVector3Dot(&ar, &ab) / len2;
+                    if (t * len < SEAM_MIN_PIECE || (1.f - t) * len < SEAM_MIN_PIECE) {
+                        continue;
+                    }
+                    BrVector3Scale(&closest, &ab, t);
+                    BrVector3Accumulate(&closest, a);
+                    if (Vector3DistanceSquared(&closest, r) < SEAM_TOLERANCE * SEAM_TOLERANCE * 0.04f) {
+                        if (++splits > SEAM_MAX_SPLITS) {
+                            return 1;
+                        }
+                        if (gNew_faces > DEFORM_MAX_NEW_FACES || !SplitFaceAt(pMesh, fi, k, r, t)) {
+                            return 0;
+                        }
+                        gDeform.stats.seams_fixed++;
+                        split = 1;
+                        break;
+                    }
+                }
+            }
+        } while (split);
+    }
+    return 1;
+}
+
+static int Refine(tDeform_mesh* pMesh) {
+    br_face* f;
+    br_scalar len2, best_len2;
+    int fi, k, best;
+    int inserted;
+    int i;
+
+    for (i = 0; i < EDGE_TABLE_SIZE; i++) {
+        gEdge_table[i].value = -1;
+    }
+    for (fi = 0; fi < pMesh->nf; fi++) {
+        for (;;) {
+            if (gNew_faces > DEFORM_MAX_NEW_FACES) {
+                return 0;
+            }
+            f = &pMesh->f[fi];
+            best = -1;
+            best_len2 = 0.f;
+            for (k = 0; k < 3; k++) {
+                br_vector3* a = &pMesh->v[f->vertices[k]].p;
+                br_vector3* b = &pMesh->v[f->vertices[(k + 1) % 3]].p;
+                if (EdgeQualifies(a, b)) {
+                    len2 = Vector3DistanceSquared(a, b);
+                    if (len2 > best_len2) {
+                        best_len2 = len2;
+                        best = k;
+                    }
+                }
+            }
+            if (best >= 0) {
+                if (!SplitFace(pMesh, fi, best)) {
+                    return 0;
+                }
+                continue;
+            }
+            if (!FanInsert(pMesh, fi, &inserted)) {
+                return 0;
+            }
+            if (!inserted) {
+                break;
+            }
+        }
+    }
+    return 1;
+}
+
+// Fixed per position, so copies of a vertex in different models move together
+static br_scalar PositionNoise(br_vector3* pP) {
+    br_uint_32 h;
+
+    h = (br_uint_32)(int)floorf(pP->v[0] * 1000.f) * 73856093u ^ (br_uint_32)(int)floorf(pP->v[1] * 1000.f) * 19349663u
+        ^ (br_uint_32)(int)floorf(pP->v[2] * 1000.f) * 83492791u;
+    h ^= h >> 13;
+    h *= 0x5bd1e995u;
+    h ^= h >> 15;
+    return (h & 0xffff) / 65535.f;
+}
+
+// Water surfaces ("!" materials, see FindFace()) aren't dented or scorched
+static int IsWater(br_face* pFace) {
+    return pFace->material != NULL && pFace->material->identifier != NULL && pFace->material->identifier[0] == '!';
+}
+
+static void Displace(tDeform_mesh* pMesh, br_scalar pDepth) {
+    br_vector3 dir;
+    br_scalar d, t, amount;
+    char* water;
+    int i, k;
+
+    water = calloc(MAX(1, pMesh->nv), 1);
+    if (water == NULL) {
+        return;
+    }
+    for (i = 0; i < pMesh->nf; i++) {
+        if (IsWater(&pMesh->f[i])) {
+            for (k = 0; k < 3; k++) {
+                water[pMesh->f[i].vertices[k]] = 1;
+            }
+        }
+    }
+    for (i = 0; i < pMesh->nv; i++) {
+        if (water[i]) {
+            continue;
+        }
+        BrVector3Sub(&dir, &pMesh->v[i].p, &gCentre);
+        d = BrVector3Length(&dir);
+        if (d >= gRadius || d < 1e-5f) {
+            continue;
+        }
+        t = d / gRadius;
+        amount = pDepth * (1.f - t * t) * (1.f - t * t) * (0.7f + 0.6f * PositionNoise(&pMesh->v[i].p));
+        BrVector3Scale(&dir, &dir, amount / d);
+        BrVector3Accumulate(&pMesh->v[i].p, &dir);
+        gDeform.stats.deepest = MAX(gDeform.stats.deepest, amount);
+    }
+    free(water);
+}
+
+// Length of edges near the blast used by only one face. The track's own open edges measure the same after cutting;
+// a crack adds to it.
+typedef struct tEdge_key {
+    uint64_t key;
+    float length;
+} tEdge_key;
+
+static int CompareEdgeKeys(const void* pA, const void* pB) {
+    uint64_t a = ((const tEdge_key*)pA)->key;
+    uint64_t b = ((const tEdge_key*)pB)->key;
+
+    return a < b ? -1 : a > b;
+}
+
+static uint64_t PointKey(br_vector3* pP) {
+    return ((uint64_t)((int64_t)floorf(pP->v[0] * 2000.f + 0.5f) & 0x1fffff) << 42)
+        | ((uint64_t)((int64_t)floorf(pP->v[1] * 2000.f + 0.5f) & 0x1fffff) << 21)
+        | (uint64_t)((int64_t)floorf(pP->v[2] * 2000.f + 0.5f) & 0x1fffff);
+}
+
+static br_scalar LengthInside(br_vector3* pA, br_vector3* pB, br_vector3* pCentre, br_scalar pRadius) {
+    br_vector3 d, f;
+    br_scalar a, b, c, disc, t0, t1;
+
+    BrVector3Sub(&d, pB, pA);
+    BrVector3Sub(&f, pA, pCentre);
+    a = BrVector3Dot(&d, &d);
+    b = 2.f * BrVector3Dot(&f, &d);
+    c = BrVector3Dot(&f, &f) - pRadius * pRadius;
+    disc = b * b - 4.f * a * c;
+    if (a < 1e-12f || disc <= 0.f) {
+        return 0.f;
+    }
+    disc = sqrtf(disc);
+    t0 = MAX(0.f, (-b - disc) / (2.f * a));
+    t1 = MIN(1.f, (-b + disc) / (2.f * a));
+    return t1 > t0 ? (t1 - t0) * sqrtf(a) : 0.f;
+}
+
+static br_scalar OpenEdgeLength(void) {
+    tEdge_key* keys;
+    uint64_t a, b;
+    br_vector3* p;
+    br_vector3* q;
+    br_scalar region;
+    br_scalar open;
+    int n, cap;
+    int m, fi, k, i, j;
+
+    region = gSplit_radius * 1.2f;
+    cap = 0;
+    for (m = 0; m < gMesh_count; m++) {
+        cap += gMeshes[m].nf * 3;
+    }
+    keys = malloc(MAX(1, cap) * sizeof(tEdge_key));
+    if (keys == NULL) {
+        return 0.f;
+    }
+    n = 0;
+    for (m = 0; m < gMesh_count; m++) {
+        for (fi = 0; fi < gMeshes[m].nf; fi++) {
+            for (k = 0; k < 3; k++) {
+                p = &gMeshes[m].v[gMeshes[m].f[fi].vertices[k]].p;
+                q = &gMeshes[m].v[gMeshes[m].f[fi].vertices[(k + 1) % 3]].p;
+                if (SegmentDistance2(&gCentre, p, q) >= region * region) {
+                    continue;
+                }
+                a = PointKey(p);
+                b = PointKey(q);
+                // Same key either way round
+                keys[n].key = (MIN(a, b) * 0x9e3779b97f4a7c15ull) ^ (MAX(a, b) + 0x632be59bd9b4e019ull + (MIN(a, b) << 6));
+                keys[n].length = LengthInside(p, q, &gCentre, region);
+                n++;
+            }
+        }
+    }
+    qsort(keys, n, sizeof(tEdge_key), CompareEdgeKeys);
+    open = 0.f;
+    for (i = 0; i < n; i = j) {
+        for (j = i + 1; j < n && keys[j].key == keys[i].key; j++) {
+        }
+        if (j - i == 1) {
+            open += keys[i].length;
+        }
+    }
+    free(keys);
+    return open;
+}
+
+// Costs a few milliseconds, so only on request (tools/test_game.sh sets it)
+static int CrackCheck(void) {
+    static int enabled = -1;
+
+    if (enabled < 0) {
+        enabled = getenv("CARMA_DEFORM_CHECK") != NULL;
+    }
+    return enabled;
+}
+
+static int IsIdentity(br_matrix34* pM) {
+    int i, k;
+
+    for (i = 0; i < 4; i++) {
+        for (k = 0; k < 3; k++) {
+            if (fabsf(pM->m[i][k] - (i == k ? 1.f : 0.f)) > 1e-5f) {
+                return 0;
+            }
+        }
+    }
+    return 1;
+}
+
+// Knockable props (&NN actors) aren't track surface, and many share one model
+static int IsProp(br_actor* pActor) {
+    for (; pActor != NULL && pActor != gTrack_actor; pActor = pActor->parent) {
+        if (pActor->identifier != NULL && pActor->identifier[0] == '&' && pActor->identifier[1] >= '0' && pActor->identifier[1] <= '9') {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static br_uintptr_t CollectCB(br_actor* pActor, void* pArg) {
+    br_matrix34 m;
+    br_bounds* b;
+    br_scalar r;
+    int k;
+
+    if (pActor->render_style == BR_RSTYLE_NONE || IsProp(pActor)) {
+        return 0;
+    }
+    if (pActor->type == BR_ACTOR_MODEL && pActor->model != NULL && pActor->model->prepared != NULL && gMesh_count < DEFORM_MAX_MODELS) {
+        b = &pActor->model->bounds;
+        r = gSplit_radius;
+        for (k = 0; k < 3; k++) {
+            if (gCentre.v[k] < b->min.v[k] - r || gCentre.v[k] > b->max.v[k] + r) {
+                break;
+            }
+        }
+        if (k == 3) {
+            BrActorToActorMatrix34(&m, pActor, gUniverse_actor);
+            if (IsIdentity(&m)) {
+                gMeshes[gMesh_count].actor = pActor;
+                gMeshes[gMesh_count].model = pActor->model;
+                gMesh_count++;
+            } else {
+                gDeform.stats.skipped++;
+            }
+        }
+    }
+    BrActorEnum(pActor, CollectCB, pArg);
+    return 0;
+}
+
+static void Commit(tDeform_mesh* pMesh) {
+    struct v11model* v11;
+    br_model* model;
+    br_vertex* v;
+    br_face* f;
+    int g;
+
+    model = pMesh->model;
+    v = BrResAllocate(model, pMesh->nv * sizeof(br_vertex), BR_MEMORY_VERTICES);
+    f = BrResAllocate(model, pMesh->nf * sizeof(br_face), BR_MEMORY_FACES);
+    memcpy(v, pMesh->v, pMesh->nv * sizeof(br_vertex));
+    memcpy(f, pMesh->f, pMesh->nf * sizeof(br_face));
+    if (model->vertices != NULL) {
+        BrResFree(model->vertices);
+    }
+    if (model->faces != NULL) {
+        BrResFree(model->faces);
+    }
+    model->vertices = v;
+    model->faces = f;
+    model->nvertices = pMesh->nv;
+    model->nfaces = pMesh->nf;
+    model->flags |= BR_MODF_UPDATEABLE | BR_MODF_DONT_WELD;
+    BrModelUpdate(model, BR_MODU_ALL);
+    v11 = model->prepared;
+    if (v11 == NULL) {
+        gDeform.stats.lost_prepared++;
+        return;
+    }
+    // The game finds a face's material through its group (see LoadTrack())
+    for (g = 0; g < v11->ngroups; g++) {
+        v11->groups[g].user = model->faces[v11->groups[g].face_user[0]].material;
+    }
+}
+
+// Copies of the faces near the blast, lifted off them a little
+static void AddScorch(br_scalar pRadius, br_material* pMaterial) {
+    br_vector3 normal_sum;
+    br_vector3 plane;
+    br_vector3 t, b, helper;
+    br_vector3 ft, fb;
+    int axis;
+    br_vector3 e1, e2, n, centroid, to_centre, offset, rel;
+    br_vector3* p[3];
+    br_model* model;
+    br_actor* actor;
+    br_scalar r2;
+    int count;
+    int m, fi, k, pass;
+
+    r2 = pRadius * pRadius;
+    BrVector3Set(&normal_sum, 0.f, 0.f, 0.f);
+    count = 0;
+    model = NULL;
+    // Pass 0 counts faces and finds the texture projection plane; pass 1 builds the model
+    for (pass = 0; pass < 2; pass++) {
+        if (pass == 1) {
+            if (count == 0) {
+                return;
+            }
+            if (BrVector3LengthSquared(&normal_sum) < 1e-8f) {
+                BrVector3Set(&normal_sum, 0.f, 1.f, 0.f);
+            }
+            BrVector3Normalise(&plane, &normal_sum);
+            if (fabsf(plane.v[1]) < 0.9f) {
+                BrVector3Set(&helper, 0.f, 1.f, 0.f);
+            } else {
+                BrVector3Set(&helper, 1.f, 0.f, 0.f);
+            }
+            BrVector3Cross(&t, &plane, &helper);
+            BrVector3Normalise(&t, &t);
+            BrVector3Cross(&b, &plane, &t);
+            model = BrModelAllocate("deform_scorch", count * 3, count);
+            if (model == NULL) {
+                return;
+            }
+            memset(model->vertices, 0, count * 3 * sizeof(br_vertex));
+            memset(model->faces, 0, count * sizeof(br_face));
+            count = 0;
+        }
+        for (m = 0; m < gMesh_count; m++) {
+            for (fi = 0; fi < gMeshes[m].nf; fi++) {
+                // Hole edges and cavity are already dark
+                if (IsWater(&gMeshes[m].f[fi]) || gMeshes[m].f[fi].material == ShatterRimMaterial()
+                    || (gCavity_material != NULL && gMeshes[m].f[fi].material == gCavity_material)) {
+                    continue;
+                }
+                for (k = 0; k < 3; k++) {
+                    p[k] = &gMeshes[m].v[gMeshes[m].f[fi].vertices[k]].p;
+                }
+                if (Vector3DistanceSquared(p[0], &gCentre) > r2 && Vector3DistanceSquared(p[1], &gCentre) > r2
+                    && Vector3DistanceSquared(p[2], &gCentre) > r2) {
+                    continue;
+                }
+                BrVector3Sub(&e1, p[1], p[0]);
+                BrVector3Sub(&e2, p[2], p[0]);
+                BrVector3Cross(&n, &e1, &e2);
+                if (BrVector3LengthSquared(&n) < 1e-14f) {
+                    continue;
+                }
+                BrVector3Add(&centroid, p[0], p[1]);
+                BrVector3Accumulate(&centroid, p[2]);
+                BrVector3Scale(&centroid, &centroid, 1.f / 3.f);
+                BrVector3Sub(&to_centre, &gCentre, &centroid);
+                // Only the side facing the blast
+                if (BrVector3Dot(&n, &to_centre) <= 0.f) {
+                    continue;
+                }
+                if (pass == 0) {
+                    BrVector3Accumulate(&normal_sum, &n);
+                    count++;
+                    continue;
+                }
+                if (count >= SCORCH_MAX_FACES) {
+                    continue;
+                }
+                BrVector3Normalise(&n, &n);
+                // Faces steep to the blast's plane use their own main axis, or the mark smears into streaks
+                if (fabsf(BrVector3Dot(&n, &plane)) > 0.5f) {
+                    ft = t;
+                    fb = b;
+                } else {
+                    axis = fabsf(n.v[0]) > fabsf(n.v[1]) ? (fabsf(n.v[0]) > fabsf(n.v[2]) ? 0 : 2) : (fabsf(n.v[1]) > fabsf(n.v[2]) ? 1 : 2);
+                    BrVector3Set(&ft, 0.f, 0.f, 0.f);
+                    BrVector3Set(&fb, 0.f, 0.f, 0.f);
+                    ft.v[(axis + 1) % 3] = 1.f;
+                    fb.v[(axis + 2) % 3] = 1.f;
+                }
+                for (k = 0; k < 3; k++) {
+                    br_vertex* v = &model->vertices[count * 3 + k];
+                    // Towards the blast, so a corner moves the same in every face that has it: no gaps
+                    BrVector3Sub(&offset, &gCentre, p[k]);
+                    if (BrVector3LengthSquared(&offset) > 1e-10f) {
+                        BrVector3Normalise(&offset, &offset);
+                    }
+                    BrVector3Scale(&offset, &offset, 0.004f);
+                    BrVector3Add(&v->p, p[k], &offset);
+                    BrVector3Sub(&rel, p[k], &gCentre);
+                    v->map.v[0] = MAX(0.f, MIN(1.f, 0.5f + BrVector3Dot(&rel, &ft) / (2.f * pRadius)));
+                    v->map.v[1] = MAX(0.f, MIN(1.f, 0.5f + BrVector3Dot(&rel, &fb) / (2.f * pRadius)));
+                    v->red = v->grn = v->blu = 255;
+                    model->faces[count].vertices[k] = count * 3 + k;
+                }
+                model->faces[count].smoothing = 1;
+                count++;
+            }
+        }
+        if (pass == 0) {
+            count = MIN(count, SCORCH_MAX_FACES);
+        }
+    }
+    model->nfaces = count;
+    model->nvertices = count * 3;
+    BrModelAdd(model);
+
+    actor = gDeform.scorch[gDeform.next_scorch];
+    gDeform.next_scorch = (gDeform.next_scorch + 1) % SCORCH_COUNT;
+    if (actor->model != NULL) {
+        BrModelRemove(actor->model);
+        BrModelFree(actor->model);
+    }
+    actor->model = model;
+    actor->material = pMaterial;
+    actor->render_style = BR_RSTYLE_FACES;
+}
+
+void DeformReset(void) {
+    int i;
+
+    if (gDeform.root == NULL) {
+        gDeform.root = BrActorAllocate(BR_ACTOR_NONE, NULL);
+        BrActorAdd(gNon_track_actor, gDeform.root);
+        for (i = 0; i < SCORCH_COUNT; i++) {
+            gDeform.scorch[i] = BrActorAllocate(BR_ACTOR_MODEL, NULL);
+            gDeform.scorch[i]->render_style = BR_RSTYLE_NONE;
+            BrActorAdd(gDeform.root, gDeform.scorch[i]);
+        }
+    }
+    for (i = 0; i < SCORCH_COUNT; i++) {
+        gDeform.scorch[i]->render_style = BR_RSTYLE_NONE;
+    }
+    gDeform.race_new_faces = 0;
+    gDeform.crater_count = 0;
+    gDeform.next_crater = 0;
+    memset(&gDeform.stats, 0, sizeof(gDeform.stats));
+}
+
+/*
+ * Holes in walls (never floors, so nothing falls out of the world). Broken faces line the hole's edges, and a dark
+ * cavity behind a solid wall hides the hollow inside of buildings. Two-sided things like fences just get a hole.
+ */
+static tShard_triangle gBroken[MAX_BROKEN];
+static int gBroken_count;
+static tShard_triangle gRoad_chunks[MAX_ROAD_CHUNKS];
+static int gRoad_chunk_count;
+
+typedef struct tHole_edge {
+    uint64_t key;
+    br_vector3 normal; // of the blown-out wall face beside it
+} tHole_edge;
+
+static tHole_edge* gHole_edges;
+static int gHole_edge_count;
+static int gHole_edge_max;
+
+static uint64_t EdgeKey(br_vector3* pA, br_vector3* pB) {
+    uint64_t a = PointKey(pA);
+    uint64_t b = PointKey(pB);
+
+    return (MIN(a, b) * 0x9e3779b97f4a7c15ull) ^ (MAX(a, b) + 0x632be59bd9b4e019ull + (MIN(a, b) << 6));
+}
+
+static int CompareHoleEdges(const void* pA, const void* pB) {
+    uint64_t a = ((const tHole_edge*)pA)->key;
+    uint64_t b = ((const tHole_edge*)pB)->key;
+
+    return a < b ? -1 : a > b;
+}
+
+static int FaceNormal(tDeform_mesh* pMesh, br_face* pFace, br_vector3* pN, br_vector3* pCentroid) {
+    br_vector3 e1, e2;
+    br_vector3* a = &pMesh->v[pFace->vertices[0]].p;
+    br_vector3* b = &pMesh->v[pFace->vertices[1]].p;
+    br_vector3* c = &pMesh->v[pFace->vertices[2]].p;
+
+    BrVector3Sub(&e1, b, a);
+    BrVector3Sub(&e2, c, a);
+    BrVector3Cross(pN, &e1, &e2);
+    if (BrVector3LengthSquared(pN) < 1e-14f) {
+        return 0;
+    }
+    BrVector3Normalise(pN, pN);
+    if (pCentroid != NULL) {
+        BrVector3Add(pCentroid, a, b);
+        BrVector3Accumulate(pCentroid, c);
+        BrVector3Scale(pCentroid, pCentroid, 1.f / 3.f);
+    }
+    return 1;
+}
+
+static void CopyTriangle(tDeform_mesh* pMesh, br_face* pFace, tShard_triangle* pOut) {
+    int k;
+
+    for (k = 0; k < 3; k++) {
+        pOut->p[k] = pMesh->v[pFace->vertices[k]].p;
+        pOut->map[k] = pMesh->v[pFace->vertices[k]].map;
+    }
+    pOut->material = pFace->material;
+}
+
+// Copies: the crater keeps its surface
+static void CollectRoadChunks(tDeform_mesh* pMesh) {
+    br_vector3 n, c;
+    int fi;
+
+    for (fi = 0; fi < pMesh->nf && gRoad_chunk_count < MAX_ROAD_CHUNKS; fi++) {
+        if (IsWater(&pMesh->f[fi]) || !FaceNormal(pMesh, &pMesh->f[fi], &n, &c) || fabsf(n.v[1]) < 0.7f) {
+            continue;
+        }
+        if (Vector3DistanceSquared(&c, &gCentre) < gRadius * gRadius * 0.15f) {
+            CopyTriangle(pMesh, &pMesh->f[fi], &gRoad_chunks[gRoad_chunk_count++]);
+        }
+    }
+}
+
+static int AddFace(tDeform_mesh* pMesh, br_vector3* pA, br_vector3* pB, br_vector3* pC, br_vector2* pUv, br_material* pMaterial, br_uint_8 pShade) {
+    br_vector3* p[3];
+    int k;
+
+    if (!Grow(pMesh, 3, 1)) {
+        return 0;
+    }
+    p[0] = pA;
+    p[1] = pB;
+    p[2] = pC;
+    for (k = 0; k < 3; k++) {
+        memset(&pMesh->v[pMesh->nv + k], 0, sizeof(br_vertex));
+        pMesh->v[pMesh->nv + k].p = *p[k];
+        pMesh->v[pMesh->nv + k].map = pUv[k];
+        pMesh->v[pMesh->nv + k].red = pMesh->v[pMesh->nv + k].grn = pMesh->v[pMesh->nv + k].blu = pShade;
+    }
+    memset(&pMesh->f[pMesh->nf], 0, sizeof(br_face));
+    pMesh->f[pMesh->nf].vertices[0] = pMesh->nv;
+    pMesh->f[pMesh->nf].vertices[1] = pMesh->nv + 1;
+    pMesh->f[pMesh->nf].vertices[2] = pMesh->nv + 2;
+    pMesh->f[pMesh->nf].material = pMaterial;
+    pMesh->f[pMesh->nf].smoothing = 1;
+    pMesh->nv += 3;
+    pMesh->nf++;
+    gNew_faces++;
+    return 1;
+}
+
+static void CutHoles(void) {
+    br_vector3 n, c, centre, normal_sum, axis1, axis2, helper, p0, p1;
+    br_vector2 uv[3];
+    br_scalar hole, spread, d;
+    tDeform_mesh* m;
+    tDeform_mesh* cavity_mesh;
+    tHole_edge key;
+    tHole_edge* found;
+    int solid;
+    int fi, k, i, kept;
+
+    hole = gRadius * HOLE_FACTOR;
+    gHole_edge_count = 0;
+    BrVector3Set(&centre, 0.f, 0.f, 0.f);
+    BrVector3Set(&normal_sum, 0.f, 0.f, 0.f);
+    solid = 0;
+    cavity_mesh = NULL;
+
+    for (i = 0; i < gMesh_count; i++) {
+        m = &gMeshes[i];
+        kept = 0;
+        for (fi = 0; fi < m->nf; fi++) {
+            br_face* f = &m->f[fi];
+            // Near upright only (earlier craters' sides are much less steep)
+            if (!IsWater(f) && FaceNormal(m, f, &n, &c) && fabsf(n.v[1]) < 0.3f && gBroken_count < MAX_BROKEN
+                && Vector3DistanceSquared(&c, &gCentre) < hole * hole * (0.55f + 0.9f * PositionNoise(&c))) {
+                CopyTriangle(m, f, &gBroken[gBroken_count++]);
+                for (k = 0; k < 3 && gHole_edge_count < gHole_edge_max; k++) {
+                    gHole_edges[gHole_edge_count].key = EdgeKey(&m->v[f->vertices[k]].p, &m->v[f->vertices[(k + 1) % 3]].p);
+                    gHole_edges[gHole_edge_count].normal = n;
+                    gHole_edge_count++;
+                }
+                BrVector3Accumulate(&centre, &c);
+                BrVector3Accumulate(&normal_sum, &n);
+                if (f->material == NULL || !(f->material->flags & BR_MATF_TWO_SIDED)) {
+                    solid = 1;
+                    cavity_mesh = m;
+                }
+                continue;
+            }
+            m->f[kept++] = *f;
+        }
+        m->nf = kept;
+    }
+    if (gBroken_count == 0) {
+        return;
+    }
+    gDeform.stats.holes++;
+    gDeform.stats.faces_blown_out += gBroken_count;
+    qsort(gHole_edges, gHole_edge_count, sizeof(tHole_edge), CompareHoleEdges);
+
+    for (i = 0; i < gMesh_count; i++) {
+        m = &gMeshes[i];
+        kept = m->nf;
+        for (fi = 0; fi < kept; fi++) {
+            for (k = 0; k < 3; k++) {
+                br_vector3 a = m->v[m->f[fi].vertices[k]].p;
+                br_vector3 b = m->v[m->f[fi].vertices[(k + 1) % 3]].p;
+                key.key = EdgeKey(&a, &b);
+                found = bsearch(&key, gHole_edges, gHole_edge_count, sizeof(tHole_edge), CompareHoleEdges);
+                if (found == NULL) {
+                    continue;
+                }
+                BrVector3Scale(&n, &found->normal, -WALL_THICKNESS);
+                BrVector3Add(&p0, &a, &n);
+                BrVector3Add(&p1, &b, &n);
+                d = sqrtf(Vector3DistanceSquared(&a, &b)) * 8.f;
+                BrVector2Set(&uv[0], 0.f, 0.f);
+                BrVector2Set(&uv[1], d, 0.f);
+                BrVector2Set(&uv[2], d, 1.f);
+                AddFace(m, &a, &b, &p1, uv, ShatterRimMaterial(), 190);
+                BrVector2Set(&uv[1], d, 1.f);
+                BrVector2Set(&uv[2], 0.f, 1.f);
+                AddFace(m, &a, &p1, &p0, uv, ShatterRimMaterial(), 190);
+            }
+        }
+    }
+
+    // Cavity: the blown-out faces set back by the wall's thickness, so it can't stick out past the wall
+    if (solid && cavity_mesh != NULL && BrVector3LengthSquared(&normal_sum) > 1e-8f) {
+        if (gCavity_material == NULL) {
+            gCavity_material = MeshMaterial("destruct_cavity", 0);
+            gCavity_material->flags |= BR_MATF_TWO_SIDED;
+            BrMaterialUpdate(gCavity_material, BR_MATU_ALL);
+        }
+        BrVector3InvScale(&centre, &centre, (br_scalar)gBroken_count);
+        BrVector3Normalise(&n, &normal_sum);
+        spread = 0.f;
+        for (i = 0; i < gBroken_count; i++) {
+            for (k = 0; k < 3; k++) {
+                spread = MAX(spread, sqrtf(Vector3DistanceSquared(&gBroken[i].p[k], &centre)));
+            }
+        }
+        spread += 0.05f;
+        if (fabsf(n.v[1]) < 0.9f) {
+            BrVector3Set(&helper, 0.f, 1.f, 0.f);
+        } else {
+            BrVector3Set(&helper, 1.f, 0.f, 0.f);
+        }
+        BrVector3Cross(&axis1, &n, &helper);
+        BrVector3Normalise(&axis1, &axis1);
+        BrVector3Cross(&axis2, &n, &axis1);
+        for (i = 0; i < gBroken_count; i++) {
+            br_vector3 e1, e2, back[3];
+            br_material* material = gBroken[i].material;
+
+            if (material != NULL && (material->flags & BR_MATF_TWO_SIDED)) {
+                continue;
+            }
+            BrVector3Sub(&e1, &gBroken[i].p[1], &gBroken[i].p[0]);
+            BrVector3Sub(&e2, &gBroken[i].p[2], &gBroken[i].p[0]);
+            BrVector3Cross(&c, &e1, &e2);
+            if (BrVector3LengthSquared(&c) < 1e-14f) {
+                continue;
+            }
+            BrVector3Normalise(&c, &c);
+            BrVector3Scale(&c, &c, -WALL_THICKNESS);
+            for (k = 0; k < 3; k++) {
+                BrVector3Add(&back[k], &gBroken[i].p[k], &c);
+                BrVector3Sub(&p0, &gBroken[i].p[k], &centre);
+                BrVector2Set(&uv[k], 0.5f + 0.5f * BrVector3Dot(&p0, &axis1) / spread, 0.5f + 0.5f * BrVector3Dot(&p0, &axis2) / spread);
+            }
+            AddFace(cavity_mesh, &back[0], &back[1], &back[2], uv, gCavity_material, 255);
+        }
+    }
+}
+
+int DeformExplosion(br_vector3* pCentre, br_scalar pRadius, br_scalar pDepth, br_material* pScorch) {
+    clock_t start;
+    int ok;
+    int i;
+
+    if (gTrack_actor == NULL) {
+        return 0;
+    }
+    start = clock();
+    if (gDeform.root == NULL) {
+        DeformReset();
+    }
+    gDeform.stats.explosions++;
+    gCentre = *pCentre;
+    gRadius = pRadius;
+    gSplit_radius = pRadius * DEFORM_SPLIT_FACTOR;
+    gMax_edge = pRadius * DEFORM_EDGE_FACTOR;
+    gMesh_count = 0;
+    gNew_faces = 0;
+    BrActorEnum(gTrack_actor, CollectCB, NULL);
+
+    // Worked on copies, committed only if it all fits
+    ok = gMesh_count > 0 && gDeform.race_new_faces < DEFORM_RACE_FACE_BUDGET;
+    for (i = 0; ok && i < gMesh_count; i++) {
+        ok = LoadMesh(&gMeshes[i]);
+    }
+    ok = ok && CollectSeamPoints();
+    for (i = 0; ok && i < gMesh_count; i++) {
+        ok = RepairSeams(&gMeshes[i]);
+    }
+    free(gSeam_points);
+    gSeam_points = NULL;
+    if (ok && CrackCheck()) {
+        gDeform.stats.open_before += OpenEdgeLength();
+    }
+    for (i = 0; ok && i < gMesh_count; i++) {
+        ok = Refine(&gMeshes[i]);
+    }
+    if (ok) {
+        // Each earlier crater here halves the depth, so a salvo doesn't dig a pit
+        for (i = 0; i < gDeform.crater_count; i++) {
+            if (Vector3DistanceSquared(&gDeform.craters[i], &gCentre) < pRadius * pRadius) {
+                pDepth *= 0.5f;
+            }
+        }
+        gDeform.craters[gDeform.next_crater] = gCentre;
+        gDeform.next_crater = (gDeform.next_crater + 1) % DEFORM_CRATER_COUNT;
+        gDeform.crater_count = MIN(gDeform.crater_count + 1, DEFORM_CRATER_COUNT);
+        gRoad_chunk_count = 0;
+        for (i = 0; i < gMesh_count; i++) {
+            CollectRoadChunks(&gMeshes[i]);
+        }
+        // Holes before the dent, so earlier craters' sloping sides aren't taken for walls
+        gBroken_count = 0;
+        gHole_edge_max = MAX_BROKEN * 3;
+        gHole_edges = malloc(gHole_edge_max * sizeof(tHole_edge));
+        if (gHole_edges != NULL) {
+            CutHoles();
+            free(gHole_edges);
+            gHole_edges = NULL;
+        }
+        for (i = 0; i < gMesh_count; i++) {
+            Displace(&gMeshes[i], pDepth);
+        }
+        if (CrackCheck()) {
+            gDeform.stats.open_after += OpenEdgeLength();
+        }
+        for (i = 0; i < gMesh_count; i++) {
+            Commit(&gMeshes[i]);
+        }
+        // Cars' nearby-face lists point into the old prepared data: make them refetch
+        gFace_num__car += 2;
+        if (pScorch != NULL) {
+            AddScorch(pRadius * 1.1f, pScorch);
+        }
+                if (gBroken_count > 0) {
+            br_vector3 behind = { { 0.f, 0.f, 0.f } };
+            br_vector3 n;
+            for (i = 0; i < gBroken_count; i++) {
+                br_vector3 e1, e2, tn;
+                BrVector3Sub(&e1, &gBroken[i].p[1], &gBroken[i].p[0]);
+                BrVector3Sub(&e2, &gBroken[i].p[2], &gBroken[i].p[0]);
+                BrVector3Cross(&tn, &e1, &e2);
+                BrVector3Accumulate(&behind, &tn);
+            }
+            if (BrVector3LengthSquared(&behind) > 1e-12f) {
+                BrVector3Normalise(&n, &behind);
+            } else {
+                BrVector3Set(&n, 0.f, 1.f, 0.f);
+            }
+            BrVector3Scale(&behind, &n, -0.6f);
+            BrVector3Accumulate(&behind, &gCentre);
+            ShatterTriangles(gBroken, gBroken_count, &behind, MAX(4, MIN(14, gBroken_count / 6)), WALL_THICKNESS * 0.8f, 2.2f, 0.8f);
+        }
+        if (gRoad_chunk_count > 0) {
+            br_vector3 below = gCentre;
+            below.v[1] -= 0.6f;
+            ShatterTriangles(gRoad_chunks, gRoad_chunk_count, &below, MAX(4, MIN(12, gRoad_chunk_count / 4)), 0.03f, 2.6f, 0.45f);
+        }
+        gDeform.race_new_faces += gNew_faces;
+        gDeform.stats.dented++;
+        gDeform.stats.models += gMesh_count;
+        gDeform.stats.faces_added += gNew_faces;
+    }
+    for (i = 0; i < gMesh_count; i++) {
+        free(gMeshes[i].v);
+        free(gMeshes[i].f);
+        memset(&gMeshes[i], 0, sizeof(gMeshes[i]));
+    }
+    gDeform.stats.slowest_ms = MAX(gDeform.stats.slowest_ms, (float)(clock() - start) * 1000.f / CLOCKS_PER_SEC);
+    return ok;
+}
+
+void DeformDumpState(void) {
+    printf("[state] deform explosions %d dented %d, models edited %d, faces added %d, deepest %.3f, open edge length near blasts "
+           "%.3f before %.3f after, skipped (moved) models %d, lost prepared %d, seams joined %d, corners joined %d, slowest %.1f ms, holes %d (%d faces blown out)\n",
+        gDeform.stats.explosions, gDeform.stats.dented, gDeform.stats.models, gDeform.stats.faces_added, gDeform.stats.deepest,
+        gDeform.stats.open_before, gDeform.stats.open_after, gDeform.stats.skipped, gDeform.stats.lost_prepared, gDeform.stats.seams_fixed, gDeform.stats.corners_joined, gDeform.stats.slowest_ms, gDeform.stats.holes, gDeform.stats.faces_blown_out);
+}
diff --git a/src/DETHRACE/common/deform.h b/src/DETHRACE/common/deform.h
