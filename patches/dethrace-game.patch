+// Splashes, wakes and bubbles
+
+static br_material* WaterMaterial(char* pName, int pOpacity) {
+    br_material* material;
+    char name[32];
+
+    BrSprintfN(name, sizeof(name) - 1, "water_%s", pName);
+    material = MeshMaterial(name, 1);
+    MeshSetOpacity(material, pOpacity);
+    return material;
+}
+
+static void Build(void) {
+    br_vector3 n = { { 0.f, 0.f, 1.f } };
+    int i, b;
+
+    gWater.root = NewPart(gUniverse_actor, NULL, NULL);
+    MeshBegin();
+    b = gMesh.nvertices;
+    MeshVertex(-0.5f, -0.5f, 0.f, &n, 0.f, 1.f);
+    MeshVertex(0.5f, -0.5f, 0.f, &n, 1.f, 1.f);
+    MeshVertex(0.5f, 0.5f, 0.f, &n, 1.f, 0.f);
+    MeshVertex(-0.5f, 0.5f, 0.f, &n, 0.f, 0.f);
+    MeshQuad(b, b + 1, b + 2, b + 3);
+    for (i = 0; i < gMesh.nvertices; i++) {
+        gMesh.vertices[i].red = gMesh.vertices[i].grn = gMesh.vertices[i].blu = 255;
+    }
+    gWater.sprite_model = MeshModel("water_sprite");
+    for (i = 0; i < SPRAY_LEVELS; i++) {
+        gWater.spray[i] = WaterMaterial("spray", 230 * (i + 1) / SPRAY_LEVELS);
+    }
+    gWater.drop = WaterMaterial("drop", 235);
+    gWater.bubble = WaterMaterial("bubble", 200);
+    for (i = 0; i < PARTICLE_COUNT; i++) {
+        gWater.particles[i].actor = NewPart(gWater.root, gWater.sprite_model, gWater.drop);
+        gWater.particles[i].actor->render_style = BR_RSTYLE_NONE;
+    }
+}
+
+static void AddParticle(tParticle_type pType, br_vector3* pPos, br_vector3* pVel, br_scalar pSize, br_scalar pGrow, tU32 pLife) {
+    tParticle* p;
+
+    if (gWater.root == NULL) {
+        Build();
+    }
+    p = &gWater.particles[gWater.next_particle];
+    gWater.next_particle = (gWater.next_particle + 1) % PARTICLE_COUNT;
+    p->type = pType;
+    p->pos = *pPos;
+    p->vel = *pVel;
+    p->size = pSize;
+    p->grow = pGrow;
+    p->spin = FRandomBetween(0.f, 6.28f);
+    p->birth = GetTotalTime();
+    p->life = pLife;
+    p->active = 1;
+}
+
+int WaterCrossing(br_vector3* pFrom, br_vector3* pTo, br_vector3* pHit) {
+    br_scalar a, b, t;
+
+    if (gWater.face_count == 0 || !WaterSurfaceAt(pTo, &b) || !WaterSurfaceAt(pFrom, &a)) {
+        return 0;
+    }
+    a = pFrom->v[1] - a;
+    b = pTo->v[1] - b;
+    if (a < 0.f || b >= 0.f) {
+        return 0;
+    }
+    t = a / (a - b);
+    pHit->v[0] = pFrom->v[0] + (pTo->v[0] - pFrom->v[0]) * t;
+    pHit->v[1] = pFrom->v[1] + (pTo->v[1] - pFrom->v[1]) * t;
+    pHit->v[2] = pFrom->v[2] + (pTo->v[2] - pFrom->v[2]) * t;
+    return 1;
+}
+
+void WaterTestDive(void) {
+    tCar_spec* car;
+    tCar_water* state;
+    br_scalar surface;
+
+    WaterTestGoto();
+    car = &gProgram_state.current_car;
+    if (car->car_master_actor == NULL || !WaterSurfaceAt(&car->car_master_actor->t.t.translate.t, &surface)) {
+        return;
+    }
+    car->car_master_actor->t.t.translate.t.v[1] = surface - 0.5f;
+    InitialiseCar2(car, 0);
+    state = CarState(car);
+    if (state != NULL) {
+        state->flooded = 0.85f; // heavy, so it stays down
+    }
+    printf("[test] car put under the water\n");
+}
+
+void WaterSplash(br_vector3* pPos, br_scalar pStrength) {
+    br_vector3 v, p;
+    br_scalar a, speed;
+    int i, n;
+
+    gWater.stats.splashes++;
+    AddRipple(pPos, MIN(3.f, 0.6f + pStrength));
+    n = (int)(14 + 26 * MIN(3.f, pStrength));
+    for (i = 0; i < n; i++) {
+        a = FRandomBetween(0.f, 6.28f);
+        speed = FRandomBetween(0.2f, 0.7f) * (0.6f + 0.4f * pStrength);
+        BrVector3Set(&v, cosf(a) * speed, FRandomBetween(0.6f, 1.6f) * (0.5f + 0.5f * pStrength), sinf(a) * speed);
+        p = *pPos;
+        p.v[0] += cosf(a) * 0.04f;
+        p.v[2] += sinf(a) * 0.04f;
+        AddParticle(eParticle_drop, &p, &v, FRandomBetween(0.012f, 0.03f), 0.f, 2000);
+    }
+    n = (int)(5 + 8 * MIN(3.f, pStrength));
+    for (i = 0; i < n; i++) {
+        a = FRandomBetween(0.f, 6.28f);
+        BrVector3Set(&v, cosf(a) * FRandomBetween(0.1f, 0.4f), FRandomBetween(0.3f, 1.1f) * (0.5f + 0.5f * pStrength), sinf(a) * FRandomBetween(0.1f, 0.4f));
+        p = *pPos;
+        p.v[1] += 0.02f;
+        AddParticle(eParticle_spray, &p, &v, FRandomBetween(0.08f, 0.16f) * (0.7f + 0.3f * pStrength), 2.f, IRandomBetween(700, 1300));
+    }
+}
+
+static void MoveParticles(tU32 pFrame_period) {
+    tParticle* p;
+    br_scalar dt, t, surface, size;
+    tU32 now;
+    int level;
+    int i;
+
+    if (gWater.root == NULL) {
+        return;
+    }
+    now = GetTotalTime();
+    dt = pFrame_period / 1000.f;
+    for (i = 0; i < PARTICLE_COUNT; i++) {
+        p = &gWater.particles[i];
+        if (!p->active) {
+            continue;
+        }
+        t = (now - p->birth) / (br_scalar)p->life;
+        if (t >= 1.f) {
+            p->active = 0;
+            p->actor->render_style = BR_RSTYLE_NONE;
+            continue;
+        }
+        switch (p->type) {
+        case eParticle_bubble:
+            p->vel.v[0] += SRandomPosNeg(0.4f) * dt;
+            p->vel.v[2] += SRandomPosNeg(0.4f) * dt;
+            break;
+        case eParticle_spray:
+            p->vel.v[1] -= 10.f / WORLD_SCALE * 0.6f * dt;
+            BrVector3Scale(&p->vel, &p->vel, MAX(0.f, 1.f - 1.5f * dt));
+            break;
+        default:
+            p->vel.v[1] -= 10.f / WORLD_SCALE * dt;
+            break;
+        }
+        p->pos.v[0] += p->vel.v[0] * dt;
+        p->pos.v[1] += p->vel.v[1] * dt;
+        p->pos.v[2] += p->vel.v[2] * dt;
+        // Droplets end where they fall back in; bubbles where they come up
+        if (WaterSurfaceAt(&p->pos, &surface)) {
+            if ((p->type == eParticle_drop && p->vel.v[1] < 0.f && p->pos.v[1] < surface)
+                || (p->type == eParticle_bubble && p->pos.v[1] > surface - 0.01f)) {
+                p->active = 0;
+                p->actor->render_style = BR_RSTYLE_NONE;
+                continue;
+            }
+        }
+        size = p->size * (1.f + p->grow * sqrtf(t));
+        if (p->type == eParticle_spray) {
+            level = MIN(SPRAY_LEVELS - 1, (int)((1.f - t) * (1.f - t) * SPRAY_LEVELS));
+            p->actor->material = gWater.spray[level];
+        } else {
+            p->actor->material = p->type == eParticle_drop ? gWater.drop : gWater.bubble;
+        }
+        MeshBillboard(p->actor, &p->pos, size, p->spin + t);
+        p->actor->render_style = BR_RSTYLE_FACES;
+    }
+}
+
+static void MungeCars(void) {
+    static const tVehicle_type categories[] = { eVehicle_self, eVehicle_opponent, eVehicle_rozzer };
+    tCar_water* state;
+    tCar_spec* car;
+    br_matrix34* m;
+    br_vector3 pos, p, v;
+    br_scalar speed, side;
+    tU32 now;
+    int c, i, k, count, in;
+
+    now = GetTotalTime();
+    for (c = 0; c < COUNT_OF(categories); c++) {
+        count = categories[c] == eVehicle_self ? 1 : GetCarCount(categories[c]);
+        for (i = 0; i < count; i++) {
+            car = categories[c] == eVehicle_self ? &gProgram_state.current_car : GetCarSpec(categories[c], i);
+            if (car == NULL || car->car_master_actor == NULL) {
+                continue;
+            }
+            for (k = 0; k < CAR_STATE_COUNT && gWater.cars[k].car != car; k++) {
+            }
+            if (k == CAR_STATE_COUNT) {
+                continue;
+            }
+            state = &gWater.cars[k];
+            m = &car->car_master_actor->t.t.mat;
+            pos = car->car_master_actor->t.t.translate.t;
+            speed = BrVector3Length(&car->v);
+            in = state->submerged > 0.03f;
+            if (in && !state->was_in) {
+                        p = pos;
+                p.v[1] = state->surface;
+                WaterSplash(&p, MAX(0.4f, MIN(2.5f, fabsf(car->v.v[1]) / 4.f + speed / 25.f)));
+            }
+            state->was_in = in;
+            if (!in) {
+                continue;
+            }
+            if (state->submerged < 0.95f && speed > 2.f) {
+                if (now - state->last_wake >= WAKE_PERIOD) {
+                    state->last_wake = now;
+                    p = pos;
+                    p.v[0] += m->m[2][0] * car->bounds[0].max.v[2];
+                    p.v[2] += m->m[2][2] * car->bounds[0].max.v[2];
+                    AddRipple(&p, MIN(1.2f, speed / 20.f));
+                    gWater.stats.wake_ripples++;
+                }
+                if (now - state->last_spray >= 45) {
+                    state->last_spray = now;
+                    for (side = -1.f; side <= 1.f; side += 2.f) {
+                        p = pos;
+                        p.v[0] += m->m[0][0] * side * car->bounds[0].max.v[0] - m->m[2][0] * car->bounds[0].min.v[2] * 0.5f;
+                        p.v[2] += m->m[0][2] * side * car->bounds[0].max.v[0] - m->m[2][2] * car->bounds[0].min.v[2] * 0.5f;
+                        p.v[1] = state->surface + 0.01f;
+                        BrVector3Set(&v, m->m[0][0] * side * 0.3f, FRandomBetween(0.2f, 0.5f) * MIN(1.f, speed / 15.f), m->m[0][2] * side * 0.3f);
+                        AddParticle(eParticle_spray, &p, &v, FRandomBetween(0.05f, 0.09f), 1.5f, IRandomBetween(400, 700));
+                        BrVector3Set(&v, m->m[0][0] * side * FRandomBetween(0.2f, 0.5f), FRandomBetween(0.3f, 0.8f) * MIN(1.f, speed / 15.f), m->m[0][2] * side * FRandomBetween(0.2f, 0.5f));
+                        AddParticle(eParticle_drop, &p, &v, FRandomBetween(0.01f, 0.022f), 0.f, 1500);
+                    }
+                }
+            }
+            if (state->submerged > 0.6f && now - state->last_bubble >= BUBBLE_PERIOD) {
+                state->last_bubble = now;
+                p = pos;
+                p.v[0] += SRandomPosNeg(0.05f);
+                p.v[1] += car->bounds[0].max.v[1];
+                p.v[2] += SRandomPosNeg(0.05f);
+                BrVector3Set(&v, 0.f, FRandomBetween(0.25f, 0.45f), 0.f);
+                AddParticle(eParticle_bubble, &p, &v, FRandomBetween(0.012f, 0.03f), 0.3f, 4000);
+                gWater.stats.bubbles++;
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+
+static void Reset(void) {
+    int i;
+
+    if (gWater.root != NULL) {
+        for (i = 0; i < PARTICLE_COUNT; i++) {
+            gWater.particles[i].active = 0;
+            gWater.particles[i].actor->render_style = BR_RSTYLE_NONE;
+        }
+    }
+    memset(gWater.ripples, 0, sizeof(gWater.ripples));
+    memset(gWater.cars, 0, sizeof(gWater.cars));
+    memset(&gWater.stats, 0, sizeof(gWater.stats));
+    gWater.start_time = GetTotalTime();
+    gWater.camera_under = 0;
+    gWater.race = gRace_serial;
+    FindWater();
+}
+
+void MungeWater(tU32 pFrame_period) {
+    if (!gProgram_state.racing) {
+        if (gWater.race != 0) {
+            gWater.race = 0;
+            gWater.face_count = 0;
+#ifdef DETHRACE_3DFX_PATCH
+            GLREND_ClearWaterMaterials();
+#endif
+        }
+        return;
+    }
+    if (gWater.race != gRace_serial) {
+        Reset();
+    }
+    gWater.time = (GetTotalTime() - gWater.start_time) / 1000.f;
+    if (gWater.face_count == 0) {
+        return;
+    }
+    if (!gAction_replay_mode) {
+        MungeCars();
+    }
+    MoveParticles(pFrame_period);
+}
+
+void WaterBeginScene(void) {
+#ifdef DETHRACE_3DFX_PATCH
+    static const br_vector3 tint = { { 0.08f, 0.26f, 0.3f } };
+    br_vector3 to_sun;
+    br_vector3 camera;
+    float ripples[RIPPLE_COUNT][4];
+    int i, n;
+
+    gWater.camera_under = 0;
+    if (!gProgram_state.racing || gWater.face_count == 0 || !gNo_2d_effects) {
+        return;
+    }
+    if (SunDirection(&to_sun)) {
+        BrVector3Negate(&to_sun, &to_sun);
+    } else {
+        BrVector3Set(&to_sun, 0.35f, 0.8f, 0.45f);
+        BrVector3Normalise(&to_sun, &to_sun);
+    }
+    camera = *(br_vector3*)gCamera_to_world.m[3];
+    gWater.camera_under = WaterSurfaceAt(&camera, &gWater.camera_surface) && gWater.camera_surface > camera.v[1] + 0.003f;
+    for (i = n = 0; i < RIPPLE_COUNT; i++) {
+        if (gWater.ripples[i][3] > 0.f && gWater.time - gWater.ripples[i][2] < RIPPLE_LIFE / 1000.f && gWater.time >= gWater.ripples[i][2]) {
+            memcpy(ripples[n++], gWater.ripples[i], sizeof(ripples[0]));
+        }
+    }
+    GLREND_SetWaterScene(gWater.time, &to_sun, &ripples[0][0], n, gWater.camera_under, gWater.camera_surface, &tint);
+#endif
+}
+
+void WaterDrawSurface(void) {
+#ifdef DETHRACE_3DFX_PATCH
+    GLREND_DrawWater();
+    if (gWater.root != NULL && gProgram_state.racing && !gAction_replay_mode) {
+        BrZbSceneRenderAdd(gWater.root);
+    }
+#endif
+}
+
+void WaterEndScene(void) {
+#ifdef DETHRACE_3DFX_PATCH
+    if (gWater.camera_under) {
+        GLREND_DrawUnderwater();
+    }
+#endif
+}
+
+void WaterTestGoto(void) {
+    tCar_spec* car;
+    br_matrix34 safe[5];
+    br_vector3 best, c, pos;
+    br_scalar best_d, d;
+    int i;
+
+    car = &gProgram_state.current_car;
+    if (!gProgram_state.racing || car->car_master_actor == NULL || gWater.face_count == 0) {
+        printf("[test] no water here\n");
+        return;
+    }
+    pos = car->car_master_actor->t.t.translate.t;
+    best_d = 1e30f;
+    for (i = 0; i < gWater.face_count; i++) {
+        BrVector3Add(&c, &gWater.faces[i].p[0], &gWater.faces[i].p[1]);
+        BrVector3Accumulate(&c, &gWater.faces[i].p[2]);
+        BrVector3Scale(&c, &c, 1.f / 3.f);
+        d = Vector3DistanceSquared(&c, &pos);
+        if (d < best_d) {
+            best_d = d;
+            best = c;
+        }
+    }
+    best.v[1] += 0.25f;
+    // InitialiseCar2() would reset all the car's safe positions to this one
+    memcpy(safe, car->last_safe_positions, sizeof(safe));
+    car->car_master_actor->t.t.translate.t = best;
+    InitialiseCar2(car, 0);
+    memcpy(car->last_safe_positions, safe, sizeof(safe));
+    printf("[test] car moved to the water at %.2f %.2f %.2f\n", best.v[0], best.v[1], best.v[2]);
+}
+
+void WaterDumpState(void) {
+    tCar_water* state;
+    int i, particles;
+
+    particles = 0;
+    for (i = 0; i < PARTICLE_COUNT; i++) {
+        particles += gWater.particles[i].active;
+    }
+    printf("[state] water faces %d materials %d, camera under %d, splashes %d, wake ripples %d, bubbles %d, particles %d\n",
+        gWater.face_count, gWater.material_count, gWater.camera_under, gWater.stats.splashes, gWater.stats.wake_ripples,
+        gWater.stats.bubbles, particles);
+    for (i = 0; i < gWater.material_count; i++) {
+        printf("[state] water material %s\n", gWater.materials[i]->identifier);
+    }
+    for (i = 0; i < CAR_STATE_COUNT; i++) {
+        state = &gWater.cars[i];
+        if (state->car == &gProgram_state.current_car) {
+            printf("[state] water player's car submerged %.2f flooded %.2f surface %.3f\n", state->submerged, state->flooded, state->surface);
+        }
+    }
+}
