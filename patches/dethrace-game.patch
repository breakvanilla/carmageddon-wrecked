diff --git a/src/DETHRACE/common/modmesh.c b/src/DETHRACE/common/modmesh.c
new file mode 100644
index 0000000..1622111
--- /dev/null
+++ b/src/DETHRACE/common/modmesh.c
@@ -0,0 +1,236 @@
+#include "modmesh.h"
+#include "brender.h"
+#include "globvars.h"
+#include "macros.h"
+#include <math.h>
+#include <string.h>
+
+/*
+ * Weapon models from textured boxes, cylinders and cones, in units of the car's width. Textures (carmamod_*.png) come
+ * from tools/make_minigun_textures.py via the hi-res texture folder.
+ */
+
+tMesh gMesh;
+
+void MeshBegin(void) {
+    gMesh.nvertices = 0;
+    gMesh.nfaces = 0;
+}
+
+int MeshVertex(br_scalar pX, br_scalar pY, br_scalar pZ, br_vector3* pNormal, br_scalar pU, br_scalar pV) {
+    static br_vector3 light = { { 0.35f, 0.82f, 0.45f } };
+    br_vertex* v;
+    br_scalar shade;
+
+    if (gMesh.nvertices >= MESH_MAX_VERTICES) {
+        return MESH_MAX_VERTICES - 1;
+    }
+    v = &gMesh.vertices[gMesh.nvertices];
+    memset(v, 0, sizeof(*v));
+    BrVector3Set(&v->p, pX, pY, pZ);
+    BrVector2Set(&v->map, pU, pV);
+    shade = 0.45f + 0.6f * MAX(0.f, BrVector3Dot(pNormal, &light) / BrVector3Length(&light));
+    v->red = v->grn = v->blu = (br_uint_8)(255.f * MIN(1.f, shade));
+    return gMesh.nvertices++;
+}
+
+void MeshTriangle(int pA, int pB, int pC) {
+    if (gMesh.nfaces >= MESH_MAX_FACES) {
+        return;
+    }
+    memset(&gMesh.faces[gMesh.nfaces], 0, sizeof(br_face));
+    gMesh.faces[gMesh.nfaces].vertices[0] = pA;
+    gMesh.faces[gMesh.nfaces].vertices[1] = pB;
+    gMesh.faces[gMesh.nfaces].vertices[2] = pC;
+    gMesh.nfaces++;
+}
+
+void MeshQuad(int pA, int pB, int pC, int pD) {
+    MeshTriangle(pA, pB, pC);
+    MeshTriangle(pA, pC, pD);
+}
+
+void MeshBox(br_scalar pX, br_scalar pY, br_scalar pZ, br_scalar pHx, br_scalar pHy, br_scalar pHz) {
+    // For each face: normal axis and sign, then the axis and direction of u (right) and v (down)
+    static const int faces[6][6] = {
+        { 0, 1, 2, -1, 1, -1 }, { 0, -1, 2, 1, 1, -1 }, // +x, -x
+        { 2, 1, 0, 1, 1, -1 }, { 2, -1, 0, -1, 1, -1 }, // +z, -z
+        { 1, 1, 0, 1, 2, 1 }, { 1, -1, 0, 1, 2, -1 },   // top, bottom
+    };
+    br_scalar centre[3];
+    br_scalar half[3];
+    br_scalar p[3];
+    br_vector3 n;
+    int side, corner, base;
+    int k, u, v;
+    br_scalar cu, cv;
+
+    centre[0] = pX;
+    centre[1] = pY;
+    centre[2] = pZ;
+    half[0] = pHx;
+    half[1] = pHy;
+    half[2] = pHz;
+    for (side = 0; side < 6; side++) {
+        k = faces[side][0];
+        u = faces[side][2];
+        v = faces[side][4];
+        BrVector3Set(&n, 0.f, 0.f, 0.f);
+        n.v[k] = (br_scalar)faces[side][1];
+        base = gMesh.nvertices;
+        for (corner = 0; corner < 4; corner++) {
+            cu = (corner == 1 || corner == 2) ? 1.f : 0.f;
+            cv = (corner >= 2) ? 1.f : 0.f;
+            p[k] = centre[k] + faces[side][1] * half[k];
+            p[u] = centre[u] + faces[side][3] * (cu * 2.f - 1.f) * half[u];
+            p[v] = centre[v] + faces[side][5] * (cv * 2.f - 1.f) * half[v];
+            MeshVertex(p[0], p[1], p[2], &n, cu, cv);
+        }
+        MeshQuad(base, base + 1, base + 2, base + 3);
+    }
+}
+
+void MeshFrustum(int pAxis, br_scalar pA, br_scalar pB, br_scalar pStart_radius, br_scalar pEnd_radius, br_scalar pStart, br_scalar pEnd, int pSegments, int pCaps, br_scalar pU_repeat, br_scalar pV_repeat) {
+    br_vector3 n;
+    br_scalar p[3];
+    br_scalar angle;
+    br_scalar radius;
+    br_scalar slope;
+    int a1, a2;
+    int i, end, base, centre;
+
+    a1 = (pAxis + 1) % 3;
+    a2 = (pAxis + 2) % 3;
+    // Normals lean along the axis on a cone
+    slope = pEnd != pStart ? (pStart_radius - pEnd_radius) / (pEnd - pStart) : 0.f;
+    base = gMesh.nvertices;
+    for (i = 0; i <= pSegments; i++) {
+        angle = i * 2.f * (float)M_PI / pSegments;
+        for (end = 0; end < 2; end++) {
+            radius = end ? pEnd_radius : pStart_radius;
+            p[pAxis] = end ? pEnd : pStart;
+            p[a1] = pA + cosf(angle) * radius;
+            p[a2] = pB + sinf(angle) * radius;
+            BrVector3Set(&n, 0.f, 0.f, 0.f);
+            n.v[a1] = cosf(angle);
+            n.v[a2] = sinf(angle);
+            n.v[pAxis] = slope;
+            BrVector3Normalise(&n, &n);
+            MeshVertex(p[0], p[1], p[2], &n, pU_repeat * i / pSegments, end ? pV_repeat : 0.f);
+        }
+    }
+    for (i = 0; i < pSegments; i++) {
+        MeshQuad(base + 2 * i, base + 2 * i + 1, base + 2 * i + 3, base + 2 * i + 2);
+    }
+    if (!pCaps) {
+        return;
+    }
+    for (end = 0; end < 2; end++) {
+        radius = end ? pEnd_radius : pStart_radius;
+        if (radius <= 0.f) {
+            continue;
+        }
+        BrVector3Set(&n, 0.f, 0.f, 0.f);
+        n.v[pAxis] = (end ? pEnd > pStart : pEnd < pStart) ? 1.f : -1.f;
+        p[pAxis] = end ? pEnd : pStart;
+        p[a1] = pA;
+        p[a2] = pB;
+        centre = MeshVertex(p[0], p[1], p[2], &n, 0.5f, 0.5f);
+        base = gMesh.nvertices;
+        for (i = 0; i <= pSegments; i++) {
+            angle = i * 2.f * (float)M_PI / pSegments;
+            p[a1] = pA + cosf(angle) * radius;
+            p[a2] = pB + sinf(angle) * radius;
+            MeshVertex(p[0], p[1], p[2], &n, 0.5f + 0.5f * cosf(angle), 0.5f + 0.5f * sinf(angle));
+        }
+        for (i = 0; i < pSegments; i++) {
+            MeshTriangle(centre, base + i, base + i + 1);
+        }
+    }
+}
+
+void MeshCylinder(int pAxis, br_scalar pA, br_scalar pB, br_scalar pRadius, br_scalar pStart, br_scalar pEnd, int pSegments, int pCaps, br_scalar pU_repeat, br_scalar pV_repeat) {
+    MeshFrustum(pAxis, pA, pB, pRadius, pRadius, pStart, pEnd, pSegments, pCaps, pU_repeat, pV_repeat);
+}
+
+br_model* MeshModel(char* pName) {
+    br_model* model;
+
+    model = BrModelAllocate(pName, gMesh.nvertices, gMesh.nfaces);
+    memcpy(model->vertices, gMesh.vertices, sizeof(br_vertex) * gMesh.nvertices);
+    memcpy(model->faces, gMesh.faces, sizeof(br_face) * gMesh.nfaces);
+    model->flags |= BR_MODF_UPDATEABLE;
+    BrModelAdd(model);
+    return model;
+}
+
+br_material* MeshMaterial(char* pName, int pColour_key) {
+    br_pixelmap* map;
+    br_material* material;
+    char identifier[64];
+
+    BrSprintfN(identifier, sizeof(identifier) - 1, "carmamod_%s", pName);
+    map = BrPixelmapAllocate(BR_PMT_INDEX_8, 16, 16, NULL, BR_PMAF_NORMAL);
+    memset(map->pixels, pColour_key ? 0 : 8, 16 * 16);
+    map->identifier = BrResStrDup(map, identifier);
+    BrMapAdd(map);
+
+    material = BrMaterialAllocate(identifier);
+    material->flags = BR_MATF_PRELIT | BR_MATF_LIGHT | BR_MATF_SMOOTH | BR_MATF_MAP_INTERPOLATION | BR_MATF_MIP_INTERPOLATION
+        | BR_MATF_PERSPECTIVE;
+    if (pColour_key) {
+        material->flags |= BR_MATF_TWO_SIDED;
+    } else {
+        material->flags |= BR_MATF_DISABLE_COLOUR_KEY;
+    }
+    material->colour_map = map;
+    BrMaterialAdd(material);
+    return material;
+}
+
+br_actor* NewPart(br_actor* pParent, br_model* pModel, br_material* pMaterial) {
+    br_actor* actor;
+
+    actor = BrActorAllocate(pModel != NULL ? BR_ACTOR_MODEL : BR_ACTOR_NONE, NULL);
+    actor->model = pModel;
+    actor->material = pMaterial;
+    BrActorAdd(pParent, actor);
+    return actor;
+}
+
+// Opacity goes in extra primitive state, as the game's smoke does (InitSmokeStuff())
+void MeshSetOpacity(br_material* pMaterial, int pOpacity) {
+    static br_token_value tokens[64][3]; // rockets use 26, water 8
+    static int used;
+    br_token_value* t;
+
+    if (pMaterial->extra_prim == NULL) {
+        if (used >= COUNT_OF(tokens)) {
+            return;
+        }
+        t = tokens[used++];
+        t[0].t = BRT_BLEND_B;
+        t[0].v.u32 = 1;
+        t[1].t = BRT_OPACITY_X;
+        t[2].t = 0;
+        pMaterial->extra_prim = t;
+    }
+    pMaterial->extra_prim[1].v.x = BrIntToFixed(pOpacity);
+    // See-through sprites don't hide each other
+    pMaterial->flags |= BR_MATF_INHIBIT_DEPTH_WRITE;
+    BrMaterialUpdate(pMaterial, BR_MATU_ALL);
+}
+
+void MeshBillboard(br_actor* pActor, br_vector3* pPos, br_scalar pSize, br_scalar pAngle) {
+    br_scalar c, s;
+    int k;
+
+    c = cosf(pAngle) * pSize;
+    s = sinf(pAngle) * pSize;
+    for (k = 0; k < 3; k++) {
+        pActor->t.t.mat.m[0][k] = gCamera_to_world.m[0][k] * c + gCamera_to_world.m[1][k] * s;
+        pActor->t.t.mat.m[1][k] = gCamera_to_world.m[1][k] * c - gCamera_to_world.m[0][k] * s;
+        pActor->t.t.mat.m[2][k] = gCamera_to_world.m[2][k] * pSize;
+        pActor->t.t.mat.m[3][k] = pPos->v[k];
+    }
+}
