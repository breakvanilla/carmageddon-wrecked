+#ifndef _WATER_H_
+#define _WATER_H_
+
+// Water: buoyancy, splashes, wakes, ripples and the underwater view; the glrend driver's water.c draws the surface
+
+#include "dr_types.h"
+
+void MungeWater(tU32 pFrame_period);
+
+// Water surface height (world units) at a point, waves included; returns 0 if there's no water there
+int WaterSurfaceAt(br_vector3* pPos, br_scalar* pHeight);
+
+// From CalcForce() (pMat in physics units): adds buoyancy to the force and torque in car space. Returns 1 if the car
+// is in water.
+int WaterCarBuoyancy(tCar_spec* pCar, br_matrix34* pMat, br_vector3* pForce, br_vector3* pTorque, br_scalar dt);
+
+// Whether a car has filled with water and sunk, so the game puts it back on the track
+int WaterCarSunk(tCar_spec* pCar);
+
+// Floating and not yet sunk, so not fallen off the world
+int WaterCarAfloat(tCar_spec* pCar);
+
+// From NonCarCalcForce(): loose props float
+void WaterNonCarBuoyancy(tCollision_info* pThing, br_scalar dt);
+
+// Whether pFrom to pTo goes down into water; where, in pHit
+int WaterCrossing(br_vector3* pFrom, br_vector3* pTo, br_vector3* pHit);
+
+// pStrength 1 is a car falling in
+void WaterSplash(br_vector3* pPos, br_scalar pStrength);
+
+// Around the main 3D scene: water is drawn last, and the underwater view applied
+void WaterBeginScene(void);
+void WaterDrawSurface(void);
+void WaterEndScene(void);
+
+void WaterTestGoto(void);
+
+// Heavy so it stays down
+void WaterTestDive(void);
+
+void WaterDumpState(void);
+
+#endif
