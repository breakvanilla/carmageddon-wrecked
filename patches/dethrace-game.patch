new file mode 100644
index 0000000..6ea8454
--- /dev/null
+++ b/src/DETHRACE/common/modmesh.h
@@ -0,0 +1,52 @@
+#ifndef _MODMESH_H_
+#define _MODMESH_H_
+
+// Builds the simple textured models of the mod's weapons
+
+#include "dr_types.h"
+
+#define MESH_MAX_VERTICES 1500
+#define MESH_MAX_FACES 1500
+
+typedef struct tMesh {
+    br_vertex vertices[MESH_MAX_VERTICES];
+    br_face faces[MESH_MAX_FACES];
+    int nvertices;
+    int nfaces;
+} tMesh;
+
+extern tMesh gMesh;
+
+void MeshBegin(void);
+
+// Shaded by a fixed light from above, as the materials are prelit; returns the index
+int MeshVertex(br_scalar pX, br_scalar pY, br_scalar pZ, br_vector3* pNormal, br_scalar pU, br_scalar pV);
+
+void MeshTriangle(int pA, int pB, int pC);
+
+void MeshQuad(int pA, int pB, int pC, int pD);
+
+// Box with the whole texture on each face, upright and not mirrored when seen from outside
+void MeshBox(br_scalar pX, br_scalar pY, br_scalar pZ, br_scalar pHx, br_scalar pHy, br_scalar pHz);
+
+// Cylinder along an axis (0 = x, 1 = y, 2 = z) through (pA, pB) in the other two axes, from pStart to pEnd.
+// u wraps round it pU_repeat times; v runs 0..pV_repeat from start to end.
+void MeshCylinder(int pAxis, br_scalar pA, br_scalar pB, br_scalar pRadius, br_scalar pStart, br_scalar pEnd, int pSegments, int pCaps, br_scalar pU_repeat, br_scalar pV_repeat);
+
+// Like MeshCylinder, with radius pStart_radius at pStart and pEnd_radius at pEnd (0 makes a cone)
+void MeshFrustum(int pAxis, br_scalar pA, br_scalar pB, br_scalar pStart_radius, br_scalar pEnd_radius, br_scalar pStart, br_scalar pEnd, int pSegments, int pCaps, br_scalar pU_repeat, br_scalar pV_repeat);
+
+br_model* MeshModel(char* pName);
+
+// Texture is carmamod_<name>.png from the hi-res texture folder; the 8-bit pixelmap is only a stand-in
+br_material* MeshMaterial(char* pName, int pColour_key);
+
+br_actor* NewPart(br_actor* pParent, br_model* pModel, br_material* pMaterial);
+
+// pOpacity 0 to 255; also stops depth writes
+void MeshSetOpacity(br_material* pMaterial, int pOpacity);
+
+// Sprite is a unit square facing +z
+void MeshBillboard(br_actor* pActor, br_vector3* pPos, br_scalar pSize, br_scalar pAngle);
+
+#endif
