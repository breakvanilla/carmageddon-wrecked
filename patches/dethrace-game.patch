index 0000000..76b23de
--- /dev/null
+++ b/src/DETHRACE/common/carmatest.c
@@ -0,0 +1,89 @@
+// Game state for the harness's scripted test mode (src/harness/testmode.c); CARMA_DEV builds only
+#ifdef CARMA_DEV
+
+#include "brender.h"
+#include "constants.h"
+#include "deform.h"
+#include "shatter.h"
+#include "destruct.h"
+#include "globvars.h"
+#include "globvrbm.h"
+#include "graphics.h"
+#include "globvrkm.h"
+#include "minigun.h"
+#include "rocket.h"
+#include "spark.h"
+#include "water.h"
+#include <stdio.h>
+
+int Carma_TestIsRacing(void) {
+    return gProgram_state.racing && !gCountdown;
+}
+
+void Carma_TestDumpState(void) {
+    tCar_spec* car;
+    br_vector3* pos;
+
+    car = &gProgram_state.current_car;
+    printf("[state] racing %d countdown %d race \"%s\" laps %d timer %.1fs credits %d peds killed %d view %s\n",
+        gProgram_state.racing, gCountdown, gCurrent_race.name, gCurrent_race.total_laps, gTimer / 1000.f,
+        gProgram_state.credits_earned - gProgram_state.credits_lost, gProgram_state.peds_killed,
+        gProgram_state.cockpit_on ? "cockpit" : "outside");
+    if (gCamera != NULL && gCamera->type_data != NULL) {
+        br_camera* camera = gCamera->type_data;
+        printf("[state] camera yon %.2f hither %.3f aspect %.3f fov %.1f degrees, yon multiplier %.2f\n", camera->yon_z, camera->hither_z,
+            camera->aspect, BrAngleToDegree(camera->field_of_view), gYon_multiplier);
+    }
+    if (gProgram_state.racing && car->car_master_actor != NULL) {
+        pos = &car->car_master_actor->t.t.translate.t;
+        printf("[state] car \"%s\" pos %.2f %.2f %.2f speed %.4f gear %d knackered %d damage engine %d transmission %d driver %d\n",
+            car->name, pos->v[0], pos->v[1], pos->v[2], car->speed, car->gear, car->knackered,
+            car->damage_units[eDamage_engine].damage_level, car->damage_units[eDamage_transmission].damage_level,
+            car->damage_units[eDamage_driver].damage_level);
+        MinigunDumpState();
+        RocketDumpState();
+        DestructDumpState();
+        DeformDumpState();
+        ShatterDumpState();
+        SunShadowsDumpState();
+        WaterDumpState();
+    }
+    fflush(stdout);
+}
+
+// Tests destruction without aiming
+void Carma_TestBlastProp(void) {
+    br_vector3 point;
+    br_actor* prop;
+
+    if (!gProgram_state.racing || gProgram_state.current_car.car_master_actor == NULL) {
+        return;
+    }
+    prop = DestructNearestProp(&gProgram_state.current_car.car_master_actor->t.t.translate.t, &point);
+    if (prop != NULL) {
+        printf("[test] blasting %s at %.2f %.2f %.2f\n", prop->identifier, point.v[0], point.v[1], point.v[2]);
+        RocketTestExplosion(&point);
+    }
+}
+
+void Carma_TestBlastCar(void) {
+    if (gProgram_state.racing && gProgram_state.current_car.car_master_actor != NULL) {
+        RocketTestExplosion(&gProgram_state.current_car.car_master_actor->t.t.translate.t);
+    }
+}
+
+void Carma_TestIgniteCar(void) {
+    if (gProgram_state.racing && gProgram_state.current_car.car_master_actor != NULL) {
+        CreateSmokeColumn(&gProgram_state.current_car, 0, 0, 20000);
+    }
+}
+
+void Carma_TestGotoWater(void) {
+    WaterTestGoto();
+}
+
+void Carma_TestDiveWater(void) {
+    WaterTestDive();
+}
+
+#endif
