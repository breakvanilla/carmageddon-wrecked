+static int PedIsTarget(tPedestrian_data* pPed) {
+    return pPed->ref_number < 100
+        && pPed->active
+        && pPed->hit_points > 0
+        && pPed->actor != NULL
+        && pPed->actor->parent == gDont_render_actor
+        && pPed->current_action != pPed->fatal_car_impact_action
+        && pPed->current_action != pPed->fatal_ground_impact_action
+        && pPed->current_action != pPed->giblets_action;
+}
+
+static void PedCentre(tPedestrian_data* pPed, br_vector3* pOut) {
+    BrVector3Copy(pOut, &pPed->pos);
+    pOut->v[1] += pPed->actor->t.t.mat.m[1][1] * 0.5f;
+}
+
+static int CarCanBeHit(tCar_spec* pCar) {
+    return pCar != NULL && pCar->car_master_actor != NULL && pCar->car_model_actors[pCar->principal_car_actor].actor != NULL;
+}
+
+// Where a segment pFrom + t * pDir (t 0..1) first enters a car's box, or a value over 1 if it misses
+static br_scalar SegmentHitsCar(tCar_spec* pCar, br_vector3* pFrom, br_vector3* pDir, br_scalar pMargin) {
+    br_matrix34 inverse;
+    br_vector3 from;
+    br_vector3 dir;
+    br_scalar t0, t1, ta, tb, lo, hi;
+    int k;
+
+    BrMatrix34LPInverse(&inverse, &pCar->car_master_actor->t.t.mat);
+    BrMatrix34ApplyP(&from, pFrom, &inverse);
+    BrMatrix34ApplyV(&dir, pDir, &inverse);
+    t0 = 0.f;
+    t1 = 1.f;
+    for (k = 0; k < 3; k++) {
+        lo = pCar->bounds[0].min.v[k] - pMargin;
+        hi = pCar->bounds[0].max.v[k] + pMargin;
+        if (fabsf(dir.v[k]) < 1e-7f) {
+            if (from.v[k] < lo || from.v[k] > hi) {
+                return 2.f;
+            }
+            continue;
+        }
+        ta = (lo - from.v[k]) / dir.v[k];
+        tb = (hi - from.v[k]) / dir.v[k];
+        t0 = MAX(t0, MIN(ta, tb));
+        t1 = MIN(t1, MAX(ta, tb));
+        if (t0 > t1) {
+            return 2.f;
+        }
+    }
+    return t0;
+}
+
+// How far a point is from a car's box, in world units (0 inside)
+static br_scalar DistanceToCar(tCar_spec* pCar, br_vector3* pPoint) {
+    br_matrix34 inverse;
+    br_vector3 p;
+    br_scalar d, e;
+    int k;
+
+    BrMatrix34LPInverse(&inverse, &pCar->car_master_actor->t.t.mat);
+    BrMatrix34ApplyP(&p, pPoint, &inverse);
+    d = 0.f;
+    for (k = 0; k < 3; k++) {
+        e = MAX(pCar->bounds[0].min.v[k] - p.v[k], p.v[k] - pCar->bounds[0].max.v[k]);
+        if (e > 0.f) {
+            d += e * e;
+        }
+    }
+    return sqrtf(d);
+}
+
+static void BlastCar(tCar_spec* pCar, br_vector3* pPos, br_scalar pStrength) {
+    static const int core_units[] = { eDamage_engine, eDamage_transmission, eDamage_driver };
+    br_matrix34 inverse;
+    br_vector3 impact;
+    br_vector3 energy;
+    br_vector3 push;
+    br_vector3 centre;
+    int was_knackered;
+    int i;
+
+    was_knackered = pCar->knackered;
+    // The player's own car gets off lighter
+    if (pCar == &gProgram_state.current_car) {
+        pStrength *= 0.35f;
+    }
+    for (i = 0; i < COUNT_OF(core_units); i++) {
+        DamageUnit2(pCar, core_units[i], (int)(pStrength * IRandomBetween(34, 46)));
+    }
+    for (i = eDamage_steering; i < eDamage_type_count; i++) {
+        if (PercentageChance(50)) {
+            DamageUnit2(pCar, i, (int)(pStrength * IRandomBetween(10, 30)));
+        }
+    }
+
+    // Dents where the blast hit, through the game's own crushing
+    BrMatrix34LPInverse(&inverse, &pCar->car_master_actor->t.t.mat);
+    BrMatrix34ApplyP(&impact, pPos, &inverse);
+    centre = pCar->car_master_actor->t.t.translate.t;
+    BrVector3Sub(&push, &centre, pPos);
+    if (BrVector3LengthSquared(&push) < 1e-6f) {
+        BrVector3Set(&push, 0.f, 1.f, 0.f);
+    }
+    BrVector3Normalise(&push, &push);
+    BrMatrix34ApplyV(&energy, &push, &inverse);
+    BrVector3Scale(&energy, &energy, 0.08f + 0.32f * pStrength);
+    if (!pCar->invulnerable) {
+        for (i = 0; i < pCar->car_actor_count; i++) {
+            if (pCar->car_model_actors[i].actor != NULL && pCar->car_model_actors[i].min_distance_squared != -1.f) {
+                CrushModel(pCar, i, pCar->car_model_actors[i].actor, &impact, &energy, &pCar->car_model_actors[i].crush_data);
+            }
+        }
+    }
+
+    // Thrown away from the blast and up, spinning (car velocities are in metres a second)
+    push.v[1] = MAX(push.v[1], 0.f);
+    BrVector3Scale(&push, &push, 8.f * pStrength);
+    push.v[1] += 5.f * pStrength;
+    BrVector3Accumulate(&pCar->v, &push);
+    pCar->omega.v[0] += SRandomPosNeg(3.f * pStrength);
+    pCar->omega.v[1] += SRandomPosNeg(2.f * pStrength);
+    pCar->omega.v[2] += SRandomPosNeg(3.f * pStrength);
+    pCar->doing_nothing_flag = 0;
+
+    gRocket.stats.cars_damaged++;
+    if (pCar != &gProgram_state.current_car) {
+        gRocket.stats.cars_wasted += WeaponCarHit(pCar, &gProgram_state.current_car, was_knackered);
+    }
+}
+
+static void Explode(br_vector3* pPos, br_vector3* pNormal, tCar_spec* pDirect_hit) {
+    static const tVehicle_type categories[] = { eVehicle_opponent, eVehicle_rozzer };
+    br_vector3 v;
+    br_vector3 p;
+    tCar_spec* car;
+    tCar_spec* shrapnel_car;
+    br_scalar d;
+    int c;
+    int i;
+
+    gRocket.stats.exploded++;
+    gRocket.last_blast = *pPos;
+    // On or near water: a column of spray
+    if (WaterSurfaceAt(pPos, &d) && fabsf(pPos->v[1] - d) < ROCKET_BLAST_RADIUS * 0.4f) {
+        BrVector3Set(&p, pPos->v[0], d, pPos->v[2]);
+        WaterSplash(&p, 3.f * (1.f - fabsf(pPos->v[1] - d) / (ROCKET_BLAST_RADIUS * 0.4f)));
+    }
+    StartBlast(pPos, pNormal);
+    DRS3StartSound3D(gCar_outlet, ROCKET_BOOM_SOUND_ID, pPos, &gZero_v__car, 1, 255, IRandomBetween(0xe000, 0x11000), 0x10000);
+
+    // Sparks, shrapnel and a cloud of dark smoke
+    for (i = 0; i < 14; i++) {
+        BrVector3Set(&v, pNormal->v[0] * 2.f + SRandomPosNeg(2.5f), pNormal->v[1] * 2.f + FRandomBetween(0.f, 2.5f), pNormal->v[2] * 2.f + SRandomPosNeg(2.5f));
+        CreateSingleSpark(NULL, pPos, &v);
+    }
+    shrapnel_car = pDirect_hit != NULL ? pDirect_hit : &gProgram_state.current_car;
+    if (shrapnel_car->max_shrapnel_material > 0) {
+        BrVector3Set(&v, 0.f, 0.f, 0.f);
+        CreateShrapnelShower(pPos, &v, pNormal, 40.f, shrapnel_car, shrapnel_car);
+    }
+    for (i = 0; i < 5; i++) {
+        p = *pPos;
+        p.v[0] += SRandomPosNeg(0.25f);
+        p.v[1] += FRandomBetween(0.2f, 0.45f);
+        p.v[2] += SRandomPosNeg(0.25f);
+        BrVector3Set(&v, SRandomPosNeg(0.3f), FRandomBetween(0.2f, 0.5f), SRandomPosNeg(0.3f));
+        AddPuff(&p, &v, FRandomBetween(0.22f, 0.32f), 1.2f, 0.7f, IRandomBetween(1800, 2600), 1);
+    }
+    DestructExplosion(pPos, pNormal, ROCKET_BLAST_RADIUS);
+
+    // Cars caught in the blast, the player's included
+    for (c = -1; c < (int)COUNT_OF(categories); c++) {
+        for (i = 0; i < (c < 0 ? 1 : GetCarCount(categories[c])); i++) {
+            car = c < 0 ? &gProgram_state.current_car : GetCarSpec(categories[c], i);
+            if (!CarCanBeHit(car)) {
+                continue;
+            }
+            d = car == pDirect_hit ? 0.f : DistanceToCar(car, pPos);
+            if (d < ROCKET_BLAST_RADIUS) {
+                BlastCar(car, pPos, 1.f - d / ROCKET_BLAST_RADIUS);
+            }
+        }
+    }
+    // Pedestrians caught in it die as if shot
+    for (i = 0; i < gPed_count; i++) {
+        if (!PedIsTarget(&gPedestrian_array[i])) {
+            continue;
+        }
+        PedCentre(&gPedestrian_array[i], &p);
+        if (Vector3DistanceSquared(&p, pPos) < ROCKET_BLAST_RADIUS * ROCKET_BLAST_RADIUS * 0.6f && MinigunDoomPedestrian(&gPedestrian_array[i])) {
+            gRocket.stats.peds_killed++;
+        }
+    }
+}
+
+// A car near the rocket's line to steer towards
+static tCar_spec* FindHomingTarget(br_vector3* pPos, br_vector3* pDir) {
+    static const tVehicle_type categories[] = { eVehicle_opponent, eVehicle_rozzer };
+    tCar_spec* best;
+    tCar_spec* car;
+    br_vector3 to;
+    br_scalar best_cos;
+    br_scalar d, cos_a;
+    int c, i;
+
+    best = NULL;
+    best_cos = ROCKET_HOMING_COS;
+    for (c = 0; c < COUNT_OF(categories); c++) {
+        for (i = 0; i < GetCarCount(categories[c]); i++) {
+            car = GetCarSpec(categories[c], i);
+            if (!CarCanBeHit(car) || car->knackered) {
+                continue;
+            }
+            BrVector3Sub(&to, &car->car_master_actor->t.t.translate.t, pPos);
+            d = BrVector3Length(&to);
+            if (d < 0.01f || d > ROCKET_HOMING_RANGE) {
+                continue;
+            }
+            cos_a = BrVector3Dot(&to, pDir) / d;
+            if (cos_a > best_cos && !CheckForWall(pPos, &car->car_master_actor->t.t.translate.t)) {
+                best_cos = cos_a;
+                best = car;
+            }
+        }
+    }
+    return best;
+}
+
+static void FireRocket(tCar_spec* pCar, int pTube) {
+    tRocket* r;
+    br_vector3 mouth;
+    br_matrix34* m;
+    int i;
+
+    r = NULL;
+    for (i = 0; i < ROCKET_COUNT; i++) {
+        if (!gRocket.rockets[i].active) {
+            r = &gRocket.rockets[i];
+            break;
+        }
+    }
+    if (r == NULL) {
+        return;
+    }
+    BrVector3Set(&mouth, gTube_x[pTube], 0.f, TUBE_MOUTH_Z);
+    BrMatrix34ApplyP(&r->pos, &mouth, &gRocket.launcher->t.t.mat);
+    m = &pCar->car_master_actor->t.t.mat;
+    BrVector3Set(&r->dir, -m->m[2][0], -m->m[2][1], -m->m[2][2]);
+    BrVector3Normalise(&r->dir, &r->dir);
+    BrVector3InvScale(&r->carry, &pCar->v, WORLD_SCALE);
+    r->speed = ROCKET_START_SPEED;
+    r->size = gRocket.size;
+    r->roll = FRandomBetween(0.f, 6.28f);
+    r->birth = GetTotalTime();
+    r->last_puff = r->birth;
+    r->target = FindHomingTarget(&r->pos, &r->dir);
+    r->active = 1;
+
+    gRocket.tube_loaded[pTube] = 0;
+    gRocket.tube_emptied[pTube] = GetTotalTime();
+    gRocket.last_fire = GetTotalTime();
+    gRocket.stats.fired++;
+    DRS3StartSound(gEffects_outlet, ROCKET_FIRE_SOUND_ID);
+    // A puff of smoke out of the tube, front and back
+    for (i = 0; i < 3; i++) {
+        br_vector3 v;
+        BrVector3Scale(&v, &r->dir, FRandomBetween(0.3f, 1.2f));
+        BrVector3Accumulate(&v, &r->carry);
+        AddPuff(&r->pos, &v, gRocket.size * 0.35f, 2.f, 0.6f, IRandomBetween(500, 800), 0);
+    }
+}
+
+static void Steer(tRocket* pRocket, br_scalar pDt) {
+    br_vector3 to;
+    br_vector3 want;
+    br_scalar cos_a;
+    br_scalar angle;
+    br_scalar step;
+
+    if (pRocket->target == NULL || !CarCanBeHit(pRocket->target)) {
+        pRocket->target = NULL;
+        return;
+    }
+    BrVector3Sub(&to, &pRocket->target->car_master_actor->t.t.translate.t, &pRocket->pos);
+    if (BrVector3LengthSquared(&to) < 1e-6f) {
+        return;
+    }
+    BrVector3Normalise(&want, &to);
+    cos_a = BrVector3Dot(&want, &pRocket->dir);
+    if (cos_a < 0.5f) {
+        pRocket->target = NULL; // lost it
+        return;
+    }
+    angle = acosf(MIN(1.f, cos_a));
+    if (angle < 1e-4f) {
+        return;
+    }
+    step = MIN(1.f, ROCKET_TURN_RATE * pDt / angle);
+    BrVector3Scale(&want, &want, step);
+    BrVector3Scale(&pRocket->dir, &pRocket->dir, 1.f - step);
+    BrVector3Accumulate(&pRocket->dir, &want);
+    BrVector3Normalise(&pRocket->dir, &pRocket->dir);
+}
+
+static void MoveRocket(tRocket* pRocket, tU32 pFrame_period) {
+    static const tVehicle_type categories[] = { eVehicle_opponent, eVehicle_rozzer };
+    br_vector3 step;
+    br_vector3 normal;
+    br_vector3 hit;
+    br_vector3 to;
+    br_vector3 centre;
+    br_vector3 v;
+    tCar_spec* car;
+    tCar_spec* hit_car;
+    br_scalar dt;
+    br_scalar best;
+    br_scalar t;
+    br_scalar len2;
+    tU32 now;
+    int hit_what; // 0 nothing, 1 track, 2 car, 3 pedestrian
+    int c, i;
+
+    now = GetTotalTime();
+    dt = pFrame_period / 1000.f;
+    Steer(pRocket, dt);
+    pRocket->speed = MIN(ROCKET_MAX_SPEED, pRocket->speed + ROCKET_ACCELERATION * dt);
+    BrVector3Scale(&step, &pRocket->dir, pRocket->speed * dt);
+    BrVector3Scale(&v, &pRocket->carry, dt);
+    BrVector3Accumulate(&step, &v);
+    pRocket->roll += 9.f * dt;
+
+    // Into water: a column of spray, and it goes off at the surface
+    BrVector3Add(&v, &pRocket->pos, &step);
+    if (WaterCrossing(&pRocket->pos, &v, &hit)) {
+        gRocket.stats.hit_water++;
+        pRocket->active = 0;
+        pRocket->actor->render_style = BR_RSTYLE_NONE;
+        BrVector3Set(&normal, 0.f, 1.f, 0.f);
+        Explode(&hit, &normal, NULL);
+        return;
+    }
+
+    // The first thing along this frame's flight
+    hit_what = 0;
+    hit_car = NULL;
+    best = 1.f;
+    BrVector3Set(&normal, 0.f, 1.f, 0.f);
+    t = DestructRayPick(&pRocket->pos, &step, &normal);
+    if (t <= best) {
+        best = t;
+        hit_what = 1;
+    }
+    for (c = 0; c < COUNT_OF(categories); c++) {
+        for (i = 0; i < GetCarCount(categories[c]); i++) {
+            car = GetCarSpec(categories[c], i);
+            if (!CarCanBeHit(car)) {
+                continue;
+            }
+            t = SegmentHitsCar(car, &pRocket->pos, &step, 0.02f);
+            if (t <= best) {
+                best = t;
+                hit_what = 2;
+                hit_car = car;
+            }
+        }
+    }
+    len2 = BrVector3LengthSquared(&step);
+    for (i = 0; i < gPed_count && len2 > 0.f; i++) {
+        if (!PedIsTarget(&gPedestrian_array[i])) {
+            continue;
+        }
+        PedCentre(&gPedestrian_array[i], &centre);
+        BrVector3Sub(&to, &centre, &pRocket->pos);
+        t = MAX(0.f, MIN(1.f, BrVector3Dot(&to, &step) / len2));
+        BrVector3Scale(&v, &step, t);
+        BrVector3Accumulate(&v, &pRocket->pos);
+        if (t <= best && Vector3DistanceSquared(&v, &centre) < ROCKET_PED_RADIUS * ROCKET_PED_RADIUS) {
+            best = t;
+            hit_what = 3;
+        }
+    }
+
+    BrVector3Scale(&hit, &step, best);
+    BrVector3Accumulate(&hit, &pRocket->pos);
+    if (hit_what != 0 || now - pRocket->birth > ROCKET_LIFE) {
+        if (hit_what != 1) {
+            BrVector3Normalise(&normal, &step);
+            BrVector3Negate(&normal, &normal);
+            if (hit_what == 0) {
+                BrVector3Set(&normal, 0.f, 1.f, 0.f);
+            }
+        }
+        switch (hit_what) {
+        case 1:
+            gRocket.stats.hit_track++;
+            break;
+        case 2:
+            gRocket.stats.hit_car++;
+            break;
+        case 3:
+            gRocket.stats.hit_ped++;
+            break;
+        default:
+            gRocket.stats.in_air++;
+            break;
+        }
+        pRocket->active = 0;
+        pRocket->actor->render_style = BR_RSTYLE_NONE;
+        Explode(&hit, &normal, hit_car);
+        return;
+    }
+    pRocket->pos = hit;
+
+    // Smoke trail, puffs spread back along the flight so it doesn't break up when the frame rate drops
+    while (now - pRocket->last_puff >= ROCKET_TRAIL_PERIOD) {
+        pRocket->last_puff += ROCKET_TRAIL_PERIOD;
+        t = (br_scalar)(now - pRocket->last_puff) / MAX(1.f, (br_scalar)pFrame_period);
+        BrVector3Scale(&v, &step, -MIN(1.f, t));
+        BrVector3Accumulate(&v, &pRocket->pos);
+        BrVector3Scale(&centre, &pRocket->dir, -0.2f * pRocket->size);
+        BrVector3Accumulate(&v, &centre);
+        BrVector3Set(&to, SRandomPosNeg(0.05f), FRandomBetween(0.f, 0.08f), SRandomPosNeg(0.05f));
+        AddPuff(&v, &to, pRocket->size * 0.14f, 2.5f, 0.45f, IRandomBetween(700, 1000), 0);
+    }
+}
+
+static void AddLight(br_vector3* pPos, br_scalar pRadius, br_scalar pR, br_scalar pG, br_scalar pB) {
+    tRocket_light* l;
+
+    if (gRocket.light_count >= LIGHT_COUNT) {
+        return;
+    }
+    l = &gRocket.lights[gRocket.light_count++];
+    l->pos = *pPos;
+    l->radius = pRadius;
+    BrVector3Set(&l->colour, pR, pG, pB);
+}
+
+static void UpdateLights(void) {
+    br_scalar age;
+    br_scalar k;
+    tU32 now;
+    int i;
+
+    now = GetTotalTime();
+    gRocket.light_count = 0;
+    for (i = 0; i < BLAST_COUNT; i++) {
+        if (!gRocket.blasts[i].active) {
+            continue;
+        }
+        age = (now - gRocket.blasts[i].birth) / 1000.f;
+        k = 2.5f * expf(-age * 8.f) + 0.8f * MAX(0.f, 1.f - age / 0.9f);
+        AddLight(&gRocket.blasts[i].pos, 3.f, 1.f * k, 0.6f * k, 0.25f * k);
+    }
+    for (i = 0; i < ROCKET_COUNT; i++) {
+        if (gRocket.rockets[i].active) {
+            k = 1.2f + 0.4f * (rand() / (float)RAND_MAX);
+            AddLight(&gRocket.rockets[i].pos, 1.4f, 1.f * k, 0.6f * k, 0.25f * k);
+        }
+    }
+}
+
+static void HideAll(void) {
+    int i, k;
+
+    if (!gRocket.built) {
+        return;
+    }
+    gRocket.launcher->render_style = BR_RSTYLE_NONE;
+    for (i = 0; i < ROCKET_COUNT; i++) {
+        gRocket.rockets[i].actor->render_style = BR_RSTYLE_NONE;
+    }
+    for (i = 0; i < PUFF_COUNT; i++) {
+        gRocket.puffs[i].actor->render_style = BR_RSTYLE_NONE;
+    }
+    for (i = 0; i < BLAST_COUNT; i++) {
+        for (k = 0; k < BLAST_SPRITES; k++) {
+            gRocket.blasts[i].sprites[k].actor->render_style = BR_RSTYLE_NONE;
+        }
+    }
+    for (i = 0; i < FLAME_COUNT; i++) {
+        gRocket.flames[i].actor->render_style = BR_RSTYLE_NONE;
+    }
+}
+
+static void ResetRocket(void) {
+    int i;
+
+    HideAll();
+    for (i = 0; i < ROCKET_COUNT; i++) {
+        gRocket.rockets[i].active = 0;
+    }
+    for (i = 0; i < PUFF_COUNT; i++) {
+        gRocket.puffs[i].active = 0;
+    }
+    for (i = 0; i < BLAST_COUNT; i++) {
+        gRocket.blasts[i].active = 0;
+    }
+    for (i = 0; i < FLAME_COUNT; i++) {
+        gRocket.flames[i].active = 0;
+    }
+    for (i = 0; i < ROCKET_TUBES; i++) {
+        gRocket.tube_loaded[i] = 1;
+        gRocket.tube_emptied[i] = 0;
+    }
+    gRocket.light_count = 0;
+    gRocket.race = gRace_serial;
+}
+
+void MungeRocket(tU32 pFrame_period) {
+    tCar_spec* car;
+    tU32 now;
+    int key_down;
+    int hidden;
+    int tube;
+    int i;
+
+    car = &gProgram_state.current_car;
+    if (!gProgram_state.racing || gNet_mode != eNet_mode_none || car->car_master_actor == NULL
+        || car->car_model_actors[car->principal_car_actor].actor == NULL) {
+        if (gRocket.built && gRocket.race != 0) {
+            ResetRocket();
+            gRocket.race = 0;
+        }
+        return;
+    }
+    if (!gRocket.built) {
+        BuildRocket();
+    }
+    if (gRocket.race != gRace_serial) {
+        ResetRocket();
+    }
+    if (gAction_replay_mode) {
+        // Rockets aren't recorded in replays
+        HideAll();
+        gRocket.light_count = 0;
+        return;
+    }
+    now = GetTotalTime();
+
+    for (i = 0; i < ROCKET_TUBES; i++) {
+        if (!gRocket.tube_loaded[i] && now - gRocket.tube_emptied[i] >= ROCKET_RELOAD) {
+            gRocket.tube_loaded[i] = 1;
+        }
+    }
+    hidden = gProgram_state.cockpit_on && gCar_to_view == car;
+    gRocket.launcher->render_style = hidden ? BR_RSTYLE_NONE : BR_RSTYLE_FACES;
+    PoseLauncher(car);
+
+    // F fires the next loaded tube, alternating sides; holding it fires a salvo
+    key_down = PDKeyDown(KEY_F) && !gEntering_message;
+    if (key_down && (!gRocket.key_was_down || now - gRocket.last_fire >= ROCKET_FIRE_INTERVAL)
+        && !gCountdown && !gRace_finished && !car->knackered) {
+        tube = -1;
+        for (i = 0; i < ROCKET_TUBES; i++) {
+            if (gRocket.tube_loaded[(gRocket.next_tube + i) % ROCKET_TUBES]) {
+                tube = (gRocket.next_tube + i) % ROCKET_TUBES;
+                break;
+            }
+        }
+        if (tube >= 0) {
+            FireRocket(car, tube);
+            gRocket.next_tube = (tube + 1) % ROCKET_TUBES;
+        } else if (!gRocket.key_was_down) {
+            NewTextHeadupSlot(eHeadupSlot_misc, 0, 800, -kFont_MEDIUMHD, "ROCKETS RELOADING");
+        }
+    }
+    gRocket.key_was_down = key_down;
+
+    for (i = 0; i < ROCKET_COUNT; i++) {
+        tRocket* r = &gRocket.rockets[i];
+        if (!r->active) {
+            continue;
+        }
+        MoveRocket(r, pFrame_period);
+        if (r->active) {
+            br_matrix34 m;
+            RocketMatrix(r, &m);
+            r->actor->t.t.mat = m;
+            r->actor->render_style = BR_RSTYLE_FACES;
+        }
+    }
+    MovePuffs(pFrame_period);
+    MoveBlasts();
+    MungeFlames(pFrame_period);
+    UpdateLights();
+}
+
+void RocketTestExplosion(br_vector3* pPos) {
+    br_vector3 up = { { 0.f, 1.f, 0.f } };
+
+    if (gRocket.built) {
+        Explode(pPos, &up, NULL);
+    }
+}
+
+void RocketRenderEffects(void) {
+    if (gRocket.built && gProgram_state.racing && !gAction_replay_mode) {
+        BrZbSceneRenderAdd(gRocket.root);
+    }
+}
+
+int RocketIsActor(br_actor* pActor) {
+    return gRocket.built && pActor == gRocket.launcher;
+}
+
+int RocketLight(int pIndex, br_vector3* pPos, br_scalar* pRadius, br_vector3* pColour) {
+    if (pIndex >= gRocket.light_count || !gProgram_state.racing || gAction_replay_mode) {
+        return 0;
+    }
+    *pPos = gRocket.lights[pIndex].pos;
+    *pRadius = gRocket.lights[pIndex].radius;
+    *pColour = gRocket.lights[pIndex].colour;
+    return 1;
+}
+
+void RocketDumpState(void) {
+    br_vector3 mouth;
+    int flying, puffs, i;
+
+    if (!gRocket.built) {
+        printf("[state] rocket launcher not built yet\n");
+        return;
+    }
+    flying = puffs = 0;
+    for (i = 0; i < ROCKET_COUNT; i++) {
+        flying += gRocket.rockets[i].active;
+    }
+    for (i = 0; i < PUFF_COUNT; i++) {
+        puffs += gRocket.puffs[i].active;
+    }
+    BrVector3Copy(&mouth, (br_vector3*)gRocket.launcher->t.t.mat.m[3]);
+    printf("[state] rocket fired %d exploded %d (track %d, car %d, pedestrian %d, water %d, in the air %d), cars damaged %d wasted %d, "
+           "pedestrians killed %d\n",
+        gRocket.stats.fired, gRocket.stats.exploded, gRocket.stats.hit_track, gRocket.stats.hit_car, gRocket.stats.hit_ped,
+        gRocket.stats.hit_water, gRocket.stats.in_air, gRocket.stats.cars_damaged, gRocket.stats.cars_wasted, gRocket.stats.peds_killed);
+    printf("[state] rocket tubes loaded %d%d%d%d, in flight %d, smoke puffs %d, lights %d, launcher at %.2f %.2f %.2f %s, "
+           "last blast at %.2f %.2f %.2f\n",
+        gRocket.tube_loaded[0], gRocket.tube_loaded[1], gRocket.tube_loaded[2], gRocket.tube_loaded[3], flying, puffs,
+        gRocket.light_count, mouth.v[0], mouth.v[1], mouth.v[2], gRocket.launcher->render_style == BR_RSTYLE_NONE ? "hidden" : "shown",
+        gRocket.last_blast.v[0], gRocket.last_blast.v[1], gRocket.last_blast.v[2]);
+    for (i = 0; i < BLAST_COUNT; i++) {
+        tBlast* b = &gRocket.blasts[i];
+        br_matrix34* m = &b->sprites[0].actor->t.t.mat;
+        if (b->active) {
+            printf("[state] rocket blast %u ms old at %.2f %.2f %.2f, fireball %s size %.2f\n", GetTotalTime() - b->birth, b->pos.v[0],
+                b->pos.v[1], b->pos.v[2], b->sprites[0].actor->render_style == BR_RSTYLE_NONE ? "hidden" : "shown",
+                sqrtf(m->m[0][0] * m->m[0][0] + m->m[0][1] * m->m[0][1] + m->m[0][2] * m->m[0][2]));
+        }
+    }
+    for (i = 0; i < ROCKET_COUNT; i++) {
+        tRocket* r = &gRocket.rockets[i];
+        if (r->active) {
+            printf("[state] rocket in flight at %.2f %.2f %.2f, speed %.2f + car %.2f units/s, homing %s\n", r->pos.v[0], r->pos.v[1],
+                r->pos.v[2], r->speed, BrVector3Length(&r->carry), r->target != NULL ? "on a car" : "off");
+        }
+    }
+}
diff --git a/src/DETHRACE/common/rocket.h b/src/DETHRACE/common/rocket.h
