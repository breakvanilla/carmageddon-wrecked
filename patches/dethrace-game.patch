+/*
+ * Environment destruction: bullet impacts and holes, knocking over the game's knockable props through its own prop
+ * physics, debris from hard crashes, and explosions.
+ */
+
+#define DEBRIS_COUNT 120
+#define DECAL_COUNT 200
+#define PROP_COUNT 1024
+#define PROP_HITS_TO_KNOCK 5
+#define DEBRIS_GRAVITY (10.f / WORLD_SCALE)   // world units per second squared
+#define CRASH_MIN_FORCE 1.f             // CrashNoise() force for debris (its sound starts at 0.5)
+#define CRASH_INTERVAL 150              // ms between crash debris bursts
+#define CRATER_RADIUS 0.45f             // about 3 m
+#define CRATER_DEPTH 0.11f              // about 75 cm at the middle
+
+typedef struct tDebris {
+    br_actor* actor;
+    br_model* model;
+    br_vector3 pos;
+    br_vector3 vel;
+    br_vector3 axis;
+    br_scalar angle;
+    br_scalar spin;
+    br_scalar size;
+    br_scalar ground;
+    tU32 birth;
+    tU32 life;
+    int active;
+} tDebris;
+
+typedef struct tDecal {
+    br_actor* actor;
+    br_model* model;
+} tDecal;
+
+typedef struct tProp {
+    br_actor* actor;
+    int hits;
+} tProp;
+
+typedef struct tColour_cache {
+    br_material* material;
+    br_scalar rgb[3];
+} tColour_cache;
