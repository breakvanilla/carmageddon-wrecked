+    z[z_size++] = a;
+
+    f = fopen(gTest.screenshot, "wb");
+    if (f != NULL) {
+        header[0] = width >> 24;
+        header[1] = width >> 16;
+        header[2] = width >> 8;
+        header[3] = width;
+        header[4] = height >> 24;
+        header[5] = height >> 16;
+        header[6] = height >> 8;
+        header[7] = height;
+        header[8] = 8;  // bit depth
+        header[9] = 2;  // RGB
+        header[10] = 0; // deflate
+        header[11] = 0; // standard filters
+        header[12] = 0; // not interlaced
+        fwrite(signature, 1, 8, f);
+        WriteChunk(f, "IHDR", header, 13);
+        WriteChunk(f, "IDAT", z, z_size);
+        WriteChunk(f, "IEND", NULL, 0);
+        fclose(f);
+        gTest.screenshots_taken++;
+        printf("[test] screenshot %s (%dx%d)\n", gTest.screenshot, width, height);
+        fflush(stdout);
+    }
+    free(raw);
+    free(z);
+    gTest.screenshot[0] = '\0';
+}
+
+#endif
