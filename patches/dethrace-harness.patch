+// Wrecked Carmageddon: until moved, a downloaded app runs from a random read-only copy (App Translocation) and can't
+// find the game folder; this maps the path back. The Security framework functions aren't in its headers, hence dlsym.
+static void Untranslocate(char* pPath, size_t pSize) {
+    typedef Boolean (*is_translocated_fn)(CFURLRef, bool*, CFErrorRef*);
+    typedef CFURLRef (*original_path_fn)(CFURLRef, CFErrorRef*);
+    void* security;
+    is_translocated_fn is_translocated;
+    original_path_fn original_path;
+    CFURLRef url;
+    CFURLRef original;
+    bool translocated = false;
+
+    security = dlopen("/System/Library/Frameworks/Security.framework/Security", RTLD_LAZY);
+    if (security == NULL) {
+        return;
+    }
+    is_translocated = (is_translocated_fn)dlsym(security, "SecTranslocateIsTranslocatedURL");
+    original_path = (original_path_fn)dlsym(security, "SecTranslocateCreateOriginalPathForURL");
+    url = CFURLCreateFromFileSystemRepresentation(NULL, (const UInt8*)pPath, strlen(pPath), false);
+    if (is_translocated != NULL && original_path != NULL && url != NULL && is_translocated(url, &translocated, NULL) && translocated) {
+        original = original_path(url, NULL);
+        if (original != NULL) {
+            CFURLGetFileSystemRepresentation(original, true, (UInt8*)pPath, pSize);
+            CFRelease(original);
+        }
+    }
+    if (url != NULL) {
+        CFRelease(url);
+    }
+}
