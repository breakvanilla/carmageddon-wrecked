+// Wrecked Carmageddon: an extra sound bank with its files in pDir (ending in a separator), so SOUND.TXT stays untouched
+int S3LoadExtraSoundbank(const char* pSoundbank_filename, const char* pDir, int pLow_memory_mode) {
+    char soundbank_filename[256];
+    void* buffer;
+    tS3_soundbank_read_ctx read_ctx;
+    int count;
+
+    if (!gS3_enabled || strlen(pSoundbank_filename) >= sizeof(soundbank_filename)) {
+        return 1;
+    }
+    strcpy(soundbank_filename, pSoundbank_filename);
+    buffer = S3LoadSoundBankFile(soundbank_filename);
+    if (!buffer) {
+        return gS3_last_error;
+    }
+    read_ctx.data = (char*)buffer;
+    read_ctx.data_len = gS3_soundbank_buffer_len;
+    read_ctx.nlines = 0;
+    S3SoundBankReaderSkipWhitespace(&read_ctx);
+    count = 0;
+    while (S3SoundBankReadEntry(&read_ctx, (char*)pDir, pLow_memory_mode)) {
+        count++;
+    }
+    S3MemFree(buffer);
+    LOG_INFO3("%d sounds from %s", count, pSoundbank_filename);
+    return 0;
+}
