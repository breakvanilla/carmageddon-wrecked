@@ -0,0 +1,381 @@
+#ifdef CARMA_DEV
+
+// Scripted test mode (--test-script=FILE): hidden window, keys from the script, screenshots, state dumps.
+// Script commands are listed in the README; see tools/test_game.sh.
+#include "testmode.h"
+#include "harness/config.h"
+
+#include <ctype.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#ifdef _WIN32
+#include <direct.h>
+#endif
+
+// Provided by the game (common/carmatest.c)
+extern int Carma_TestIsRacing(void);
+extern void Carma_TestDumpState(void);
+extern void Carma_TestBlastProp(void);
+extern void Carma_TestBlastCar(void);
+extern void Carma_TestIgniteCar(void);
+extern void Carma_TestGotoWater(void);
+extern void Carma_TestDiveWater(void);
+
+#define MAX_LINES 1024
+#define MAX_HELD 16
+
+typedef struct {
+    char command[24];
+    char text[200];
+    int number;
+    int number2;
+    int line_number;
+} tTest_line;
+
+static struct {
+    int active;
+    tTest_line lines[MAX_LINES];
+    int count;
+    int pc;
+    unsigned next_time;
+    unsigned wait_until;
+    int waiting_racing;
+    struct {
+        char key[32];
+        unsigned release_time;
+    } held[MAX_HELD];
+    char screenshot[1024];
+    int screenshots_taken;
+    unsigned start_time;
+    unsigned timeout_ms;
+    tTest_set_key_cb* set_key;
+} gTest;
+
+static void TestLog(unsigned now, const char* format, ...) {
+    va_list ap;
+
+    printf("[test %7.2fs] ", (now - gTest.start_time) / 1000.f);
+    va_start(ap, format);
+    vprintf(format, ap);
+    va_end(ap);
+    printf("\n");
+    fflush(stdout);
+}
+
+int TestMode_Active(void) {
+    return gTest.active;
+}
+
+int TestMode_Init(void) {
+    FILE* f;
+    char buf[512];
+    char* p;
+    int line_number;
+    const char* timeout;
+    tTest_line* l;
+
+    if (harness_game_config.test_script[0] == '\0') {
+        return 0;
+    }
+    f = fopen(harness_game_config.test_script, "r");
+    if (f == NULL) {
+        fprintf(stderr, "test mode: can't read %s\n", harness_game_config.test_script);
+        exit(2);
+    }
+    line_number = 0;
+    while (fgets(buf, sizeof(buf), f) != NULL && gTest.count < MAX_LINES) {
+        line_number++;
+        if ((p = strchr(buf, '#')) != NULL) {
+            *p = '\0';
+        }
+        for (p = buf + strlen(buf); p > buf && isspace((unsigned char)p[-1]); p--) {
+            p[-1] = '\0';
+        }
+        for (p = buf; isspace((unsigned char)*p); p++) {
+        }
+        if (*p == '\0') {
+            continue;
+        }
+        l = &gTest.lines[gTest.count++];
+        memset(l, 0, sizeof(*l));
+        l->line_number = line_number;
+        sscanf(p, "%23s", l->command);
+        p += strlen(l->command);
+        while (isspace((unsigned char)*p)) {
+            p++;
+        }
+        strncpy(l->text, p, sizeof(l->text) - 1);
+        l->number = -1;
+        l->number2 = -1;
+        if (sscanf(p, "%d", &l->number) != 1) {
+            char word[64];
+            if (sscanf(p, "%63s %d", word, &l->number2) < 2) {
+                l->number2 = -1;
+            }
+        }
+    }
+    fclose(f);
+    if (harness_game_config.test_output[0] == '\0') {
+        strcpy(harness_game_config.test_output, "/tmp/carma_test");
+    }
+#ifdef _WIN32
+    _mkdir(harness_game_config.test_output);
+#else
+    mkdir(harness_game_config.test_output, 0755);
+#endif
+    timeout = getenv("CARMA_TEST_TIMEOUT");
+    gTest.timeout_ms = (timeout != NULL ? atoi(timeout) : 600) * 1000u;
+    gTest.active = 1;
+    return 1;
+}
+
+static int SetKey(const char* key, int down) {
+    if (!gTest.set_key(key, down)) {
+        fprintf(stderr, "test mode: unknown key '%s'\n", key);
+        return 0;
+    }
+    return 1;
+}
+
+static void HoldKey(const char* key, unsigned release_time) {
+    int i;
+
+    if (!SetKey(key, 1)) {
+        return;
+    }
+    for (i = 0; i < MAX_HELD; i++) {
+        if (gTest.held[i].key[0] == '\0') {
+            strncpy(gTest.held[i].key, key, sizeof(gTest.held[i].key) - 1);
+            gTest.held[i].release_time = release_time;
+            return;
+        }
+    }
+}
+
+void TestMode_Tick(unsigned now, tTest_set_key_cb* set_key) {
+    tTest_line* l;
+    char key[64];
+    int i;
+
+    gTest.set_key = set_key;
+    if (gTest.start_time == 0) {
+        gTest.start_time = now;
+        gTest.next_time = now;
+        TestLog(now, "running %s, %d commands, screenshots in %s", harness_game_config.test_script, gTest.count, harness_game_config.test_output);
+    }
+    if (now - gTest.start_time > gTest.timeout_ms) {
+        TestLog(now, "timeout, quitting");
+        exit(3);
+    }
+    for (i = 0; i < MAX_HELD; i++) {
+        if (gTest.held[i].key[0] != '\0' && now >= gTest.held[i].release_time) {
+            SetKey(gTest.held[i].key, 0);
+            gTest.held[i].key[0] = '\0';
+        }
+    }
+
+    while (gTest.pc < gTest.count && now >= gTest.next_time && gTest.screenshot[0] == '\0') {
+        l = &gTest.lines[gTest.pc];
+        key[0] = '\0';
+        sscanf(l->text, "%63s", key);
+
+        if (strcmp(l->command, "wait_racing") == 0) {
+            if (!gTest.waiting_racing) {
+                gTest.waiting_racing = 1;
+                gTest.wait_until = now + (l->number > 0 ? (unsigned)l->number : 60000u);
+                TestLog(now, "waiting for the race to start");
+            }
+            if (Carma_TestIsRacing()) {
+                TestLog(now, "race running");
+            } else if (now < gTest.wait_until) {
+                return;
+            } else {
+                TestLog(now, "line %d: no race after waiting, carrying on", l->line_number);
+            }
+            gTest.waiting_racing = 0;
+            gTest.pc++;
+            continue;
+        }
+
+        gTest.pc++;
+        if (strcmp(l->command, "wait") == 0) {
+            gTest.next_time = now + (unsigned)(l->number > 0 ? l->number : 0);
+        } else if (strcmp(l->command, "press") == 0) {
+            int times = l->number2 > 0 ? l->number2 : 1;
+            TestLog(now, "press %s%s", key, times > 1 ? " (repeated)" : "");
+            HoldKey(key, now + 80);
+            gTest.next_time = now + 200;
+            if (times > 1) {
+                // Run the same line again for the remaining presses
+                l->number2 = times - 1;
+                gTest.pc--;
+            }
+        } else if (strcmp(l->command, "hold") == 0) {
+            int ms = l->number2 > 0 ? l->number2 : 500;
+            TestLog(now, "hold %s for %d ms", key, ms);
+            HoldKey(key, now + ms);
+            gTest.next_time = now + ms + 50;
+        } else if (strcmp(l->command, "down") == 0) {
+            TestLog(now, "down %s", key);
+            SetKey(key, 1);
+        } else if (strcmp(l->command, "up") == 0) {
+            TestLog(now, "up %s", key);
+            SetKey(key, 0);
+        } else if (strcmp(l->command, "screenshot") == 0) {
+            snprintf(gTest.screenshot, sizeof(gTest.screenshot), "%s/%s.png", harness_game_config.test_output, key[0] ? key : "shot");
+        } else if (strcmp(l->command, "state") == 0) {
+            TestLog(now, "state");
+            Carma_TestDumpState();
+        } else if (strcmp(l->command, "blast_prop") == 0) {
+            TestLog(now, "blast_prop");
+            Carma_TestBlastProp();
+        } else if (strcmp(l->command, "blast_car") == 0) {
+            TestLog(now, "blast_car");
+            Carma_TestBlastCar();
+        } else if (strcmp(l->command, "ignite_car") == 0) {
+            TestLog(now, "ignite_car");
+            Carma_TestIgniteCar();
+        } else if (strcmp(l->command, "goto_water") == 0) {
+            TestLog(now, "goto_water");
+            Carma_TestGotoWater();
+        } else if (strcmp(l->command, "dive_water") == 0) {
+            TestLog(now, "dive_water");
+            Carma_TestDiveWater();
+        } else if (strcmp(l->command, "log") == 0) {
+            TestLog(now, "%s", l->text);
+        } else if (strcmp(l->command, "quit") == 0) {
+            TestLog(now, "quit");
+            exit(0);
+        } else {
+            TestLog(now, "line %d: unknown command '%s'", l->line_number, l->command);
+        }
+    }
+    if (gTest.pc >= gTest.count && gTest.screenshot[0] == '\0' && now >= gTest.next_time) {
+        TestLog(now, "script finished, %d screenshots", gTest.screenshots_taken);
+        exit(0);
+    }
+}
+
+const char* TestMode_ScreenshotPath(void) {
+    return gTest.screenshot[0] ? gTest.screenshot : NULL;
+}
+
+static unsigned Crc32(unsigned crc, const unsigned char* p, size_t n) {
+    static unsigned table[256];
+    unsigned c;
+    int k, j;
+
+    if (table[1] == 0) {
+        for (k = 0; k < 256; k++) {
+            c = k;
+            for (j = 0; j < 8; j++) {
+                c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+            }
+            table[k] = c;
+        }
+    }
+    crc ^= 0xFFFFFFFFu;
+    while (n--) {
+        crc = table[(crc ^ *p++) & 0xFF] ^ (crc >> 8);
+    }
+    return crc ^ 0xFFFFFFFFu;
+}
+
+static void WriteChunk(FILE* f, const char* type, const unsigned char* data, size_t n) {
+    unsigned char be[4];
+    unsigned crc;
+
+    be[0] = n >> 24;
+    be[1] = n >> 16;
+    be[2] = n >> 8;
+    be[3] = n;
+    fwrite(be, 1, 4, f);
+    fwrite(type, 1, 4, f);
+    fwrite(data, 1, n, f);
+    crc = Crc32(Crc32(0, (const unsigned char*)type, 4), data, n);
+    be[0] = crc >> 24;
+    be[1] = crc >> 16;
+    be[2] = crc >> 8;
+    be[3] = crc;
+    fwrite(be, 1, 4, f);
+}
+
+// Uncompressed PNG (stored deflate blocks); pixels are RGBA, bottom row first as OpenGL reads them
