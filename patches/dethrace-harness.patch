+// Wrecked Carmageddon: started from Explorer or the Finder, output goes nowhere, so a mod install logs to
+// MOD_FOLDER/dethrace.log for bug reports. Output to a console, pipe or file is left alone.
+static int Harness_OutputIsLost(void) {
+#ifdef _WIN32
+    return _fileno(stdout) < 0 || _get_osfhandle(_fileno(stdout)) < 0;
+#else
+    struct stat out, null_device;
+    if (fstat(fileno(stdout), &out) != 0) {
+        return 1;
+    }
+    return stat("/dev/null", &null_device) == 0 && out.st_dev == null_device.st_dev && out.st_ino == null_device.st_ino;
+#endif
+}
+
+static void Harness_OpenModLog(const char* dir) {
+    char path[1100];
+    struct stat st;
+    FILE* f;
+
+    snprintf(path, sizeof(path), "%s/" MOD_FOLDER, dir);
+    if (stat(path, &st) != 0 || !Harness_OutputIsLost()) {
+        return;
+    }
+    snprintf(path, sizeof(path), "%s/" MOD_FOLDER "/dethrace.log", dir);
+    f = fopen(path, "w");
+    if (f == NULL) {
+        return;
+    }
+    fclose(f);
+    // Append, unbuffered: stdout and stderr don't overwrite each other and a crash loses nothing
+    harness_plain_log = 1;
+    if (freopen(path, "a", stdout) != NULL) {
+        setvbuf(stdout, NULL, _IONBF, 0);
+    }
+    if (freopen(path, "a", stderr) != NULL) {
+        setvbuf(stderr, NULL, _IONBF, 0);
+    }
+}
+
+// Wrecked Carmageddon: MOD_FOLDER/dethrace.ini in the game folder; read after the user's dethrace.ini and before the
+// command line, which wins
+static void Harness_ProcessModIniFile(int argc, char* argv[]) {
+    char dir[1024];
+    char path[1100];
+    const char* given = NULL;
+    int i;
+
+    for (i = 1; i < argc - 1; i++) {
+        if (strcasecmp(argv[i], "--dir") == 0) {
+            given = argv[i + 1];
+        }
+    }
+    if (given == NULL) {
+        given = getenv("DETHRACE_ROOT_DIR");
+    }
+    if (given == NULL) {
+        given = OS_GetWorkingDirectory(argv[0]);
+    }
+    safe_strcpy(dir, given);
+    Harness_OpenModLog(dir);
+    snprintf(path, sizeof(path), "%s/" MOD_FOLDER "/dethrace.ini", dir);
+    if (ini_parse(path, Harness_Ini_Callback, NULL) >= 0) {
+        LOG_INFO2("Loaded mod settings from %s", path);
+    }
+}
